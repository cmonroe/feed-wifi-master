From: Chad Monroe <chad@monroe.io>
Date: Mon, 24 Nov 2025 14:36:47 -0800
Subject: [PATCH] wifi-scripts: disable automatic wpa_psk_file generation

SmartOS doesn't persist per-STA PSK files. A defined wpa_psk_file makes
hostapd use per-station keys from a non-persisted /var/run file; leaving
it undefined forces use of the single static network key.

Drop the wpa_psk_file emission and the per-STA file setup in
iface_auth_type() and iface_wpa_stations() in usr/share/ucode/wifi/ap.uc.

Fixes: OWRT-7681

Signed-off-by: Chad Monroe <chad@monroe.io>
---
--- a/src/usr/share/ucode/wifi/ap.uc
+++ b/src/usr/share/ucode/wifi/ap.uc
@@ -173,10 +173,10 @@ function iface_auth_type(config, band) {
 			 netifd.setup_failed('INVALID_WPA_PSK');
 		}
 
-		if (config.auth_type in [ 'psk', 'psk-sae', 'psk-sae-compat' ] && band != '6g') {
-			set_default(config, 'wpa_psk_file', `/var/run/hostapd-${config.ifname}.psk`);
-			touch_file(config.wpa_psk_file);
-		}
+		/*
+		 * SmartOS does not persist per-STA PSK files; leave wpa_psk_file
+		 * undefined so hostapd uses the single static network key (OWRT-7681).
+		 */
 
 		if (config.auth_type in [ 'sae', 'psk-sae', 'psk-sae-compat' ]) {
 			set_default(config, 'sae_password_file', `/var/run/hostapd-${config.ifname}.sae`);
@@ -220,7 +220,7 @@ function iface_auth_type(config, band) {
 	append_vars(config, [
 		'sae_require_mfp', 'sae_password_file', 'sae_pwe', 'sae_groups', 'sae_track_password', 'time_advertisement', 'time_zone',
 		'wpa_group_rekey', 'wpa_ptk_rekey', 'wpa_gmk_rekey', 'wpa_strict_rekey',
-		'macaddr_acl', 'wpa_psk_radius', 'wpa_psk', 'wpa_passphrase', 'wpa_psk_file',
+		'macaddr_acl', 'wpa_psk_radius', 'wpa_psk', 'wpa_passphrase',
 		'eapol_version', 'dynamic_vlan', 'radius_request_cui', 'eap_reauth_period',
 		'radius_das_client', 'radius_das_port', 'owe_groups', 'owe_ptk_workaround', 'own_ip_addr', 'dynamic_own_ip_addr',
 		'wpa_disable_eapol_key_retries', 'auth_algs', 'wpa', 'wpa_pairwise',
@@ -371,7 +371,8 @@ function iface_wpa_stations(config, stas
 		}
 	file.close();
 
-	set_default(config, 'wpa_psk_file', path);
+	/* SmartOS does not persist per-STA PSK files (OWRT-7681) */
+	//set_default(config, 'wpa_psk_file', path);
 }
 
 function iface_sae_stations(config, stas) {
