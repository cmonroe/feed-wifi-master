From: Chad Monroe <chad@monroe.io>
Date: Mon, 24 Nov 2025 14:36:47 -0800
Subject: [PATCH] wifi-scripts: default to 160MHz channel width on 6GHz

Set default channel width to 160MHz for 6GHz radios.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 src/lib/wifi/mac80211.uc |    8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

--- a/src/lib/wifi/mac80211.uc
+++ b/src/lib/wifi/mac80211.uc
@@ -64,8 +64,12 @@ for (let phy_name, phy in board.wlan) {
 		let width = band.max_width;
 		if (band_name == "2G")
 			width = 20;
-		else if (width > 80)
-			width = 80;
+		else if (width > 80) {
+			if (band_name == "6G")
+				width = 160;
+			else
+				width = 80;
+		}
 
 		let htmode = filter(htmode_order, (m) => band[lc(m)])[0];
 		if (htmode)
