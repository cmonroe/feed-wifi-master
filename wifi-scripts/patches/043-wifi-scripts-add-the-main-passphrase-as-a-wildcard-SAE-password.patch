From: Koral Ilgun <koral.ilgun@adtran.com>
Date: Wed, 11 Nov 2026 10:46:22 -0800
Subject: [PATCH] wifi-scripts: add the main passphrase as a wildcard SAE password

A wifi-station without a MAC address becomes a wildcard entry of the
SAE password file. hostapd uses wpa_passphrase for SAE only when no
entry matches the peer, so a SAE client could no longer join with the
main passphrase. On a BSS with SAE as its only AKM, no client could.

Add the passphrase as a wildcard entry too, and turn on
sae_track_password, so that hostapd tries the wildcard passwords one
by one. hostapd tries the last line first, so the passphrase is the
last line, and its clients join at the first attempt. A client of
another wildcard password gets status 1 once for each wildcard
password before its own, at its first join after each hostapd start,
because hostapd keeps the result in memory only.

The passphrase stays out when sae_track_password is 0, because
hostapd would then use it for every peer. It also stays out when a
wildcard station has the same key, because that station carries a
VLAN, and when the key is a hex PSK or comes from RADIUS (ppsk).
---
--- a/src/usr/share/ucode/wifi/ap.uc
+++ b/src/usr/share/ucode/wifi/ap.uc
@@ -566,21 +566,45 @@ function iface_wpa_stations(config, stas
 	station_file_write(config, 'wpa_psk_file', `/var/run/hostapd-${config.ifname}.psk`, lines);
 }
 
+/* hostapd uses wpa_passphrase for SAE only when no sae_password entry
+ * matches the peer, and a wildcard entry matches every peer. So the
+ * passphrase becomes a wildcard entry too, and hostapd tries the wildcard
+ * entries one by one. hostapd tries the last line of the file first.
+ * Without that tracking, hostapd uses only that line for every peer, so a
+ * uci value of 0 keeps the passphrase out. sae_track_password is the number
+ * of peers that hostapd remembers for each password. */
 function iface_sae_stations(config, stas) {
 	let lines = [];
+	let wildcards = 0;
+	let key_listed = false;
 
 	for (let k, sta in stas) {
 		if (!sta.config.mac || !sta.config.key)
 			continue;
 
 		for (let mac in sta.config.mac) {
+			mac = lc(mac);
 			if (mac == '00:00:00:00:00:00')
 				mac = 'ff:ff:ff:ff:ff:ff';
+			if (mac == 'ff:ff:ff:ff:ff:ff') {
+				wildcards++;
+				key_listed ||= sta.config.key == config.key;
+			}
 
 			push(lines, `${sta.config.key}|mac=${mac}` + (sta.config.vid ? `|vlanid=${sta.config.vid}` : ''));
 		}
 	}
 
+	const tracking_off = config.sae_track_password != null && !+config.sae_track_password;
+
+	if (wildcards && !key_listed && !tracking_off && !config.ppsk && key_kind(config.key) == 'passphrase') {
+		push(lines, `${config.key}|mac=ff:ff:ff:ff:ff:ff`);
+		wildcards++;
+	}
+
+	if (wildcards > 1)
+		set_default(config, 'sae_track_password', 256);
+
 	station_file_write(config, 'sae_password_file', `/var/run/hostapd-${config.ifname}.sae`, lines);
 }
 
