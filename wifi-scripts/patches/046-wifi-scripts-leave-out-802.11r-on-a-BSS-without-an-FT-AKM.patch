From: Koral Ilgun <koral.ilgun@adtran.com>
Date: Thu, 12 Nov 2026 05:51:43 -0800
Subject: [PATCH] wifi-scripts: leave out 802.11r on a BSS without an FT AKM

OWE and DPP have no FT AKM, so 802.11r cannot apply to such a BSS.
With ieee80211r set, for example from a roaming setting that applies
to every BSS of a network, bss_refusal() refused an OWE BSS with
FT_KEY_CANT_BE_DERIVED, because the BSS has no key and no RADIUS
secret for the FT key. The BSS then did not start.

Leave out the FT options on such a BSS, and log why.

Based-on-patch-by: Piotr Kubik <piotr.kubik@adtran.com>
---
--- a/src/usr/share/ucode/wifi/ap.uc
+++ b/src/usr/share/ucode/wifi/ap.uc
@@ -6,7 +6,7 @@ import * as fs from 'fs';
 
 import {
 	append, append_raw, append_value, append_vars, append_list, append_string_vars, comment, config_mark,
-	config_rewind, push_config, set_default, touch_file
+	config_rewind, log, push_config, set_default, touch_file
 } from 'wifi.common';
 import * as netifd from 'wifi.netifd';
 import * as iface from 'wifi.iface';
@@ -36,6 +36,11 @@ function ft_psk_local_default(config) {
 	return config.auth_type == 'psk' && !config.rsno2_sae;
 }
 
+/* iface.wpa_key_mgmt() offers no FT AKM for OWE and DPP */
+function ft_akm_available(config) {
+	return config.wpa >= 2 && !(config.auth_type in [ 'owe', 'dpp' ]);
+}
+
 function sae_password_option(config) {
 	if (config.sae_password_file)
 		return true;
@@ -75,7 +80,7 @@ function bss_refusal(config, band) {
 	    index([ 'psk', 'passphrase' ], key_kind(config.multi_ap_backhaul_key)) < 0)
 		return 'INVALID_WPA_PSK';
 
-	if (config.ieee80211r && config.wpa >= 2 &&
+	if (config.ieee80211r && ft_akm_available(config) &&
 	    !(config.ft_psk_generate_local ?? ft_psk_local_default(config)) &&
 	    (!config.r0kh || !config.r1kh) && !config.auth_server_shared_secret && !config.key)
 		return 'FT_KEY_CANT_BE_DERIVED';
@@ -601,6 +606,11 @@ function iface_roaming(config) {
 	if (!config.ieee80211r || config.wpa < 2)
 		return;
 
+	if (!ft_akm_available(config)) {
+		log(`Ignoring ieee80211r on ${config.ifname}: no FT AKM for auth type '${config.auth_type}'`);
+		return;
+	}
+
 	set_default(config, 'mobility_domain', substr(md5(config.ssid + '\n'), 0, 4));
 	set_default(config, 'ft_psk_generate_local', ft_psk_local_default(config));
 	set_default(config, 'ft_iface', config.network_ifname);
