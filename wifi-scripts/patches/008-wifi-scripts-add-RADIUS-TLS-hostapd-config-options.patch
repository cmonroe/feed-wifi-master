From: Chad Monroe <chad@monroe.io>
Date: Mon, 24 Nov 2025 14:36:47 -0800
Subject: [PATCH] wifi-scripts: add RADIUS TLS hostapd config options

Support configuration of RADIUS TLS.

Declare the auth_server_type, auth_server_ca_cert, auth_server_client_cert,
auth_server_private_key and auth_server_private_key_passwd options in the
wifi-iface schema and emit them per RADIUS server from
iface_authentication_server() in usr/share/ucode/wifi/ap.uc.

Fixes: SDG-2276

Signed-off-by: Chad Monroe <chad@monroe.io>
---
--- a/src/usr/share/schema/wireless.wifi-iface.json
+++ b/src/usr/share/schema/wireless.wifi-iface.json
@@ -153,15 +153,35 @@
 				"type": "string"
 			}
 		},
+		"auth_server_ca_cert": {
+			"description": "RADIUS over TLS CA certificate path",
+			"type": "string"
+		},
+		"auth_server_client_cert": {
+			"description": "RADIUS over TLS client certificate path",
+			"type": "string"
+		},
 		"auth_server_port": {
 			"description": "RADIUS authentication port",
 			"type": "number",
 			"default": 1812
 		},
+		"auth_server_private_key": {
+			"description": "RADIUS over TLS client private key path",
+			"type": "string"
+		},
+		"auth_server_private_key_passwd": {
+			"description": "RADIUS over TLS client private key passphrase",
+			"type": "string"
+		},
 		"auth_server_shared_secret": {
 			"description": "Shared authentication RADIUS secret",
 			"type": "string"
 		},
+		"auth_server_type": {
+			"description": "RADIUS server transport type (e.g. radsec for RADIUS over TLS)",
+			"type": "string"
+		},
 		"basic_rate": {
 			"type": "array"
 		},
--- a/src/usr/share/ucode/wifi/ap.uc
+++ b/src/usr/share/ucode/wifi/ap.uc
@@ -66,7 +66,11 @@ function iface_setup(config) {
 function iface_authentication_server(config) {
 	for (let server in config.auth_server_addr) {
 		append('auth_server_addr', server);
-		append_vars(config, [ 'auth_server_port', 'auth_server_shared_secret' ]);
+		append_vars(config, [
+			'auth_server_port', 'auth_server_shared_secret',
+			'auth_server_type', 'auth_server_ca_cert', 'auth_server_client_cert',
+			'auth_server_private_key', 'auth_server_private_key_passwd'
+		]);
 	}
 
 	append_vars(config, [ 'radius_auth_req_attr' ]);
