+static bool
+mt7996_rx_napi_reset_skip(struct mt7996_dev *dev, int qid)
+{
+	struct mt76_queue *q = &dev->mt76.q_rx[qid];
+
+	if (mt76_queue_is_npu_txfree(q))
+		return true;
+
+	if (!mt76_queue_is_wed_rro(q))
+		return false;
+
+	return mtk_wed_device_active(&dev->mt76.mmio.wed) ||
+	       mt76_npu_device_active(&dev->mt76);
+}
+
+static void
+mt7996_napi_disable(struct mt7996_dev *dev)
+{
+	int i;
+
+	mt76_for_each_q_rx(&dev->mt76, i) {
+		if (!mt7996_rx_napi_reset_skip(dev, i))
+			napi_disable(&dev->mt76.napi[i]);
+	}
+	napi_disable(&dev->mt76.tx_napi);
+}
+
+static void
+mt7996_napi_enable_one(struct napi_struct *napi, bool schedule)
+{
+	napi_enable(napi);
+	if (!schedule)
+		return;
+
+	local_bh_disable();
+	napi_schedule(napi);
+	local_bh_enable();
+}
+
+static void
+mt7996_napi_enable(struct mt7996_dev *dev, bool schedule)
+{
+	int i;
+
+	mt76_for_each_q_rx(&dev->mt76, i) {
+		if (!mt7996_rx_napi_reset_skip(dev, i))
+			mt7996_napi_enable_one(&dev->mt76.napi[i], schedule);
+	}
+	mt7996_napi_enable_one(&dev->mt76.tx_napi, schedule);
+}
+
+static void
+mt7996_wed_stop(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+
+	if (mtk_wed_device_active(&mdev->mmio.wed_hif2))
+		mtk_wed_device_stop(&mdev->mmio.wed_hif2);
+
+	if (mtk_wed_device_active(&mdev->mmio.wed))
+		mtk_wed_device_stop(&mdev->mmio.wed);
+}
+
+#ifndef mtk_wed_device_pcie_int_poll_set
+#define mtk_wed_device_pcie_int_poll_set(_dev, _enable) do {} while (0)
+#endif
+
+static void
+mt7996_wed_poll_set(struct mt7996_dev *dev, bool enable)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+
+	if (mtk_wed_device_active(&mdev->mmio.wed_hif2))
+		mtk_wed_device_pcie_int_poll_set(&mdev->mmio.wed_hif2, enable);
+
+	if (mtk_wed_device_active(&mdev->mmio.wed))
+		mtk_wed_device_pcie_int_poll_set(&mdev->mmio.wed, enable);
+}
