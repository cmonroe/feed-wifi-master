From: Chad Monroe <chad@monroe.io>
Date: Sat, 26 Sep 2026 05:11:46 -0700
Subject: [PATCH] wifi: mt76: fail NPU setup on a buffer outside NPU window

The Airoha NPU reaches host DRAM only through a 1GB window. When the
page allocator returns a ring or a buffer above that window, the NPU
reads and writes other memory, and nothing reports the fault.

Check each ring and each fixed buffer whose address mt76 hands the
NPU at setup. Fail the setup with an error that names it, because a
reported loss of WiFi is easier to act on than silent corruption.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 dma.c         |   12 ++++++++++++
 mt76.h        |   15 +++++++++++++++
 mt7996/init.c |   20 +++++++++++++++++---
 mt7996/npu.c  |   36 +++++++++++++++++++++++-------------
 4 files changed, 67 insertions(+), 16 deletions(-)

--- a/dma.c
+++ b/dma.c
@@ -855,6 +855,18 @@ mt76_dma_alloc_queue(struct mt76_dev *de
 	if (!q->desc)
 		return -ENOMEM;
 
+	if (mt76_npu_device_active(dev) &&
+	    (mt76_queue_is_npu(q) || mt76_queue_is_npu_txfree(q))) {
+		const char *name = mt76_queue_is_npu_tx(q) ? "tx ring" :
+				   mt76_queue_is_npu_rx(q) ? "rx ring" :
+							     "tx done ring";
+
+		ret = mt76_npu_addr_check(dev, name, q->desc_dma,
+					  q->ndesc * size);
+		if (ret)
+			return ret;
+	}
+
 	mt76_dma_queue_magic_cnt_init(dev, q);
 	size = q->ndesc * sizeof(*q->entry);
 	q->entry = devm_kzalloc(dev->dev, size, GFP_KERNEL);
--- a/mt76.h
+++ b/mt76.h
@@ -1927,6 +1927,21 @@ static inline int mt76_npu_get_msg(struc
 				       gfp);
 }
 
+/* The Airoha NPU reaches host DRAM only through this 1GB window. */
+#define MT76_NPU_DRAM_START	0x80000000ULL
+#define MT76_NPU_DRAM_END	0xc0000000ULL
+
+static inline int mt76_npu_addr_check(struct mt76_dev *dev, const char *name,
+				      dma_addr_t addr, size_t size)
+{
+	if (addr >= MT76_NPU_DRAM_START && addr + size <= MT76_NPU_DRAM_END)
+		return 0;
+
+	dev_err(dev->dev, "NPU %s at %pad is outside the NPU DRAM window\n",
+		name, &addr);
+	return -ERANGE;
+}
+
 static inline void mt76_testmode_reset(struct mt76_phy *phy, bool disable)
 {
 #ifdef CONFIG_NL80211_TESTMODE
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -1066,7 +1066,7 @@ static int mt7996_wed_rro_init(struct mt
 	u32 val = FIELD_PREP(WED_RRO_ADDR_SIGNATURE_MASK, 0xff);
 	struct mt7996_wed_rro_addr *addr;
 	void *ptr;
-	int i;
+	int i, err;
 
 	if (!mt7996_has_hwrro(dev))
 		return 0;
@@ -1105,10 +1105,17 @@ static int mt7996_wed_rro_init(struct mt
 		}
 
 		if (is_mt7996(&dev->mt76) &&
-		    mt76_npu_device_active(&dev->mt76))
+		    mt76_npu_device_active(&dev->mt76)) {
+			err = mt76_npu_addr_check(&dev->mt76, "rro addr table",
+					dev->wed_rro.addr_elem[i].phy_addr,
+					MT7996_RRO_WINDOW_MAX_SIZE * sizeof(*addr));
+			if (err)
+				return err;
+
 			mt76_npu_send_txrx_addr(&dev->mt76, 0, i,
 					dev->wed_rro.addr_elem[i].phy_addr,
 					0, 0);
+		}
 
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 		if (mtk_wed_device_active(&dev->mt76.mmio.wed) &&
@@ -1170,9 +1177,16 @@ static int mt7996_wed_rro_init(struct mt
 		addr++;
 	}
 
-	if (is_mt7996(&dev->mt76) && mt76_npu_device_active(&dev->mt76))
+	if (is_mt7996(&dev->mt76) && mt76_npu_device_active(&dev->mt76)) {
+		err = mt76_npu_addr_check(&dev->mt76, "rro session table",
+					  dev->wed_rro.session.phy_addr,
+					  MT7996_RRO_WINDOW_MAX_LEN * sizeof(*addr));
+		if (err)
+			return err;
+
 		mt76_npu_send_txrx_addr(&dev->mt76, 1, 0,
 					dev->wed_rro.session.phy_addr, 0, 0);
+	}
 
 	mt7996_rro_hw_init(dev);
 
--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -556,6 +556,15 @@ int __mt7996_npu_hw_init(struct mt7996_d
 	return 0;
 }
 
+static int mt7996_npu_txd_alloc(struct mt7996_dev *dev, dma_addr_t *addr,
+				size_t size)
+{
+	if (!dmam_alloc_coherent(dev->mt76.dma_dev, size, addr, GFP_KERNEL))
+		return -ENOMEM;
+
+	return mt76_npu_addr_check(&dev->mt76, "txd space", *addr, size);
+}
+
 int mt7996_npu_hw_init(struct mt7996_dev *dev)
 {
 	int i, err;
@@ -572,19 +581,20 @@ int mt7996_npu_hw_init(struct mt7996_dev
 						 : MT7996_NPU_RX_RING_SIZE / 2
 						 : MT7996_TX_RING_SIZE;
 
-		if (!dmam_alloc_coherent(dev->mt76.dma_dev, 256 * size,
-					 &dev->npu_txd_addr[i], GFP_KERNEL))
-			return -ENOMEM;
-
-		if (!dmam_alloc_coherent(dev->mt76.dma_dev, 256 * size,
-					 &dev->npu_txd_addr[i + 1],
-					 GFP_KERNEL))
-			return -ENOMEM;
-
-		if (!dmam_alloc_coherent(dev->mt76.dma_dev, 256 * 1024,
-					 &dev->npu_txd_addr[i + 2],
-					 GFP_KERNEL))
-			return -ENOMEM;
+		err = mt7996_npu_txd_alloc(dev, &dev->npu_txd_addr[i],
+					   256 * size);
+		if (err)
+			return err;
+
+		err = mt7996_npu_txd_alloc(dev, &dev->npu_txd_addr[i + 1],
+					   256 * size);
+		if (err)
+			return err;
+
+		err = mt7996_npu_txd_alloc(dev, &dev->npu_txd_addr[i + 2],
+					   256 * 1024);
+		if (err)
+			return err;
 	}
 
 	mutex_lock(&dev->mt76.mutex);
