From: Chad Monroe <chad@monroe.io>
Date: Wed, 25 Feb 2026 16:51:24 -0800
Subject: [PATCH] wifi: mt76: mt7996: add STA-mode CSA support

Without CHANCTX_STA_CSA, mac80211 disconnects when a STA VIF receives a
CSA beacon. Implement driver-managed beacon countdown with timer-based
channel switch signaling, modeled after the mt7925 approach but relying
on the existing generic mt76 chanctx ops for hardware programming.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7996/init.c   |    1 
 mt7996/main.c   |  135 ++++++++++++++++++++++++++++++++++++++++++++--
 mt7996/mt7996.h |    6 ++
 3 files changed, 139 insertions(+), 3 deletions(-)

--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -600,6 +600,7 @@ mt7996_init_wiphy(struct ieee80211_hw *h
 	ieee80211_hw_set(hw, SUPPORTS_RX_DECAP_OFFLOAD);
 	ieee80211_hw_set(hw, NO_VIRTUAL_MONITOR);
 	ieee80211_hw_set(hw, SUPPORTS_MULTI_BSSID);
+	ieee80211_hw_set(hw, CHANCTX_STA_CSA);
 
 	hw->max_tx_fragments = 4;
 	wiphy->txq_memory_limit = 32 << 20; /* 32 MiB */
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -524,6 +524,8 @@ static void mt7996_set_monitor(struct mt
 	mt7996_mcu_set_sniffer_mode(phy, enabled);
 }
 
+static void mt7996_csa_timer(struct timer_list *timer);
+
 static int mt7996_add_interface(struct ieee80211_hw *hw,
 				struct ieee80211_vif *vif)
 {
@@ -557,6 +559,9 @@ static int mt7996_add_interface(struct i
 	mvif->dev = dev;
 	mvif->sta.vif = mvif;
 
+	INIT_WORK(&mvif->csa_work, mt7996_csa_work);
+	timer_setup(&mvif->csa_timer, mt7996_csa_timer, 0);
+
 out:
 	mutex_unlock(&dev->mt76.mutex);
 
@@ -581,10 +586,14 @@ static void mt7996_remove_iter(void *dat
 static void mt7996_remove_interface(struct ieee80211_hw *hw,
 				    struct ieee80211_vif *vif)
 {
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
 	struct mt7996_dev *dev = mt7996_hw_dev(hw);
 	struct mt7996_radio_data rdata = {};
 	int i;
 
+	timer_delete_sync(&mvif->csa_timer);
+	cancel_work_sync(&mvif->csa_work);
+
 	ieee80211_iterate_active_interfaces_mtx(hw, 0, mt7996_remove_iter,
 						&rdata);
 	mt76_vif_cleanup(&dev->mt76, vif);
@@ -2488,12 +2497,112 @@ mt7996_set_eml_op_mode(struct ieee80211_
 	return ret;
 }
 
+static void mt7996_csa_timer(struct timer_list *timer)
+{
+	struct mt7996_vif *mvif = timer_container_of(mvif, timer, csa_timer);
+	struct mt7996_dev *dev = mvif->dev;
+
+	ieee80211_queue_work(dev->mphy.hw, &mvif->csa_work);
+}
+
+void mt7996_csa_work(struct work_struct *work)
+{
+	struct mt7996_vif *mvif = container_of(work, struct mt7996_vif, csa_work);
+	struct ieee80211_vif *vif;
+
+	vif = container_of((void *)mvif, struct ieee80211_vif, drv_priv);
+
+	if (ieee80211_vif_is_mld(vif))
+		return;
+
+	memset(&mvif->csa_chandef, 0, sizeof(mvif->csa_chandef));
+	ieee80211_chswitch_done(vif, true, 0);
+}
+
+static int mt7996_pre_channel_switch(struct ieee80211_hw *hw,
+				     struct ieee80211_vif *vif,
+				     struct ieee80211_channel_switch *chsw)
+{
+	if (vif->type != NL80211_IFTYPE_STATION)
+		return 0;
+
+	if (ieee80211_vif_is_mld(vif))
+		return -EOPNOTSUPP;
+
+	if (!vif->cfg.assoc)
+		return -EOPNOTSUPP;
+
+	if (!cfg80211_chandef_usable(hw->wiphy, &chsw->chandef,
+				     IEEE80211_CHAN_DISABLED))
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static void mt7996_channel_switch(struct ieee80211_hw *hw,
+				  struct ieee80211_vif *vif,
+				  struct ieee80211_channel_switch *chsw)
+{
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+
+	if (ieee80211_vif_is_mld(vif))
+		return;
+
+	mvif->csa_chandef = chsw->chandef;
+	mod_timer(&mvif->csa_timer,
+		  TU_TO_EXP_TIME(vif->bss_conf.beacon_int * chsw->count));
+}
+
+static void mt7996_abort_channel_switch(struct ieee80211_hw *hw,
+					struct ieee80211_vif *vif,
+					struct ieee80211_bss_conf *link_conf)
+{
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+
+	timer_delete_sync(&mvif->csa_timer);
+	cancel_work_sync(&mvif->csa_work);
+	memset(&mvif->csa_chandef, 0, sizeof(mvif->csa_chandef));
+}
+
+static void mt7996_channel_switch_rx_beacon(struct ieee80211_hw *hw,
+					    struct ieee80211_vif *vif,
+					    struct ieee80211_channel_switch *chsw)
+{
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+
+	if (ieee80211_vif_is_mld(vif))
+		return;
+
+	if (!mvif->csa_chandef.chan)
+		return;
+
+	if (cfg80211_chandef_identical(&chsw->chandef, &mvif->csa_chandef) &&
+	    chsw->count)
+		mod_timer(&mvif->csa_timer,
+			  TU_TO_EXP_TIME(vif->bss_conf.beacon_int * chsw->count));
+}
+
+static void mt7996_unassign_vif_chanctx(struct ieee80211_hw *hw,
+					struct ieee80211_vif *vif,
+					struct ieee80211_bss_conf *link_conf,
+					struct ieee80211_chanctx_conf *conf)
+{
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+
+	mt76_unassign_vif_chanctx(hw, vif, link_conf, conf);
+
+	if (link_conf->csa_active) {
+		timer_delete_sync(&mvif->csa_timer);
+		cancel_work_sync(&mvif->csa_work);
+	}
+}
+
 const struct ieee80211_ops mt7996_ops = {
 	.add_chanctx = mt76_add_chanctx,
 	.remove_chanctx = mt76_remove_chanctx,
 	.change_chanctx = mt76_change_chanctx,
 	.assign_vif_chanctx = mt76_assign_vif_chanctx,
-	.unassign_vif_chanctx = mt76_unassign_vif_chanctx,
+	.unassign_vif_chanctx = mt7996_unassign_vif_chanctx,
 	.switch_vif_chanctx = mt76_switch_vif_chanctx,
 	.tx = mt7996_tx,
 	.start = mt7996_start,
@@ -2520,6 +2629,10 @@ const struct ieee80211_ops mt7996_ops =
 	.get_txpower = mt7996_get_txpower,
 	.channel_switch_beacon = mt7996_channel_switch_beacon,
 	.post_channel_switch = mt7996_post_channel_switch,
+	.pre_channel_switch = mt7996_pre_channel_switch,
+	.channel_switch = mt7996_channel_switch,
+	.abort_channel_switch = mt7996_abort_channel_switch,
+	.channel_switch_rx_beacon = mt7996_channel_switch_rx_beacon,
 	.get_stats = mt7996_get_stats,
 	.get_et_sset_count = mt7996_get_et_sset_count,
 	.get_et_stats = mt7996_get_et_stats,
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -320,6 +320,10 @@ struct mt7996_vif {
 
 	struct mt7996_sta sta;
 	struct mt7996_dev *dev;
+
+	struct work_struct csa_work;
+	struct timer_list csa_timer;
+	struct cfg80211_chan_def csa_chandef;
 };
 
 /* crash-dump */
@@ -981,6 +985,7 @@ void mt7996_mac_write_txwi(struct mt7996
 			   enum mt76_txq_id qid, u32 changed);
 void mt7996_mac_update_beacons(struct mt7996_phy *phy);
 void mt7996_mac_set_coverage_class(struct mt7996_phy *phy);
+void mt7996_csa_work(struct work_struct *work);
 void mt7996_mac_work(struct work_struct *work);
 void mt7996_mac_reset_work(struct work_struct *work);
 void mt7996_mac_dump_work(struct work_struct *work);
