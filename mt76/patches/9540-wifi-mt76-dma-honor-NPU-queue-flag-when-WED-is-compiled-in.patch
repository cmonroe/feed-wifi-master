From: Chad Monroe <chad@monroe.io>
Date: Sun, 05 Jul 2026 13:18:58 -0700
Subject: [PATCH] wifi: mt76: dma: honor NPU queue flag when WED is
 compiled in

The Q_READ/Q_WRITE ring register accessors select their implementation
at compile time and the WED variant shadows the NPU variant whenever
CONFIG_NET_MEDIATEK_SOC_WED is enabled. On kernels that enable both
WED and MT76_NPU, register accesses for NPU flagged queues fall
through to plain readl/writel on q->regs, so the NPU RX rings are
never configured in the NPU and the RX consumer index never reaches
it. The rings stall after the initial fill: the AP still beacons and
clients associate, but no client data is ever received.

Add a combined variant that routes WED flagged queues to the WED
register ops and NPU flagged queues to the NPU regmap, falling back
to plain MMIO for everything else. Builds with only one of the two
options keep their existing variants.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 dma.h |   46 +++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 45 insertions(+), 1 deletion(-)

--- a/dma.h
+++ b/dma.h
@@ -46,7 +46,51 @@
 #define MT_FCE_INFO_LEN			4
 #define MT_RX_RXWI_LEN			32
 
-#if IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED)
+#if IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED) && IS_ENABLED(CONFIG_MT76_NPU)
+
+#define Q_READ(_q, _field) ({						\
+	u32 _offset = offsetof(struct mt76_queue_regs, _field);		\
+	u32 _val = 0;							\
+	if ((_q)->flags & MT_QFLAG_WED) {				\
+		_val = mtk_wed_device_reg_read((_q)->wed,		\
+					       ((_q)->wed_regs +	\
+						_offset));		\
+	} else if ((_q)->flags & MT_QFLAG_NPU) {			\
+		struct airoha_npu *npu;					\
+									\
+		rcu_read_lock();					\
+		npu = rcu_dereference((_q)->dev->mmio.npu);		\
+		if (npu)						\
+			regmap_read(npu->regmap,			\
+				    ((_q)->wed_regs + _offset), &_val);	\
+		rcu_read_unlock();					\
+	} else {							\
+		_val = readl(&(_q)->regs->_field);			\
+	}								\
+	_val;								\
+})
+
+#define Q_WRITE(_q, _field, _val)	do {				\
+	u32 _offset = offsetof(struct mt76_queue_regs, _field);		\
+	if ((_q)->flags & MT_QFLAG_WED) {				\
+		mtk_wed_device_reg_write((_q)->wed,			\
+					 ((_q)->wed_regs + _offset),	\
+					 _val);				\
+	} else if ((_q)->flags & MT_QFLAG_NPU) {			\
+		struct airoha_npu *npu;					\
+									\
+		rcu_read_lock();					\
+		npu = rcu_dereference((_q)->dev->mmio.npu);		\
+		if (npu)						\
+			regmap_write(npu->regmap,			\
+				     ((_q)->wed_regs + _offset), _val);	\
+		rcu_read_unlock();					\
+	} else {							\
+		writel(_val, &(_q)->regs->_field);			\
+	}								\
+} while (0)
+
+#elif IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED)
 
 #define Q_READ(_q, _field) ({						\
 	u32 _offset = offsetof(struct mt76_queue_regs, _field);		\
