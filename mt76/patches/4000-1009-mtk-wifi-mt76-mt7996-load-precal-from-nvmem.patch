From edd667417d5bf86af2b0c04679782614a6b8ef8f Mon Sep 17 00:00:00 2001
From: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Date: Fri, 31 Mar 2023 11:36:34 +0800
Subject: [PATCH 020/223] mtk: mt76: mt7996: load precal data from flash/nvmem

Load pre-calibration data on mt7996 from the flash MTD partition, or
from an nvmem "precal" cell when no MTD source is present;
mt7996_eeprom_init() calls mt7996_eeprom_load_precal() after the
eeprom load.

Export mt7996_eeprom_name() so the eeprom_mode debugfs node can report
the active eeprom source (default bin, efuse, flash, external eeprom).

Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
---
 mt7996/eeprom.c      |   32 ++++++++++++++++++++++++++++++--
 mt7996/mt7996.h      |    1 +
 mt7996/mtk_debugfs.c |   41 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 72 insertions(+), 2 deletions(-)

--- a/mt7996/eeprom.c
+++ b/mt7996/eeprom.c
@@ -60,7 +60,7 @@ static int mt7996_check_eeprom(struct mt
 	}
 }
 
-static char *mt7996_eeprom_name(struct mt7996_dev *dev)
+const char *mt7996_eeprom_name(struct mt7996_dev *dev)
 {
 	switch (mt76_chip(&dev->mt76)) {
 	case MT7992_DEVICE_ID:
@@ -395,14 +395,42 @@ int mt7996_eeprom_parse_hw_cap(struct mt
 	return mt7996_eeprom_parse_band_config(phy);
 }
 
+static int mt7996_eeprom_load_precal(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	u8 *eeprom = mdev->eeprom.data;
+	u32 offs = MT_EE_DO_PRE_CAL;
+	u32 size, val = eeprom[offs];
+	int ret;
+
+	mt7996_eeprom_init_precal(dev);
+
+	if (dev->eeprom_mode != EEPROM_MODE_FLASH || !val)
+		return 0;
+
+	size = MT_EE_CAL_GROUP_SIZE + MT_EE_CAL_DPD_SIZE;
+
+	dev->cal = devm_kzalloc(mdev->dev, size, GFP_KERNEL);
+	if (!dev->cal)
+		return -ENOMEM;
+
+	ret = mt76_get_of_data_from_mtd(mdev, dev->cal, offs, size);
+	if (!ret)
+ 		return ret;
+
+	return mt76_get_of_data_from_nvmem(mdev, dev->cal, "precal", size);
+}
+
 int mt7996_eeprom_init(struct mt7996_dev *dev)
 {
 	int ret;
 
 	ret = mt7996_eeprom_load(dev);
-	if (ret < 0)
+	if (ret)
 		return ret;
 
+	mt7996_eeprom_load_precal(dev);
+
 	ret = mt7996_eeprom_parse_hw_cap(dev, &dev->phy);
 	if (ret < 0)
 		return ret;
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -735,6 +735,7 @@ int mt7996_vif_link_add(struct mt76_phy
 void mt7996_vif_link_remove(struct mt76_phy *mphy, struct ieee80211_vif *vif,
 			    struct ieee80211_bss_conf *link_conf,
 			    struct mt76_vif_link *mlink);
+const char *mt7996_eeprom_name(struct mt7996_dev *dev);
 int mt7996_eeprom_init(struct mt7996_dev *dev);
 int mt7996_eeprom_parse_hw_cap(struct mt7996_dev *dev, struct mt7996_phy *phy);
 int mt7996_eeprom_get_target_power(struct mt7996_dev *dev,
--- a/mt7996/mtk_debugfs.c
+++ b/mt7996/mtk_debugfs.c
@@ -2712,6 +2712,44 @@ static const struct file_operations mt79
 	.llseek = default_llseek,
 };
 
+static int mt7996_show_eeprom_mode(struct seq_file *s, void *data)
+{
+	struct mt7996_dev *dev = dev_get_drvdata(s->private);
+#ifdef CONFIG_NL80211_TESTMODE
+	struct mt76_dev *mdev = &dev->mt76;
+	const char *mtd_name = mdev->test_mtd.name;
+	u32 mtd_offset = mdev->test_mtd.offset;
+#else
+	const char *mtd_name = NULL;
+	u32 mtd_offset;
+#endif
+
+	seq_printf(s, "Current eeprom mode:\n");
+
+	switch (dev->eeprom_mode) {
+	case EEPROM_MODE_DEFAULT_BIN:
+		seq_printf(s, "   default bin mode\n   filename = %s\n", mt7996_eeprom_name(dev));
+		break;
+	case EEPROM_MODE_EFUSE:
+		seq_printf(s, "   efuse mode\n");
+		break;
+	case EEPROM_MODE_FLASH:
+		if (mtd_name)
+			seq_printf(s, "   flash mode\n   mtd name = %s\n   flash offset = 0x%x\n",
+				   mtd_name, mtd_offset);
+		else
+			seq_printf(s, "   flash mode\n");
+		break;
+	case EEPROM_MODE_EXT:
+		seq_printf(s, "   external eeprom mode\n");
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
 int mt7996_mtk_init_debugfs(struct mt7996_dev *dev, struct dentry *dir)
 {
 	struct ieee80211_hw *hw = mt76_hw(dev);
@@ -2772,6 +2810,9 @@ int mt7996_mtk_init_debugfs(struct mt799
 	debugfs_create_devm_seqfile(dev->mt76.dev, "tr_info", dir,
 				    mt7996_trinfo_read);
 
+	debugfs_create_devm_seqfile(dev->mt76.dev, "eeprom_mode", dir,
+				    mt7996_show_eeprom_mode);
+
 	debugfs_create_devm_seqfile(dev->mt76.dev, "wtbl_info", dir,
 				    mt7996_wtbl_read);
 
