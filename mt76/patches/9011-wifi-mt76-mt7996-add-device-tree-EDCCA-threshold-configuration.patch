From: Chad Monroe <chad@monroe.io>
Date: Wed, 07 Jan 2026 11:25:54 -0800
Subject: [PATCH] wifi: mt76: mt7996: add device tree EDCCA threshold configuration

Allow per-band EDCCA thresholds to be specified in device tree power-limits
nodes using edcca-threshold-bw{20,40,80,160} properties. Thresholds are
applied on regulatory domain change and preserve firmware defaults for any
unspecified bandwidths.

One step applies the device tree limits and the thresholds that
hostapd sets through the vendor command, after each channel set on the
operating channel, after a full reset and on a regulatory change. A
threshold from hostapd takes precedence over the device tree. An EDCCA
disable from hostapd stays in force, because the device tree step
would otherwise enable EDCCA again. The step also sends an EDCCA
enable from hostapd again. The enable carries the EDCCA standard of
the region, which a full reset or a country change replaces.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 eeprom.c        |   54 ++++++++++++++++++++++++++++++++++++++
 mt76.h          |    8 +++++
 mt7996/init.c   |   79 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 mt7996/mac.c    |    4 ++
 mt7996/main.c   |   18 +++++-------
 mt7996/mt7996.h |    3 ++
 mt7996/vendor.c |   10 ++++++-
 7 files changed, 164 insertions(+), 12 deletions(-)

--- a/eeprom.c
+++ b/eeprom.c
@@ -585,6 +585,60 @@ s8 mt76_get_rate_power_limits(struct mt7
 }
 EXPORT_SYMBOL_GPL(mt76_get_rate_power_limits);
 
+int mt76_get_edcca_limits(struct mt76_phy *phy,
+			  struct ieee80211_channel *chan,
+			  struct mt76_edcca_limits *dest)
+{
+	static const char * const bw_names[] = {
+		"edcca-threshold-bw20",
+		"edcca-threshold-bw40",
+		"edcca-threshold-bw80",
+		"edcca-threshold-bw160",
+	};
+	struct device_node *np;
+	char name[16];
+	char band;
+	int i;
+
+	memset(dest, 0, sizeof(*dest));
+
+	if (!IS_ENABLED(CONFIG_OF))
+		return 0;
+
+	np = mt76_find_power_limits_node(phy->dev);
+	if (!np)
+		return 0;
+
+	switch (chan->band) {
+	case NL80211_BAND_2GHZ:
+		band = '2';
+		break;
+	case NL80211_BAND_5GHZ:
+		band = '5';
+		break;
+	case NL80211_BAND_6GHZ:
+		band = '6';
+		break;
+	default:
+		return 0;
+	}
+
+	snprintf(name, sizeof(name), "txpower-%cg", band);
+	np = of_get_child_by_name(np, name);
+	if (!np)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(bw_names); i++) {
+		if (!of_property_read_u8(np, bw_names[i], &dest->threshold[i]))
+			dest->valid_mask |= BIT(i);
+	}
+
+	of_node_put(np);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt76_get_edcca_limits);
+
 int
 mt76_eeprom_init(struct mt76_dev *dev, int len)
 {
--- a/mt76.h
+++ b/mt76.h
@@ -1265,6 +1265,11 @@ struct mt76_power_limits {
 	} path;
 };
 
+struct mt76_edcca_limits {
+	u8 threshold[4];
+	u8 valid_mask;
+};
+
 struct mt76_ethtool_worker_info {
 	u64 *data;
 	int idx;
@@ -2161,6 +2166,9 @@ s8 mt76_get_rate_power_limits(struct mt7
 			      struct ieee80211_channel *chan,
 			      struct mt76_power_limits *dest,
 			      s8 target_power);
+int mt76_get_edcca_limits(struct mt76_phy *phy,
+			  struct ieee80211_channel *chan,
+			  struct mt76_edcca_limits *dest);
 
 static inline bool mt76_queue_is_rx(struct mt76_dev *dev, struct mt76_queue *q)
 {
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -423,6 +423,82 @@ void mt7996_init_txpower(struct mt7996_p
 		__mt7996_init_txpower(phy, &phy->mt76->sband_6g.sband);
 }
 
+void mt7996_apply_edcca_limits(struct mt7996_phy *phy)
+{
+	struct mt76_edcca_limits limits;
+	struct ieee80211_channel *chan;
+	u8 thresh[EDCCA_MAX_BW_NUM];
+	bool user_thresh;
+	int ret, i;
+
+	lockdep_assert_held(&phy->dev->mt76.mutex);
+
+	if (!phy->mt76->chandef.chan) {
+		dev_info(phy->dev->mt76.dev, "EDCCA: no channel defined\n");
+		return;
+	}
+
+	/* the disable must also hold after a full reset, which reloads the
+	 * firmware with its default EDCCA state
+	 */
+	if (phy->user_edcca_disabled) {
+		ret = mt7996_mcu_edcca_enable(phy, false);
+		if (ret)
+			dev_warn(phy->dev->mt76.dev,
+				 "failed to disable EDCCA: %d\n", ret);
+		return;
+	}
+
+	chan = phy->mt76->chandef.chan;
+
+	ret = mt76_get_edcca_limits(phy->mt76, chan, &limits);
+	if (ret)
+		return;
+
+	user_thresh = !!memchr_inv(phy->user_edcca_threshold,
+				   MT7996_EDCCA_THRESHOLD_KEEP,
+				   sizeof(phy->user_edcca_threshold));
+
+	if (limits.valid_mask)
+		dev_dbg(phy->dev->mt76.dev,
+			"EDCCA: band=%d valid_mask=0x%x threshold=[%02x,%02x,%02x,%02x]\n",
+			chan->band, limits.valid_mask,
+			limits.threshold[0], limits.threshold[1],
+			limits.threshold[2], limits.threshold[3]);
+
+	/* the enable command carries the EDCCA standard of the region, so
+	 * it must follow a country change and a full reset
+	 */
+	if (limits.valid_mask || phy->user_edcca_enabled) {
+		ret = mt7996_mcu_edcca_enable(phy, true);
+		if (ret) {
+			dev_warn(phy->dev->mt76.dev,
+				 "failed to enable EDCCA: %d\n", ret);
+			return;
+		}
+	}
+
+	if (!limits.valid_mask && !user_thresh)
+		return;
+
+	/* a threshold that hostapd sets takes precedence over the device
+	 * tree
+	 */
+	for (i = 0; i < EDCCA_MAX_BW_NUM; i++) {
+		if (phy->user_edcca_threshold[i] != MT7996_EDCCA_THRESHOLD_KEEP)
+			thresh[i] = phy->user_edcca_threshold[i];
+		else if (limits.valid_mask & BIT(i))
+			thresh[i] = limits.threshold[i];
+		else
+			thresh[i] = MT7996_EDCCA_THRESHOLD_KEEP;
+	}
+
+	ret = mt7996_mcu_edcca_threshold_ctrl(phy, thresh, true);
+	if (ret)
+		dev_warn(phy->dev->mt76.dev,
+			 "failed to set EDCCA threshold: %d\n", ret);
+}
+
 static void
 mt7996_regd_notifier(struct wiphy *wiphy,
 		     struct regulatory_request *request)
@@ -438,7 +514,10 @@ mt7996_regd_notifier(struct wiphy *wiphy
 		if (dev->mt76.region == NL80211_DFS_UNSET)
 			mt7996_mcu_rdd_background_enable(phy, NULL);
 
+		mutex_lock(&dev->mt76.mutex);
 		mt7996_init_txpower(phy);
+		mt7996_apply_edcca_limits(phy);
+		mutex_unlock(&dev->mt76.mutex);
 		phy->mt76->dfs_state = MT_DFS_STATE_UNKNOWN;
 		mt7996_dfs_init_radar_detector(phy);
 	}
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2253,8 +2253,10 @@ mt7996_mac_restart(struct mt7996_dev *de
 		goto out;
 
 	mt7996_mac_init(dev);
-	mt7996_for_each_phy(dev, phy)
+	mt7996_for_each_phy(dev, phy) {
 		mt7996_init_txpower(phy);
+		mt7996_apply_edcca_limits(phy);
+	}
 	ret = mt7996_txbf_init(dev);
 	if (ret)
 		goto out;
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -67,12 +67,15 @@ int mt7996_run(struct mt7996_phy *phy)
 	if (ret)
 		return ret;
 
-	/* hostapd sends the thresholds only when it sets up the interface,
-	 * and a full reset restarts the radio without hostapd
+	/* hostapd sends the EDCCA settings only when it sets up the
+	 * interface, and a full reset restarts the radio without hostapd
 	 */
-	if (!dev->recovery.hw_full_reset)
+	if (!dev->recovery.hw_full_reset) {
 		memset(phy->user_edcca_threshold, MT7996_EDCCA_THRESHOLD_KEEP,
 		       sizeof(phy->user_edcca_threshold));
+		phy->user_edcca_enabled = false;
+		phy->user_edcca_disabled = false;
+	}
 
 	set_bit(MT76_STATE_RUNNING, &phy->mt76->state);
 
@@ -730,14 +733,9 @@ int mt7996_set_channel(struct mt76_phy *
 	mt7996_mac_cca_stats_reset(phy);
 
 	mt7996_mac_reset_counters(phy);
-#ifdef CONFIG_MTK_VENDOR
 	/* the firmware replaces the thresholds when it sets a channel */
-	if (!mphy->offchannel &&
-	    memchr_inv(phy->user_edcca_threshold, MT7996_EDCCA_THRESHOLD_KEEP,
-		       sizeof(phy->user_edcca_threshold)))
-		mt7996_mcu_edcca_threshold_ctrl(phy, phy->user_edcca_threshold,
-						true);
-#endif
+	if (!mphy->offchannel)
+		mt7996_apply_edcca_limits(phy);
 	phy->noise = 0;
 	if (!mphy->offchannel)
 		mt7996_mac_update_beacons(phy);
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -533,6 +533,8 @@ struct mt7996_phy {
 	u16 punct_bitmap;
 
 	u8 user_edcca_threshold[EDCCA_MAX_BW_NUM];
+	bool user_edcca_enabled;
+	bool user_edcca_disabled;
 
 	struct mt7996_scs_ctrl scs_ctrl;
 };
@@ -879,6 +881,7 @@ void mt7996_dma_start(struct mt7996_dev
 int mt7996_init_tx_queues(struct mt7996_phy *phy, int idx,
 			  int n_desc, int ring_base, struct mtk_wed_device *wed);
 void mt7996_init_txpower(struct mt7996_phy *phy);
+void mt7996_apply_edcca_limits(struct mt7996_phy *phy);
 int mt7996_txbf_init(struct mt7996_dev *dev);
 void mt7996_reset(struct mt7996_dev *dev);
 int mt7996_run(struct mt7996_phy *phy);
