-int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi)
+/* A band over its reserve may take only the free tokens that no other band
+ * needs to fill its own reserve.
+ */
+static bool mt76_token_admit(struct mt76_dev *dev, struct mt76_phy *phy)
 {
-	int token;
+	u16 reserve = READ_ONCE(dev->token_reserve);
+	int reserved = 0;
+	int i;
+
+	if (!reserve || phy->tokens < reserve)
+		return true;
+
+	for (i = 0; i < __MT_MAX_BAND; i++) {
+		struct mt76_phy *other = dev->phys[i];
+
+		if (!other || other == phy || other->tokens >= reserve)
+			continue;
+
+		reserved += reserve - other->tokens;
+	}
+
+	return mt76_token_free_count(dev) > reserved;
+}
+
+int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi,
+		       u8 phy_idx)
+{
+	struct mt76_phy *phy;
+	int token = -EBUSY;
 
 	spin_lock_bh(&dev->token_lock);
 
+	phy = mt76_dev_phy(dev, phy_idx);
+	if (!mt76_token_admit(dev, phy))
+		goto out;
+
 	token = idr_alloc(&dev->token, *ptxwi, dev->token_start,
 			  dev->token_start + dev->token_size,
 			  GFP_ATOMIC);
@@ -996,6 +1026,9 @@ int mt76_token_consume(struct mt76_dev *
 			struct mt76_phy *mphy = mt76_dev_phy(dev, (*ptxwi)->phy_idx);
 			atomic_inc(&mphy->mgmt_tx_pending);
 		}
+
+		(*ptxwi)->token_phy_idx = phy_idx;
+		phy->tokens++;
 	}
 
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
@@ -1006,6 +1039,7 @@ int mt76_token_consume(struct mt76_dev *
 	if (dev->token_count >= dev->token_size - MT76_TOKEN_FREE_THR)
 		__mt76_set_tx_blocked(dev, true);
 
+out:
 	spin_unlock_bh(&dev->token_lock);
 
 	return token;
@@ -1034,12 +1068,16 @@ struct mt76_txwi_cache *
 mt76_token_release(struct mt76_dev *dev, int token, bool *wake)
 {
 	struct mt76_txwi_cache *txwi;
+	struct mt76_phy *phy = NULL;
 
 	spin_lock_bh(&dev->token_lock);
 
 	txwi = idr_remove(&dev->token, token);
 	if (txwi) {
+		phy = mt76_dev_phy(dev, txwi->token_phy_idx);
 		dev->token_count--;
+		if (phy->tokens > 0)
+			phy->tokens--;
 
 		if (txwi->qid == MT_TXQ_PSD) {
 			struct mt76_phy *mphy = mt76_dev_phy(dev, txwi->phy_idx);
