From: Chad Monroe <chad@monroe.io>
Date: Fri, 25 Sep 2026 11:22:55 -0700
Subject: [PATCH] wifi: mt76: restart radar on reset, release the chain on region change

cfg80211 keeps a background radar chain on its channel after the CAC,
and the channel stays available while the chain monitors it. A full
chip reset reloads the firmware without the background detector, and
a region change leaves it running with the old rules. In both cases
cfg80211 still counts the channel as monitored. The reloaded firmware
also runs no radar detector on the operating channel. The first
channel set after the restart finds a cached DFS state that matches
the channel, and does not start the detector.

Abort the background chain in both cases, so cfg80211 releases the
channel and tells hostapd to arm the chain again. The driver now
accepts a stop of the detector while the region is unset, so the
driver and cfg80211 agree that the chain is off. A full reset marks
the DFS state of each band unknown, so the first channel set after
the restart starts the radar detector again.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7915/init.c |   12 ++++++++++++
 mt7915/mac.c  |   13 +++++++++++++
 mt7915/main.c |    2 +-
 mt7996/init.c |    9 +++++++++
 mt7996/mac.c  |   12 ++++++++++++
 mt7996/main.c |    2 +-
 6 files changed, 48 insertions(+), 2 deletions(-)

--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -422,6 +422,7 @@ mt7915_regd_notifier(struct wiphy *wiphy
 	struct mt76_phy *mphy = hw->priv;
 	struct mt7915_phy *phy = mphy->priv;
 	bool update_txpower;
+	bool changed;
 
 	update_txpower = memcmp(phy->regd_alpha2, request->alpha2,
 				sizeof(phy->regd_alpha2)) ||
@@ -429,9 +430,20 @@ mt7915_regd_notifier(struct wiphy *wiphy
 	memcpy(phy->regd_alpha2, request->alpha2, sizeof(phy->regd_alpha2));
 	phy->regd_region = request->dfs_region;
 
+	changed = memcmp(dev->mt76.alpha2, request->alpha2,
+			 sizeof(dev->mt76.alpha2)) ||
+		  dev->mt76.region != request->dfs_region;
+
 	memcpy(dev->mt76.alpha2, request->alpha2, sizeof(dev->mt76.alpha2));
 	dev->mt76.region = request->dfs_region;
 
+	/* the background detector still runs with the old region rules; the
+	 * device state is shared, so the first notifier of a change aborts
+	 * the chain on whichever wiphy owns it
+	 */
+	if (changed && dev->rdd2_phy)
+		cfg80211_background_cac_abort(dev->rdd2_phy->mt76->hw->wiphy);
+
 	if (dev->mt76.region == NL80211_DFS_UNSET)
 		mt7915_mcu_rdd_background_enable(phy, NULL);
 
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1378,6 +1378,19 @@ mt7915_mac_full_reset(struct mt7915_dev
 	if (phy2)
 		phy2->omac_mask = 0;
 
+	/* the firmware reload drops the background detector and nothing
+	 * arms it again, so cfg80211 must stop treating it as monitoring
+	 */
+	if (dev->rdd2_phy)
+		cfg80211_background_cac_abort(dev->rdd2_phy->mt76->hw->wiphy);
+
+	/* the reloaded firmware runs no radar detector, and the first
+	 * channel set after the restart skips a state that looks current
+	 */
+	phy->mt76->dfs_state = MT_DFS_STATE_UNKNOWN;
+	if (phy2)
+		phy2->mt76->dfs_state = MT_DFS_STATE_UNKNOWN;
+
 	mt76_reset_device(&dev->mt76);
 	bitmap_zero(dev->adm_count_clear, MT76_N_WCIDS);
 
--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -1846,7 +1846,7 @@ mt7915_set_radar_background(struct ieee8
 
 	mutex_lock(&dev->mt76.mutex);
 
-	if (dev->mt76.region == NL80211_DFS_UNSET)
+	if (chandef && dev->mt76.region == NL80211_DFS_UNSET)
 		goto out;
 
 	if (dev->rdd2_phy && dev->rdd2_phy != phy) {
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -506,10 +506,19 @@ mt7996_regd_notifier(struct wiphy *wiphy
 	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
 	struct mt7996_dev *dev = mt7996_hw_dev(hw);
 	struct mt7996_phy *phy;
+	bool changed;
+
+	changed = memcmp(dev->mt76.alpha2, request->alpha2,
+			 sizeof(dev->mt76.alpha2)) ||
+		  dev->mt76.region != request->dfs_region;
 
 	memcpy(dev->mt76.alpha2, request->alpha2, sizeof(dev->mt76.alpha2));
 	dev->mt76.region = request->dfs_region;
 
+	/* the background detector still runs with the old region rules */
+	if (changed && dev->rdd2_phy)
+		cfg80211_background_cac_abort(wiphy);
+
 	mt7996_for_each_phy(dev, phy) {
 		if (dev->mt76.region == NL80211_DFS_UNSET)
 			mt7996_mcu_rdd_background_enable(phy, NULL);
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2371,6 +2371,18 @@ mt7996_mac_full_reset(struct mt7996_dev
 	dev->mld_idx_mask = 0;
 	dev->mld_remap_idx_mask = 0;
 
+	/* the firmware reload drops the background detector and nothing
+	 * arms it again, so cfg80211 must stop treating it as monitoring
+	 */
+	if (dev->rdd2_phy)
+		cfg80211_background_cac_abort(hw->wiphy);
+
+	/* the reloaded firmware runs no radar detector, and the first
+	 * channel set after the restart skips a state that looks current
+	 */
+	mt7996_for_each_phy(dev, phy)
+		phy->mt76->dfs_state = MT_DFS_STATE_UNKNOWN;
+
 	ieee80211_iterate_stations_atomic(hw, mt7996_mac_reset_sta_iter, dev);
 	mt76_reset_device(&dev->mt76);
 	ieee80211_iterate_active_interfaces_atomic(hw,
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -3275,7 +3275,7 @@ mt7996_set_radar_background(struct ieee8
 
 	mutex_lock(&dev->mt76.mutex);
 
-	if (dev->mt76.region == NL80211_DFS_UNSET)
+	if (chandef && dev->mt76.region == NL80211_DFS_UNSET)
 		goto out;
 
 	if (dev->rdd2_phy && dev->rdd2_phy != phy) {
