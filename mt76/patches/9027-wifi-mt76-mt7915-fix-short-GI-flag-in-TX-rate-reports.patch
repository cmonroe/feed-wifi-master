From: Chad Monroe <chad@monroe.io>
Date: Wed, 07 Oct 2026 10:33:42 -0700
Subject: [PATCH] wifi: mt76: mt7915: fix short GI flag in TX rate reports

The firmware rate query sets the short GI flag of an HT or VHT
station, but it never clears the flag. A station that falls back to
long GI keeps a short GI rate in its TX status and statistics. A TX
status for a VHT rate also rebuilds the rate without the flag, so VHT
short GI is lost until the next query.

Clear the flag for long GI, and carry the flag over for VHT as the HT
case does. This matches 05f433900a02 ("wifi: mt76: mt7996: switch to
mcu command for TX GI report"). The station poll still computes a
rate and a bandwidth that nothing reads since the GI moved to the
firmware query; remove them.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt76_connac_mac.c |    2 ++
 mt7915/mac.c      |   18 ------------------
 mt7915/mcu.c      |    2 ++
 3 files changed, 4 insertions(+), 18 deletions(-)

--- a/mt76_connac_mac.c
+++ b/mt76_connac_mac.c
@@ -731,6 +731,8 @@ bool mt76_connac2_mac_fill_txs(struct mt
 			return false;
 
 		rate.flags = RATE_INFO_FLAGS_VHT_MCS;
+		if (wcid->rate.flags & RATE_INFO_FLAGS_SHORT_GI)
+			rate.flags |= RATE_INFO_FLAGS_SHORT_GI;
 		break;
 	case MT_PHY_TYPE_HE_SU:
 	case MT_PHY_TYPE_HE_EXT_SU:
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -90,7 +90,6 @@ u32 mt7915_mac_wtbl_lmac_addr(struct mt7
 static void mt7915_mac_sta_poll(struct mt7915_dev *dev)
 {
 	struct mt7915_sta *msta;
-	struct rate_info *rate;
 	LIST_HEAD(sta_poll_list);
 
 	spin_lock_bh(&dev->mt76.sta_poll_lock);
@@ -103,7 +102,6 @@ static void mt7915_mac_sta_poll(struct m
 		u32 addr, val;
 		u16 idx;
 		s8 rssi[4];
-		u8 bw;
 
 		spin_lock_bh(&dev->mt76.sta_poll_lock);
 		if (list_empty(&sta_poll_list)) {
@@ -116,22 +114,6 @@ static void mt7915_mac_sta_poll(struct m
 		spin_unlock_bh(&dev->mt76.sta_poll_lock);
 
 		idx = msta->wcid.idx;
-		rate = &msta->wcid.rate;
-
-		switch (rate->bw) {
-		case RATE_INFO_BW_160:
-			bw = IEEE80211_STA_RX_BW_160;
-			break;
-		case RATE_INFO_BW_80:
-			bw = IEEE80211_STA_RX_BW_80;
-			break;
-		case RATE_INFO_BW_40:
-			bw = IEEE80211_STA_RX_BW_40;
-			break;
-		default:
-			bw = IEEE80211_STA_RX_BW_20;
-			break;
-		}
 
 		/* get signal strength of resp frames (CTS/BA/ACK) */
 		addr = mt7915_mac_wtbl_lmac_addr(dev, idx, 30);
--- a/mt7915/mcu.c
+++ b/mt7915/mcu.c
@@ -4477,6 +4477,8 @@ mt7915_mcu_parse_tx_gi(struct mt76_dev *
 	case MT_PHY_TYPE_VHT:
 		if (gi)
 			rate->flags |= RATE_INFO_FLAGS_SHORT_GI;
+		else
+			rate->flags &= ~RATE_INFO_FLAGS_SHORT_GI;
 		break;
 	case MT_PHY_TYPE_HE_SU:
 	case MT_PHY_TYPE_HE_EXT_SU:
