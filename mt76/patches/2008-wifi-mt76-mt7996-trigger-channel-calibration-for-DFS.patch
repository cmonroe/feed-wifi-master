From: Chad Monroe <chad@monroe.io>
Date: Sun, 09 Aug 2026 20:00:28 -0700
Subject: [PATCH] wifi: mt76: mt7996: trigger channel calibration for DFS

Trigger channel calibration (set channel with switch reason NORMAL)
for DFS links once a STA is associated; without it, a 5 GHz link may
show high PER during throughput tests. Also set a parking channel
when the phy starts up.

mac80211 only marks the channel AVAILABLE via
cfg80211_sta_update_dfs_state() after the MLME event callback
returns, so a synchronous update from the callback would re-send
CH_SWITCH_DFS. Defer the update to a per-phy wiphy_delayed_work and
gate it on cfg80211_chandef_dfs_required() so only DFS links are
re-programmed.

Based-on-work-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7996/main.c |   46 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -26,6 +26,11 @@ int mt7996_run(struct mt7996_phy *phy)
 	if (ret)
 		return ret;
 
+	/* set a parking channel */
+	ret = mt7996_mcu_set_chan_info(phy, UNI_CHANNEL_SWITCH);
+	if (ret)
+		return ret;
+
 	ret = mt7996_mcu_set_thermal_throttling(phy, MT7996_THERMAL_THROTTLE_MAX);
 	if (ret)
 		return ret;
@@ -76,6 +81,8 @@ static void mt7996_stop_phy(struct mt799
 	dev = phy->dev;
 
 	cancel_delayed_work_sync(&phy->mt76->mac_work);
+	wiphy_delayed_work_cancel(phy->mt76->hw->wiphy,
+				  &phy->mt76->assoc_chan_work);
 
 	mutex_lock(&dev->mt76.mutex);
 
@@ -2691,6 +2698,44 @@ mt7996_set_eml_op_mode(struct ieee80211_
 	return ret;
 }
 
+static void
+mt7996_event_callback(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		      const struct ieee80211_event *event)
+{
+	struct mt7996_dev *dev = mt7996_hw_dev(hw);
+	unsigned long valid_links;
+	unsigned int link_id;
+
+	switch (event->type) {
+	case MLME_EVENT:
+		if (event->u.mlme.data != ASSOC_EVENT ||
+		    event->u.mlme.status != MLME_SUCCESS)
+			break;
+
+		valid_links = vif->valid_links ?: BIT(0);
+
+		for_each_set_bit(link_id, &valid_links, IEEE80211_MLD_MAX_NUM_LINKS) {
+			struct mt7996_vif_link *mconf;
+			struct mt7996_phy *phy;
+
+			mconf = mt7996_vif_link(dev, vif, link_id);
+			if (!mconf)
+				continue;
+
+			phy = mt7996_vif_link_phy(mconf);
+			if (!phy)
+				continue;
+
+			wiphy_delayed_work_queue(hw->wiphy,
+						 &phy->mt76->assoc_chan_work,
+						 0);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
 const struct ieee80211_ops mt7996_ops = {
 	.add_chanctx = mt76_add_chanctx,
 	.remove_chanctx = mt76_remove_chanctx,
@@ -2723,6 +2768,7 @@ const struct ieee80211_ops mt7996_ops =
 	.get_txpower = mt7996_get_txpower,
 	.channel_switch_beacon = mt7996_channel_switch_beacon,
 	.post_channel_switch = mt7996_post_channel_switch,
+	.event_callback = mt7996_event_callback,
 	.get_stats = mt7996_get_stats,
 	.get_et_sset_count = mt7996_get_et_sset_count,
 	.get_et_stats = mt7996_get_et_stats,
