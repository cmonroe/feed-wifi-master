From: Chad Monroe <chad@monroe.io>
Date: Mon, 23 Mar 2026 03:39:33 -0700
Subject: [PATCH] wifi: mt76: mt7996: guard airtime counters against overflow

The MCU airtime event reports absolute HW counters, not deltas. Track
per-AC last-known values and compute deltas with wraparound handling.
Reset HW counters via WTBL when BIT(30) is reached and clamp deltas
above 600 ms to zero to suppress FW reporting spikes.

Also fixes mt76_sta_stats airtime fields from u64 scalars to u32
per-AC arrays -- the mt7915 MCU airtime handler already indexes them
as arrays, corrupting adjacent struct members.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt76.h        |    4 +--
 mt7996/main.c |    5 ----
 mt7996/mcu.c  |   51 ++++++++++++++++++++++++++++++++++++++++++------
 3 files changed, 47 insertions(+), 13 deletions(-)

--- a/mt76.h
+++ b/mt76.h
@@ -403,7 +403,7 @@ struct mt76_sta_stats {
 	u32 tx_mpdus;
 	u32 tx_retries;
 	u32 tx_failed;
-	u64 tx_airtime;
+	u32 tx_airtime[IEEE80211_NUM_ACS];
 	/* WED RX */
 	u64 rx_bytes;
 	u64 rx_bytes_per_ac[IEEE80211_NUM_ACS];
@@ -412,7 +412,7 @@ struct mt76_sta_stats {
 	u32 rx_fcs_err;
 	u32 rx_errors;
 	u32 rx_drops;
-	u64 rx_airtime;
+	u32 rx_airtime[IEEE80211_NUM_ACS];
 	u64 last_rx_bytes;
 };
 
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1980,11 +1980,6 @@ static void mt7996_link_sta_statistics(s
 	link_sinfo->fcs_err_count = stats->rx_fcs_err;
 	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_FCS_ERROR_COUNT);
 
-	link_sinfo->tx_duration = stats->tx_airtime;
-	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_DURATION);
-
-	link_sinfo->rx_duration = stats->rx_airtime;
-	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_RX_DURATION);
 out:
 	mutex_unlock(&dev->mt76.mutex);
 }
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -807,8 +807,10 @@ mt7996_mcu_rx_all_sta_info_event(struct
 		struct mt76_wcid *wcid;
 		struct mt76_phy *mphy;
 		struct ieee80211_sta *sta;
-		u32 tx_bytes, rx_bytes, tx_bytes_failed = 0, tx_airtime, rx_airtime,
+		u32 tx_bytes, rx_bytes, tx_bytes_failed = 0,
 		    tx_packets, rx_packets;
+		u32 prev_tx_airtime, prev_rx_airtime, diff_tx_airtime, diff_rx_airtime;
+		bool clear;
 
 		switch (le16_to_cpu(res->tag)) {
 		case UNI_ALL_STA_TXRX_RATE:
@@ -875,16 +877,53 @@ mt7996_mcu_rx_all_sta_info_event(struct
 			if (!sta)
 				continue;
 
+			clear = false;
 			for (ac = IEEE80211_AC_VO; ac < IEEE80211_NUM_ACS; ++ac) {
 				u8 lmac_ac = mt76_connac_lmac_mapping(ac);
-				tx_airtime = le32_to_cpu(res->airtime[i].tx[lmac_ac]);
-				rx_airtime = le32_to_cpu(res->airtime[i].rx[lmac_ac]);
 
-				wcid->stats.tx_airtime += tx_airtime;
-				wcid->stats.rx_airtime += rx_airtime;
+				prev_tx_airtime = wcid->stats.tx_airtime[ac];
+				prev_rx_airtime = wcid->stats.rx_airtime[ac];
+				wcid->stats.tx_airtime[ac] = le32_to_cpu(res->airtime[i].tx[lmac_ac]);
+				wcid->stats.rx_airtime[ac] = le32_to_cpu(res->airtime[i].rx[lmac_ac]);
+
+				if (wcid->stats.tx_airtime[ac] >= prev_tx_airtime)
+					diff_tx_airtime = wcid->stats.tx_airtime[ac] - prev_tx_airtime;
+				else
+					diff_tx_airtime = wcid->stats.tx_airtime[ac];
+
+				if (wcid->stats.rx_airtime[ac] >= prev_rx_airtime)
+					diff_rx_airtime = wcid->stats.rx_airtime[ac] - prev_rx_airtime;
+				else
+					diff_rx_airtime = wcid->stats.rx_airtime[ac];
+
+				if ((wcid->stats.tx_airtime[ac] | wcid->stats.rx_airtime[ac]) & BIT(30)) {
+					clear = true;
+					dev_dbg(dev->mt76.dev,
+						"sta: %pM ac: %u tx: %u rx: %u tx_prev: %u rx_prev: %u clear\n",
+						sta->addr, ac,
+						wcid->stats.tx_airtime[ac],
+						wcid->stats.rx_airtime[ac],
+						prev_tx_airtime, prev_rx_airtime);
+				}
+
+				if (diff_tx_airtime > 600000 || diff_rx_airtime > 600000) {
+					dev_dbg(dev->mt76.dev,
+						"sta: %pM ac: %u tx_diff: %u rx_diff: %u spike filtered\n",
+						sta->addr, ac,
+						diff_tx_airtime, diff_rx_airtime);
+					if (diff_tx_airtime > 600000)
+						diff_tx_airtime = 0;
+					if (diff_rx_airtime > 600000)
+						diff_rx_airtime = 0;
+				}
+
 				ieee80211_sta_register_airtime(sta, mt76_ac_to_tid(ac),
-				                               tx_airtime, rx_airtime);
+							       diff_tx_airtime, diff_rx_airtime);
 			}
+
+			if (clear)
+				mt7996_mac_wtbl_update(dev, wcid->idx,
+						       MT_WTBL_UPDATE_ADM_COUNT_CLEAR);
 			break;
 		case UNI_ALL_STA_RX_MPDU_COUNT:
 			wlan_idx = le16_to_cpu(res->rx_mpdu_cnt[i].wlan_idx);
