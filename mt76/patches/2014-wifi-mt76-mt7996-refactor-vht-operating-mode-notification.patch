From: Allen Ye <allen.ye@mediatek.com>
Date: Tue, 8 Oct 2024 19:58:14 +0800
Subject: [PATCH] wifi: mt76: mt7996: refactor VHT operating mode notification
 handling

The STA_REC_RA command provides operating-mode fields which were
left at zero, so the firmware rate controller never learned the
station capability envelope versus its current operating limits.
Fill them at station addition and push updates through the new
RATE_PARAM_VHT_OMN_UPDATE field when a station sends an operating
mode notification.

Requires the mac80211 ieee80211_link_sta_cap_bw()/cap_nss() helpers
and IEEE80211_RC_VHT_OMN_CHANGED from mtk-0078.

Deviation from the MediaTek original: free the skb when rejecting an
unsupported bandwidth in the VHT OMN update path instead of leaking
it.

Signed-off-by: Allen Ye <allen.ye@mediatek.com>
---
 mt7996/mac.c |   10 +++++++---
 mt7996/mcu.c |   52 ++++++++++++++++++++++++++++++++++++++++------------
 mt7996/mcu.h |    1 +
 3 files changed, 48 insertions(+), 15 deletions(-)

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2874,9 +2874,13 @@ void mt7996_mac_sta_rc_work(struct work_
 
 		spin_unlock_bh(&dev->mt76.sta_poll_lock);
 
-		if (changed & (IEEE80211_RC_SUPP_RATES_CHANGED |
-			       IEEE80211_RC_NSS_CHANGED |
-			       IEEE80211_RC_BW_CHANGED))
+		if (changed & IEEE80211_RC_VHT_OMN_CHANGED)
+			mt7996_mcu_set_fixed_field(dev, msta_link->sta, NULL,
+						   msta_link->wcid.link_id,
+						   RATE_PARAM_VHT_OMN_UPDATE);
+		else if (changed & (IEEE80211_RC_SUPP_RATES_CHANGED |
+				    IEEE80211_RC_NSS_CHANGED |
+				    IEEE80211_RC_BW_CHANGED))
 			mt7996_mcu_add_rate_ctrl(dev, msta_link->sta, vif,
 						 msta_link->wcid.link_id,
 						 true);
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -2567,7 +2567,9 @@ int mt7996_mcu_set_fixed_field(struct mt
 	struct mt7996_sta_link *msta_link;
 	struct sta_rec_ra_fixed_uni *ra;
 	struct sta_phy_uni *phy = data;
+	struct ieee80211_link_sta *link_sta;
 	struct mt76_vif_link *mlink;
+	struct ieee80211_sta *sta;
 	struct sk_buff *skb;
 	int err = -ENODEV;
 	struct tlv *tlv;
@@ -2582,6 +2584,11 @@ int mt7996_mcu_set_fixed_field(struct mt
 	if (!msta_link)
 		goto error_unlock;
 
+	sta = wcid_to_sta(&msta_link->wcid);
+	link_sta = rcu_dereference(sta->link[link_id]);
+	if (!link_sta)
+		goto error_unlock;
+
 	skb = __mt76_connac_mcu_alloc_sta_req(&dev->mt76, mlink,
 					      &msta_link->wcid,
 					      MT7996_STA_UPDATE_MAX_SIZE);
@@ -2603,19 +2610,35 @@ int mt7996_mcu_set_fixed_field(struct mt
 		if (phy)
 			ra->phy = *phy;
 		break;
-	case RATE_PARAM_MMPS_UPDATE: {
-		struct ieee80211_sta *sta = wcid_to_sta(&msta_link->wcid);
-		struct ieee80211_link_sta *link_sta;
-
-		link_sta = rcu_dereference(sta->link[link_id]);
-		if (!link_sta) {
+	case RATE_PARAM_MMPS_UPDATE:
+		ra->mmps_mode = mt7996_mcu_get_mmps_mode(link_sta->smps_mode);
+		break;
+	case RATE_PARAM_VHT_OMN_UPDATE:
+		ra->op_mode = true;
+		switch (link_sta->bandwidth) {
+		case IEEE80211_STA_RX_BW_20:
+			ra->op_vht_chan_width =
+				IEEE80211_OPMODE_NOTIF_CHANWIDTH_20MHZ;
+			break;
+		case IEEE80211_STA_RX_BW_40:
+			ra->op_vht_chan_width =
+				IEEE80211_OPMODE_NOTIF_CHANWIDTH_40MHZ;
+			break;
+		case IEEE80211_STA_RX_BW_80:
+			ra->op_vht_chan_width =
+				IEEE80211_OPMODE_NOTIF_CHANWIDTH_80MHZ;
+			break;
+		case IEEE80211_STA_RX_BW_160:
+			ra->op_vht_chan_width =
+				IEEE80211_OPMODE_NOTIF_CHANWIDTH_160MHZ;
+			break;
+		default:
 			dev_kfree_skb(skb);
+			err = -EINVAL;
 			goto error_unlock;
 		}
-
-		ra->mmps_mode = mt7996_mcu_get_mmps_mode(link_sta->smps_mode);
+		ra->op_vht_rx_nss = link_sta->rx_nss ? link_sta->rx_nss - 1 : 0;
 		break;
-	}
 	default:
 		break;
 	}
@@ -2761,9 +2784,11 @@ mt7996_mcu_sta_rate_ctrl_tlv(struct sk_b
 			     struct mt7996_vif_link *link)
 {
 #define INIT_RCPI 180
+	enum ieee80211_sta_rx_bandwidth cap_bw = ieee80211_link_sta_cap_bw(link_sta);
 	struct mt76_phy *mphy = mt76_vif_link_phy(&link->mt76);
 	struct cfg80211_bitrate_mask *mask = &link->bitrate_mask;
 	u32 cap = link_sta->sta->wme ? STA_CAP_WMM : 0;
+	u8 cap_nss = ieee80211_link_sta_cap_nss(link_sta);
 	struct cfg80211_chan_def *chandef;
 	struct sta_rec_ra_uni *ra;
 	enum nl80211_band band;
@@ -2784,10 +2809,13 @@ mt7996_mcu_sta_rate_ctrl_tlv(struct sk_b
 	ra->auto_rate = true;
 	ra->phy_mode = mt76_connac_get_phy_mode(mphy, vif, band, link_sta);
 	ra->channel = chandef->chan->hw_value;
-	ra->bw = (link_sta->bandwidth == IEEE80211_STA_RX_BW_320) ?
-		 CMD_CBW_320MHZ : link_sta->bandwidth;
-	ra->phy.bw = ra->bw;
+	ra->bw = mt76_connac_chan_bw(chandef);
+	ra->phy.bw = (cap_bw == IEEE80211_STA_RX_BW_320) ? CMD_CBW_320MHZ : cap_bw;
 	ra->mmps_mode = mt7996_mcu_get_mmps_mode(link_sta->smps_mode);
+	ra->op_mode = cap_bw != link_sta->bandwidth || cap_nss != link_sta->rx_nss;
+	ra->op_vht_chan_width = link_sta->bandwidth;
+	ra->op_vht_rx_nss = link_sta->rx_nss ? link_sta->rx_nss - 1 : 0;
+	ra->op_vht_rx_nss_type = 0;
 
 	if (supp_rate) {
 		supp_rate &= mask->control[band].legacy;
--- a/mt7996/mcu.h
+++ b/mt7996/mcu.h
@@ -954,6 +954,7 @@ enum {
 };
 
 enum {
+	RATE_PARAM_VHT_OMN_UPDATE = 1,
 	RATE_PARAM_FIXED = 3,
 	RATE_PARAM_MMPS_UPDATE = 5,
 	RATE_PARAM_FIXED_HE_LTF = 7,
