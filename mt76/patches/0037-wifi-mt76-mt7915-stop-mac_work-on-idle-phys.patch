From: Chad Monroe <chad@monroe.io>
Date: Tue, 29 Sep 2026 06:09:47 -0700
Subject: [PATCH] wifi: mt76: mt7915: stop mac_work on idle phys

A reset queues the MAC work on both phys, and the work queues itself
again every 100 ms. The stop callback cancels it only for a hw that
mac80211 started, so a second band with no interface polls its
counters forever. At removal, that work sits in the memory that the
second hw frees, with its timer still armed.

The work now ends on a phy that is not running. Removal first stops
the MCU interrupt from queueing a reset, then cancels the work on
both phys before the second hw goes away. A reset that runs during
removal keeps its wakeups, and later MCU commands fail at once
instead of timing out into a full restart.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7915/init.c |   12 ++++++++++++
 mt7915/mac.c  |   20 ++++++++++++++++++++
 2 files changed, 32 insertions(+)

--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -1372,9 +1372,21 @@ free_phy2:
 
 void mt7915_unregister_device(struct mt7915_dev *dev)
 {
+	struct mt76_phy *mphy_ext = dev->mt76.phys[MT_BAND1];
+
+	/* stop the MCU interrupt from queueing a reset, which would queue
+	 * mac_work again after the cancel below
+	 */
+	set_bit(MT76_REMOVED, &dev->mphy.state);
+	tasklet_disable(&dev->mt76.irq_tasklet);
+	tasklet_enable(&dev->mt76.irq_tasklet);
+
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->reset_work);
 	cancel_work_sync(&dev->rc_work);
+	cancel_delayed_work_sync(&dev->mphy.mac_work);
+	if (mphy_ext)
+		cancel_delayed_work_sync(&mphy_ext->mac_work);
 	mt7915_unregister_ext_phy(dev);
 	mt7915_coredump_unregister(dev);
 	mt7915_unregister_thermal(&dev->phy);
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1486,6 +1486,9 @@ void mt7915_mac_reset_work(struct work_s
 	int i;
 
 	dev = container_of(work, struct mt7915_dev, reset_work);
+	if (test_bit(MT76_REMOVED, &dev->mphy.state))
+		return;
+
 	ext_phy = dev->mt76.phys[MT_BAND1];
 	phy2 = ext_phy ? ext_phy->priv : NULL;
 
@@ -1675,6 +1678,16 @@ void mt7915_reset(struct mt7915_dev *dev
 	if (!dev->recovery.hw_init_done)
 		return;
 
+	/* a reset that runs still needs its wakeups, and later MCU commands
+	 * must fail at once instead of timing out into a full restart
+	 */
+	if (test_bit(MT76_REMOVED, &dev->mphy.state)) {
+		set_bit(MT76_MCU_RESET, &dev->mphy.state);
+		wake_up(&dev->mt76.mcu.wait);
+		wake_up(&dev->reset_wait);
+		return;
+	}
+
 	if (dev->recovery.hw_full_reset)
 		return;
 
@@ -2033,6 +2046,13 @@ void mt7915_mac_work(struct work_struct
 					       mac_work.work);
 	phy = mphy->priv;
 
+	/* a reset queues this work on both phys without a test of the phy
+	 * state, and removal must not run it again
+	 */
+	if (!test_bit(MT76_STATE_RUNNING, &mphy->state) ||
+	    test_bit(MT76_REMOVED, &mphy->dev->phy.state))
+		return;
+
 	mutex_lock(&mphy->dev->mutex);
 
 	mt76_update_survey(mphy);
