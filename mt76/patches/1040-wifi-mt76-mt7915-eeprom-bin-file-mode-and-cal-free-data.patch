 static inline int
 mt7915_get_channel_group_5g(int channel, bool is_7976)
 {
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -324,8 +324,11 @@ struct mt7915_dev {
 	u32 hw_pattern;
 	u32 ple1_sts;
 
