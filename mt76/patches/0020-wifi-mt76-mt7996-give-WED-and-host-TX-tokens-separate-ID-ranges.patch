From: Chad Monroe <chad@monroe.io>
Date: Fri, 30 Oct 2026 21:07:06 -0700
Subject: [PATCH] wifi: mt76: mt7996: give WED and host TX tokens separate
 ID ranges

WED and host share one 16384-token ID space: WED takes IDs 8192 to
16383 and the host pool shrinks to 8192 tokens at the first offloaded
flow. A firmware TX free event carries a 15-bit MSDU ID, so the ID
space holds 32767 tokens, and the WED buffer manager already holds
32768 packet buffers.

WED takes IDs 0 to 16383 and the host takes IDs 16384 to 31743. Host
pool size is the same with and without offload, so no token drains at
the first offloaded flow. A token counts as a WED token only inside
the WED range, because a host range above it cannot overlap it. A host
range below the WED range, as on mt7915, still shrinks at offload
start.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7996/mmio.c   |   11 ++++++++---
 mt7996/mt7996.h |    2 ++
 tx.c            |   17 +++++++++++++----
 wed.c           |    4 +++-
 4 files changed, 26 insertions(+), 8 deletions(-)

--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -601,8 +601,8 @@ int mt7996_mmio_wed_init(struct mt7996_d
 			wed->wlan.id = 0x7992;
 	}
 
-	wed->wlan.nbuf = MT7996_HW_TOKEN_SIZE;
-	wed->wlan.token_start = MT7996_TOKEN_SIZE - wed->wlan.nbuf;
+	wed->wlan.nbuf = MT7996_WED_TOKEN_SIZE;
+	wed->wlan.token_start = 0;
 	wed->wlan.hif2 = hif2;
 
 	wed->wlan.amsdu_max_subframes = 8;
@@ -622,6 +622,11 @@ int mt7996_mmio_wed_init(struct mt7996_d
 	if (mtk_wed_device_attach(wed))
 		return 0;
 
+	/* the host range follows the WED range, so the host pool keeps its
+	 * size when the first flow offloads
+	 */
+	dev->mt76.token_start = wed->wlan.nbuf;
+
 	if (!hif2) {
 		dev->mt76.hwrro_mode = is_mt7996(&dev->mt76) ? MT76_HWRRO_V3
 							     : MT76_HWRRO_V3_1;
@@ -841,7 +846,7 @@ struct mt7996_dev *mt7996_mmio_probe(str
 		.survey_flags = SURVEY_INFO_TIME_TX |
 				SURVEY_INFO_TIME_RX |
 				SURVEY_INFO_TIME_BSS_RX,
-		.token_size = MT7996_TOKEN_SIZE,
+		.token_size = MT7996_SW_TOKEN_SIZE,
 		.tx_prepare_skb = mt7996_tx_prepare_skb,
 		.tx_complete_skb = mt76_connac_tx_complete_skb,
 		.rx_skb = mt7996_queue_rx_skb,
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -94,6 +94,8 @@
 #define MT7996_EXT_EEPROM_BLOCK_SIZE	1024
 #define MT7996_TOKEN_SIZE		16384
 #define MT7996_HW_TOKEN_SIZE		8192
+#define MT7996_WED_TOKEN_SIZE		16384
+#define MT7996_SW_TOKEN_SIZE		15360
 
 #define MT7996_CFEND_RATE_DEFAULT	0x49	/* OFDM 24M */
 #define MT7996_CFEND_RATE_11B		0x03	/* 11B LP, 11M */
--- a/tx.c
+++ b/tx.c
@@ -969,6 +969,17 @@ void __mt76_set_tx_blocked(struct mt76_d
 }
 EXPORT_SYMBOL_GPL(__mt76_set_tx_blocked);
 
+#ifdef CONFIG_NET_MEDIATEK_SOC_WED
+static bool mt76_token_in_wed_range(struct mt76_dev *dev, int token)
+{
+	struct mtk_wed_device *wed = &dev->mmio.wed;
+
+	return mtk_wed_device_active(wed) &&
+	       token >= wed->wlan.token_start &&
+	       token < wed->wlan.token_start + wed->wlan.nbuf;
+}
+#endif
+
 int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi)
 {
 	int token;
@@ -988,8 +999,7 @@ int mt76_token_consume(struct mt76_dev *
 	}
 
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
-	if (mtk_wed_device_active(&dev->mmio.wed) &&
-	    token >= dev->mmio.wed.wlan.token_start)
+	if (mt76_token_in_wed_range(dev, token))
 		dev->wed_token_count++;
 #endif
 
@@ -1038,8 +1048,7 @@ mt76_token_release(struct mt76_dev *dev,
 		}
 
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
-		if (mtk_wed_device_active(&dev->mmio.wed) &&
-		    token >= dev->mmio.wed.wlan.token_start &&
+		if (mt76_token_in_wed_range(dev, token) &&
 		    --dev->wed_token_count == 0)
 			wake_up(&dev->tx_wait);
 #endif
--- a/wed.c
+++ b/wed.c
@@ -106,7 +106,9 @@ int mt76_wed_offload_enable(struct mtk_w
 	struct mt76_dev *dev = mt76_wed_to_dev(wed);
 
 	spin_lock_bh(&dev->token_lock);
-	dev->token_size = wed->wlan.token_start;
+	/* only a host range that starts below the WED range overlaps it */
+	if (!dev->token_start)
+		dev->token_size = wed->wlan.token_start;
 	spin_unlock_bh(&dev->token_lock);
 
 	return !wait_event_timeout(dev->tx_wait, !dev->wed_token_count, HZ);
