+static int
+mt7996_reg_get(void *data, u64 *val)
+{
+	struct mt76_dev *mdev = data;
+	struct mt7996_dev *dev = container_of(mdev, struct mt7996_dev, mt76);
+	u32 reg = READ_ONCE(mdev->debugfs_reg);
+
+	if (!mt7996_reg_is_accessible(dev, reg))
+		return -ENODEV;
+
+	*val = mt76_rr(dev, reg);
+	return 0;
+}
+
+static int
+mt7996_reg_set(void *data, u64 val)
+{
+	struct mt76_dev *mdev = data;
+	struct mt7996_dev *dev = container_of(mdev, struct mt7996_dev, mt76);
+
+	/* a write to a window that stays accessible can change the ownership
+	 * or the DMA state behind the driver
+	 */
+	if (mt7996_chip_is_off(dev))
+		return -ENODEV;
+
+	mt76_wr(dev, mdev->debugfs_reg, val);
+	return 0;
+}
