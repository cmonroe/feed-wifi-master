+static void
+mt7996_chip_quiesce(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int i;
+
+	WRITE_ONCE(dev->power.quiesced, true);
+
+	tasklet_disable(&mdev->irq_tasklet);
+	tasklet_enable(&mdev->irq_tasklet);
+
+	/* a balanced disable waits for a poll in flight; the NAPIs stay
+	 * enabled because the removal path disables each one without a check
+	 */
+	for (i = 0; i < ARRAY_SIZE(mdev->napi); i++) {
+		if (!mdev->napi[i].dev)
+			continue;
+
+		napi_disable(&mdev->napi[i]);
+		napi_enable(&mdev->napi[i]);
+	}
+	napi_disable(&mdev->tx_napi);
+	napi_enable(&mdev->tx_napi);
+
+	/* a drained NPU poll enables its interrupt again */
+	mt76_npu_disable_irqs(mdev);
+
+	dev->power.irqmask = mdev->mmio.irqmask;
+	mt7996_irq_disable(dev, ~0);
+	if (dev->hif2)
+		mt76_wr(dev, MT_INT1_MASK_CSR, 0);
+
+	if (dev_is_pci(mdev->dev)) {
+		mt76_wr(dev, MT_PCIE_MAC_INT_ENABLE, 0);
+		if (dev->hif2)
+			mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0);
+	}
+
+	if (mtk_wed_device_active(&mdev->mmio.wed_hif2))
+		mtk_wed_device_irq_set_mask(&mdev->mmio.wed_hif2, 0);
+}
+
+static void
+mt7996_chip_stop(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+
+	/* the WED PCIe poll of the chip runs until it is paused, and a poll
+	 * of a chip under firmware own times out; the quiesce needs no
+	 * interrupt
+	 */
+	mt7996_wed_poll_set(dev, false);
+	mt7996_chip_quiesce(dev);
+
+	mt7996_wed_stop(dev);
+	mt7996_dma_stop(dev);
+	skb_queue_purge(&mdev->mcu.res_q);
+	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+}
+
+static bool
+mt7996_chip_power_off_allowed(struct mt7996_dev *dev)
+{
+	struct mt7996_phy *phy;
+
+	if (dev->recovery.restart || dev->recovery.hw_full_reset ||
+	    test_bit(MT76_MCU_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_STATE_WED_RESET, &dev->mphy.state))
+		return false;
+
+	mt7996_for_each_phy(dev, phy) {
+		if (test_bit(MT76_STATE_RUNNING, &phy->mt76->state))
+			return false;
+	}
+
+	return true;
+}
+
+static int
+mt7996_chip_power_off(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int ret;
+
+	lockdep_assert_held(&mdev->mutex);
+
+	if (!mt7996_chip_power_off_allowed(dev))
+		return -EBUSY;
+
+	WRITE_ONCE(dev->power.owner, current);
+	set_bit(MT76_STATE_POWER_OFF, &dev->mphy.state);
+
+	/* an ethernet reset that set its bit before the fence closed has
+	 * sent its SER trigger, or sends it before the fence is visible
+	 */
+	smp_mb__after_atomic();
+	if (test_bit(MT76_STATE_WED_RESET, &dev->mphy.state)) {
+		clear_bit(MT76_STATE_POWER_OFF, &dev->mphy.state);
+		WRITE_ONCE(dev->power.owner, NULL);
+		return -EBUSY;
+	}
+
+	/* a register access that passed the fence completes before the
+	 * firmware own hand-over
+	 */
+	synchronize_rcu();
+
+	ret = __mt7996_npu_hw_stop(dev);
+	if (ret)
+		goto fail;
+
+	/* interrupts stay enabled, so that a command of another task that
+	 * holds the MCU mutex completes before the power off command
+	 */
+	ret = mt7996_mcu_power_off(dev);
+	if (ret)
+		goto fail;
+
+	mt7996_chip_stop(dev);
+	WRITE_ONCE(dev->power.owner, NULL);
+
+	dev_info(mdev->dev, "chip powered off\n");
+
+	return 0;
+
+fail:
+	clear_bit(MT76_STATE_POWER_OFF, &dev->mphy.state);
+	WRITE_ONCE(dev->power.owner, NULL);
+	dev_err(mdev->dev, "chip power off failed: %d\n", ret);
+
+	/* the firmware and the NPU state are unknown after a failed command */
+	dev->recovery.restart = true;
+	queue_work(mdev->wq, &dev->reset_work);
+
+	return ret;
+}
+
+static int
+__mt7996_chip_power_on(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int i, ret;
+
+	/* under firmware own the chip answers no register read, and the
+	 * restart starts with reads
+	 */
+	ret = mt7996_mcu_driver_own(dev);
+	if (ret)
+		return ret;
+
+	dev->recovery.hw_full_reset = true;
+	mt76_set_irq_mask(mdev, 0, ~0, dev->power.irqmask);
+	WRITE_ONCE(dev->power.quiesced, false);
+
+	for (i = 0; i < 3; i++) {
+		ret = mt7996_mac_restart(dev);
+		if (!ret)
+			break;
+	}
+	dev->recovery.hw_full_reset = false;
+
+	if (ret) {
+		/* the firmware may run after a partial restart, and the removal
+		 * path skips the power off of a chip that is marked off; the
+		 * reset bit of a timed out command blocks the power off command
+		 */
+		clear_bit(MT76_MCU_RESET, &dev->mphy.state);
+		if (mt7996_mcu_power_off(dev))
+			dev_err(mdev->dev, "no firmware power off after the failed power on\n");
+		mt7996_chip_stop(dev);
+		return ret;
+	}
+
+	/* no vif or station exists, and the global wcid keeps index 0,
+	 * because an allocation without the mask reset of the full reset
+	 * would move it
+	 */
+	mt7996_mac_restart_state_reset(dev);
+
+	/* an LED change while the chip is off only stores its state; the
+	 * barrier pairs with the one of the LED callback
+	 */
+	clear_bit(MT76_STATE_POWER_OFF, &dev->mphy.state);
+	smp_mb__after_atomic();
+	mt7996_led_apply(&dev->phy);
+
+	return 0;
+}
+
+int mt7996_chip_power_on(struct mt7996_dev *dev)
+{
+	struct mt76_dev *mdev = &dev->mt76;
+	int ret;
+
+	lockdep_assert_held(&mdev->mutex);
+
+	if (!mt7996_chip_is_off(dev))
+		return 0;
+
+	WRITE_ONCE(dev->power.owner, current);
+	ret = __mt7996_chip_power_on(dev);
+	WRITE_ONCE(dev->power.owner, NULL);
+
+	if (ret)
+		dev_err(mdev->dev, "chip power on failed: %d\n", ret);
+	else
+		dev_info(mdev->dev, "chip powered on\n");
+
+	return ret;
+}
+
+static bool
+mt7996_chip_power_off_wanted(struct mt7996_dev *dev)
+{
+	return !dev->power.started && !mt7996_chip_is_off(dev) &&
+	       !test_bit(MT76_REMOVED, &dev->mphy.state) &&
+	       dev->power.retries < MT7996_CHIP_POWER_OFF_RETRY_LIMIT;
+}
+
+static void
+mt7996_chip_power_off_try(struct mt7996_dev *dev)
+{
+	int ret;
+
+	if (!mt7996_chip_power_off_wanted(dev))
+		return;
+
+	ret = mt7996_chip_power_off(dev);
+	if (!ret) {
+		dev->power.retries = 0;
+		return;
+	}
+
+	/* a stale reset bit refuses every try, and a firmware that fails
+	 * the power off would otherwise run a full reset without end
+	 */
+	if (++dev->power.retries == MT7996_CHIP_POWER_OFF_RETRY_LIMIT) {
+		dev_warn(dev->mt76.dev, "chip power off gave up after %u tries\n",
+			 dev->power.retries);
+		return;
+	}
+
+	queue_delayed_work(dev->mt76.wq, &dev->power.work,
+			   MT7996_CHIP_POWER_OFF_DELAY);
+}
+
+void mt7996_chip_power_off_work(struct work_struct *work)
+{
+	struct mt7996_dev *dev = container_of(work, struct mt7996_dev,
+					      power.work.work);
+	struct ieee80211_hw *hw = mt76_hw(dev);
+	struct mt7996_phy *phy;
+	bool wanted;
+
+	/* the cancels take the mutex, and a refused power off would leave
+	 * the cancelled work of a running radio unqueued
+	 */
+	mutex_lock(&dev->mt76.mutex);
+	wanted = mt7996_chip_power_off_wanted(dev);
+	mutex_unlock(&dev->mt76.mutex);
+	if (!wanted)
+		return;
+
+	mt7996_for_each_phy(dev, phy)
+		cancel_delayed_work_sync(&phy->mt76->mac_work);
+	cancel_work_sync(&dev->rc_work);
+	cancel_work_sync(&dev->wed_rro.work);
+
+	mutex_lock(&dev->mt76.mutex);
+
+	mt7996_chip_power_off_try(dev);
+
+	/* a refused power off leaves the phys that run without mac_work */
+	mt7996_for_each_phy(dev, phy) {
+		if (test_bit(MT76_STATE_RUNNING, &phy->mt76->state))
+			ieee80211_queue_delayed_work(hw, &phy->mt76->mac_work,
+						     MT7996_WATCHDOG_TIME);
+	}
+
+	mutex_unlock(&dev->mt76.mutex);
+}
+
 /* firmware coredump */
 void mt7996_mac_dump_work(struct work_struct *work)
 {
@@ -2953,7 +3252,7 @@ void mt7996_reset(struct mt7996_dev *dev
 		return;
 	}
 
-	if (dev->recovery.hw_full_reset)
+	if (dev->recovery.hw_full_reset || mt7996_chip_is_off(dev))
 		return;
 
 	/* wm/wa exception: do full recovery */
