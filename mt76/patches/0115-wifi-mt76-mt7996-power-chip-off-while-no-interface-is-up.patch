+static bool mt7996_reg_in_allowed_window(u32 offset)
+{
+	/* the WFDMA and conn_host_csr_top (LPCR, MISC) windows of the
+	 * register map stay accessible after the firmware power off
+	 */
+	if (offset >= 0xd0000 && offset < 0xf0000)
+		return true;
+
+	return (offset & ~0xfff) == MT_PCIE_MAC_BASE ||
+	       (offset & ~0xfff) == MT_PCIE1_MAC_BASE;
+}
+
+bool mt7996_reg_is_accessible(struct mt7996_dev *dev, u32 offset)
+{
+	return !mt7996_chip_is_off(dev) ||
+	       mt7996_reg_in_allowed_window(offset);
+}
+
+static bool mt7996_reg_is_fenced(struct mt7996_dev *dev, u32 offset)
+{
+	if (!mt7996_chip_is_fenced(dev) ||
+	    mt7996_reg_in_allowed_window(offset))
+		return false;
+
+	WARN_ONCE(1, "mt7996: register 0x%08x accessed while the chip is off\n",
+		  offset);
+
+	return true;
+}
