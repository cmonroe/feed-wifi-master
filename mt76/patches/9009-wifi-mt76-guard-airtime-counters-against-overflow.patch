+/* The firmware samples its counters before the host reads jiffies, and
+ * jiffies count whole ticks, so allow one tick more than measured.
+ */
+static inline u32
+mt76_poll_elapsed_us(unsigned long *last_poll)
+{
+	unsigned long now = jiffies;
+	u32 elapsed_us = jiffies_to_usecs(now - *last_poll + 1);
+
+	*last_poll = now;
+
+	return elapsed_us;
+}
+
+/* One all-station report can span several events. Every event of the
+ * report measures from the end of the previous report, and only the
+ * last event (no more flag) ends the report. The delay from the
+ * firmware sample to the event differs between reports, so the bound
+ * adds @margin_jiffies. The bound only has to reject wrapped or garbage
+ * counter values.
+ */
+static inline u32
+mt76_airtime_interval_us(struct mt76_dev *dev, bool more,
+			 unsigned long margin_jiffies)
+{
+	unsigned long now = jiffies;
+	u32 elapsed_us = jiffies_to_usecs(now - dev->airtime_last_poll +
+					  margin_jiffies);
+
+	if (!more)
+		dev->airtime_last_poll = now;
+
+	return elapsed_us;
+}
+
+static inline u32
+mt76_airtime_delta(u32 cur, u32 prev, u32 max_us)
+{
+	u32 diff = cur >= prev ? cur - prev : cur;
+
+	return min(diff, max_us);
+}
+
+static inline u32
+mt76_airtime_clamp(u32 val, u32 max_us)
+{
+	return min(val, max_us);
+}
+
+static inline u64
+mt76_chan_mib_delta(u64 cur, u64 prev, u32 max_us)
+{
+	if (cur < prev)
+		return 0;
+
+	return min_t(u64, cur - prev, max_us);
+}
