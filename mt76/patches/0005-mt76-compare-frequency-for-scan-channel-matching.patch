From: Chad Monroe <chad@monroe.io>
Date: Sat, 31 Jan 2026 17:06:58 -0800
Subject: [PATCH] mt76: compare frequency for scan channel matching

Channel objects from the scan request, RX path, and phy chandef may be
different allocations for the same frequency. Use frequency comparison
instead of pointer comparison.

Always call mt76_set_channel to keep phy->chandef current, since the RX
path uses it for beacon frequency matching. Preserve main_chandef when
scanning the operating channel to maintain proper bandwidth.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 scan.c |    5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

--- a/scan.c
+++ b/scan.c
@@ -84,7 +84,7 @@ void mt76_scan_rx_beacon(struct mt76_dev
 	struct mt76_phy *phy;
 
 	if (!dev->scan.beacon_wait || dev->scan.beacon_received ||
-	    dev->scan.chan != chan)
+	    !dev->scan.chan || dev->scan.chan->center_freq != chan->center_freq)
 		return;
 
 	phy = dev->scan.phy;
@@ -128,9 +128,14 @@ void mt76_scan_work(struct work_struct *
 	}
 
 	dev->scan.chan = req->channels[dev->scan.chan_idx++];
-	cfg80211_chandef_create(&chandef, dev->scan.chan, NL80211_CHAN_HT20);
-	if (dev->scan.chan != phy->main_chandef.chan)
+	if (phy->main_chandef.chan &&
+	    phy->main_chandef.chan->center_freq == dev->scan.chan->center_freq) {
+		chandef = phy->main_chandef;
+		mt76_set_channel(phy, &chandef, false);
+	} else {
+		cfg80211_chandef_create(&chandef, dev->scan.chan, NL80211_CHAN_HT20);
 		mt76_set_channel(phy, &chandef, true);
+	}
 
 	if (!req->n_ssids)
 		goto out;
