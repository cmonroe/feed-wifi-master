 			    const struct pci_device_id *id)
 {
@@ -198,6 +321,10 @@ static int mt7996_pci_probe(struct pci_d
 		mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0xff);
 	}
 
+	ret = mt7996_pci_state_store(dev);
+	if (ret)
+		goto free_hif2_irq;
+
 	ret = mt7996_register_device(dev);
 	if (ret)
 		goto free_hif2_irq;
@@ -238,13 +365,15 @@ static void mt7996_hif_remove(struct pci
 
