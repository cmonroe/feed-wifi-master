--- a/mt7996/pci.c
+++ b/mt7996/pci.c
@@ -102,6 +102,129 @@ static int mt7996_pci_hif2_probe(struct
 	return 0;
 }
 
+/* the cascade kernel defines this export; a lookup at run time lets the
+ * module load on a kernel without it
+ */
+int mtk_pcie_wifi_module_reset(struct pci_dev **pdevs, unsigned int count);
+
+static unsigned int mt7996_pci_devs_get(struct mt7996_dev *dev,
+					struct pci_dev **pdevs)
+{
+	unsigned int count = 0;
+
+	pdevs[count++] = to_pci_dev(dev->mt76.dev);
+	if (dev->hif2)
+		pdevs[count++] = to_pci_dev(dev->hif2->dev);
+
+	return count;
+}
+
+static void mt7996_pci_state_release(void *state)
+{
+	kfree(state);
+}
+
+/* a module reset clears the config space of each function, and a function
+ * that does not answer cannot give its config later
+ */
+static int mt7996_pci_state_store(struct mt7996_dev *dev)
+{
+	struct pci_dev *pdevs[ARRAY_SIZE(dev->pci_state)];
+	unsigned int i, count;
+
+	count = mt7996_pci_devs_get(dev, pdevs);
+	for (i = 0; i < count; i++) {
+		struct pci_saved_state *state;
+		int ret;
+
+		if (pci_save_state(pdevs[i]))
+			return -ENOMEM;
+
+		state = pci_store_saved_state(pdevs[i]);
+		if (!state)
+			return -ENOMEM;
+
+		ret = devm_add_action_or_reset(dev->mt76.dev,
+					       mt7996_pci_state_release, state);
+		if (ret)
+			return ret;
+
+		dev->pci_state[i] = state;
+	}
+
+	return 0;
+}
+
+static int mt7996_pci_chip_reset_absent(struct mt7996_dev *dev, int ret)
+{
+	dev_info(dev->mt76.dev, "no WiFi module reset (%d), WFSYS reset only\n",
+		 ret);
+	dev->module_reset_absent = true;
+
+	return -EOPNOTSUPP;
+}
+
+int mt7996_pci_chip_reset(struct mt7996_dev *dev)
+{
+	int (*module_reset)(struct pci_dev **pdevs, unsigned int count);
+	bool hung = atomic_read(&dev->mt76.bus_hung);
+	struct pci_dev *pdevs[ARRAY_SIZE(dev->pci_state)];
+	unsigned int i, count;
+	int ret = 0;
+
+	if (dev->module_reset_absent || !dev_is_pci(dev->mt76.dev))
+		return -EOPNOTSUPP;
+
+	module_reset = symbol_get(mtk_pcie_wifi_module_reset);
+	if (!module_reset)
+		return mt7996_pci_chip_reset_absent(dev, -ENOENT);
+
+	count = mt7996_pci_devs_get(dev, pdevs);
+	for (i = 0; i < count && !ret; i++)
+		ret = pci_load_saved_state(pdevs[i], dev->pci_state[i]);
+	if (ret) {
+		symbol_put(mtk_pcie_wifi_module_reset);
+		return mt7996_pci_chip_reset_absent(dev, ret);
+	}
+
+	/* the link goes down, and the core refuses MCU commands while the
+	 * bus is hung
+	 */
+	atomic_set(&dev->mt76.bus_hung, true);
+	synchronize_rcu();
+
+	ret = module_reset(pdevs, count);
+	symbol_put(mtk_pcie_wifi_module_reset);
+
+	switch (ret) {
+	case 0:
+		break;
+	case -ENODEV:
+	case -EOPNOTSUPP:
+	case -EINVAL:
+		/* the export returns these before it touches the hardware */
+		atomic_set(&dev->mt76.bus_hung, false);
+		return mt7996_pci_chip_reset_absent(dev, ret);
+	case -EBUSY:
+		/* another config access lock holds the root port, and the link
+		 * keeps its state
+		 */
+		atomic_set(&dev->mt76.bus_hung, hung);
+		dev_warn(dev->mt76.dev, "WiFi module reset busy\n");
+		return ret;
+	default:
+		/* the link may stay down, so no access may reach the chip
+		 * until a later reset succeeds
+		 */
+		dev_err(dev->mt76.dev, "WiFi module reset failed: %d\n", ret);
+		return ret;
+	}
+
+	atomic_set(&dev->mt76.bus_hung, false);
+
+	return 0;
+}
+
