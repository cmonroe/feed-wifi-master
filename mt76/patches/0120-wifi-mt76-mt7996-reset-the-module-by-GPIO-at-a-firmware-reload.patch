 	if (ret)
@@ -2539,6 +2553,23 @@ __mt7996_mac_restart_hw(struct mt7996_de
 	return 0;
 }
 
+static void mt7996_chip_mark_off(struct mt7996_dev *dev);
+
+/* the TX path kicks rings outside the register fence, so the phys of a
+ * chip without a link stay in reset
+ */
+static void
+mt7996_phy_reset_clear(struct mt7996_dev *dev)
+{
+	struct mt7996_phy *phy;
+
+	if (mt76_bus_is_hung(&dev->mt76))
+		return;
+
+	mt7996_for_each_phy(dev, phy)
+		clear_bit(MT76_RESET, &phy->mt76->state);
+}
+
 static int
 mt7996_mac_restart(struct mt7996_dev *dev)
 {
@@ -2560,8 +2591,7 @@ mt7996_mac_restart(struct mt7996_dev *de
 
 out:
 	/* reset done */
-	mt7996_for_each_phy(dev, phy)
-		clear_bit(MT76_RESET, &phy->mt76->state);
+	mt7996_phy_reset_clear(dev);
 
 	mt76_worker_enable(&dev->mt76.tx_worker);
 	return ret;
@@ -2680,6 +2710,18 @@ mt7996_mac_full_reset(struct mt7996_dev
 	dev->mt76.global_wcid.idx = i;
 	dev->recovery.hw_full_reset = false;
 
+	/* the restart of mac80211 then powers the chip on, and that power-on
+	 * resets the module again; with a link, an LED change during the
+	 * module reset only stored its state, and the barrier pairs with the
+	 * one of the LED callback
+	 */
+	if (mt76_bus_is_hung(&dev->mt76)) {
+		mt7996_chip_mark_off(dev);
+	} else {
+		smp_mb();
+		mt7996_led_apply(&dev->phy);
+	}
+
 	mutex_unlock(&dev->mt76.mutex);
 
 	ieee80211_wake_queues(mt76_hw(dev));
@@ -2710,8 +2752,7 @@ void mt7996_mac_reset_work(struct work_s
 		dev->recovery.restart = false;
 		dev->recovery.state = MT_MCU_CMD_NORMAL_STATE;
 		clear_bit(MT76_MCU_RESET, &dev->mphy.state);
-		mt7996_for_each_phy(dev, phy)
-			clear_bit(MT76_RESET, &phy->mt76->state);
+		mt7996_phy_reset_clear(dev);
 	}
 	mutex_unlock(&dev->mt76.mutex);
 	if (off)
@@ -2971,6 +3012,16 @@ mt7996_chip_stop(struct mt7996_dev *dev)
 	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
 }
 
+static void
+mt7996_chip_mark_off(struct mt7996_dev *dev)
+{
+	lockdep_assert_held(&dev->mt76.mutex);
+
+	set_bit(MT76_STATE_POWER_OFF, &dev->mphy.state);
+	mt7996_chip_stop(dev);
+	dev_err(dev->mt76.dev, "chip marked off, the next start resets the module\n");
+}
