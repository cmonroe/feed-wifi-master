-		last = mt76_dma_read_dma_idx(q, -1);
+		last = mt76_dma_read_dma_idx(dev, q, -1);
 
 	while (q->queued > 0 && q->tail != last) {
 		mt76_dma_tx_cleanup_idx(dev, q, q->tail, &entry);
@@ -445,7 +457,7 @@ mt76_dma_tx_cleanup(struct mt76_dev *dev
 		}
 
 		if (!flush && q->tail == last)
-			last = mt76_dma_read_dma_idx(q, -1);
+			last = mt76_dma_read_dma_idx(dev, q, -1);
 	}
 	spin_unlock_bh(&q->cleanup_lock);
 
@@ -1011,7 +1023,7 @@ mt76_dma_rx_process(struct mt76_dev *dev
 	if ((q->flags & MT_QFLAG_WED_RRO_EN) ||
 	    (IS_ENABLED(CONFIG_NET_MEDIATEK_SOC_WED) &&
 	     mt76_queue_is_wed_tx_free(q))) {
-		dma_idx = mt76_dma_read_dma_idx(q, q->tail);
+		dma_idx = mt76_dma_read_dma_idx(dev, q, q->tail);
 		check_ddone = true;
 	}
 
@@ -1021,7 +1033,7 @@ mt76_dma_rx_process(struct mt76_dev *dev
 
 		if (check_ddone) {
 			if (q->tail == dma_idx)
-				dma_idx = mt76_dma_read_dma_idx(q, q->tail);
+				dma_idx = mt76_dma_read_dma_idx(dev, q, q->tail);
 
 			if (q->tail == dma_idx)
 				break;
--- a/mcu.c
+++ b/mcu.c
@@ -83,7 +83,7 @@ int mt76_mcu_skb_send_and_get_msg(struct
 
 	mutex_lock(&dev->mcu.mutex);
 
-	if ((mt76_is_mmio(dev) && atomic_read(&dev->bus_hung)) ||
+	if (mt76_bus_is_hung(dev) ||
 	    (mt76_is_sdio(dev) && test_bit(MT76_RESET, &dev->phy.state) &&
 	    atomic_read(&dev->bus_hung))) {
