--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2444,6 +2444,18 @@ __mt7996_mac_restart_hw(struct mt7996_de
 	mt7996_tx_token_put(dev);
 	idr_init(&dev->mt76.token);
 
+	/* the queue flush of the DMA reset writes ring registers outside the
+	 * register fence, so the link must be up again before it runs
+	 */
+	ret = mt7996_pci_chip_reset(dev);
+	if (ret && ret != -EOPNOTSUPP) {
+		/* a poll reads ring registers outside the register fence, and
+		 * the next try disables the NAPIs again
+		 */
+		mt7996_napi_enable(dev, false);
+		return ret;
+	}
+
 	mt7996_dma_reset(dev, true);
 
 	/* each MCU command holds its ring entry until the TX NAPI returns it */
@@ -2464,6 +2476,8 @@ __mt7996_mac_restart_hw(struct mt7996_de
 			mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0xff);
 	}
 
