 static bool
 mt7996_chip_power_off_allowed(struct mt7996_dev *dev)
 {
@@ -3055,16 +3106,20 @@ __mt7996_chip_power_on(struct mt7996_dev
 	int i, ret;
 
 	/* under firmware own the chip answers no register read, and the
-	 * restart starts with reads
+	 * restart starts with reads; a chip that refuses driver own answers
+	 * reads after a module reset, and the firmware load takes driver own
 	 */
 	ret = mt7996_mcu_driver_own(dev);
-	if (ret)
+	if (ret && mt7996_pci_chip_reset(dev))
 		return ret;
 
 	dev->recovery.hw_full_reset = true;
 	mt76_set_irq_mask(mdev, 0, ~0, dev->power.irqmask);
 	WRITE_ONCE(dev->power.quiesced, false);
 
+	/* a chip marked off by a failed full reset keeps its running phys,
+	 * and only the restart starts their radios again
+	 */
 	for (i = 0; i < 3; i++) {
 		ret = mt7996_mac_restart(dev);
 		if (!ret)
@@ -3075,10 +3130,11 @@ __mt7996_chip_power_on(struct mt7996_dev
 	if (ret) {
 		/* the firmware may run after a partial restart, and the removal
 		 * path skips the power off of a chip that is marked off; the
-		 * reset bit of a timed out command blocks the power off command
+		 * reset bit of a timed out command blocks the power off command,
+		 * and a hung bus refuses it
 		 */
 		clear_bit(MT76_MCU_RESET, &dev->mphy.state);
-		if (mt7996_mcu_power_off(dev))
+		if (!mt76_bus_is_hung(mdev) && mt7996_mcu_power_off(dev))
 			dev_err(mdev->dev, "no firmware power off after the failed power on\n");
 		mt7996_chip_stop(dev);
 		return ret;
--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -419,12 +419,25 @@ static bool mt7996_reg_in_allowed_window
 
 bool mt7996_reg_is_accessible(struct mt7996_dev *dev, u32 offset)
 {
+	if (mt76_bus_is_hung(&dev->mt76))
+		return false;
+
 	return !mt7996_chip_is_off(dev) ||
 	       mt7996_reg_in_allowed_window(offset);
 }
 
 static bool mt7996_reg_is_fenced(struct mt7996_dev *dev, u32 offset)
 {
+	/* no owner exception: an interrupt on the owner's CPU runs as the
+	 * owner, and the module reset itself needs no register access
+	 */
+	if (mt76_bus_is_hung(&dev->mt76)) {
+		dev_warn_once(dev->mt76.dev,
+			      "register 0x%08x accessed while the PCIe link is down\n",
+			      offset);
+		return true;
+	}
+
 	if (!mt7996_chip_is_fenced(dev) ||
 	    mt7996_reg_in_allowed_window(offset))
 		return false;
