 }
 
@@ -234,10 +246,10 @@ void mt76_dma_queue_reset(struct mt76_de
 	}
 
 	mt76_dma_queue_magic_cnt_init(dev, q);
-	if (reset_idx) {
-		if (mt76_queue_is_emi(q))
-			*q->emi_cpu_idx = 0;
