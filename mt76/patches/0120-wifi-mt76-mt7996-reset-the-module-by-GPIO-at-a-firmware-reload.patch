 	mphy = container_of(led_cdev, struct mt76_phy, leds.cdev);
 	phy = mphy->priv;
 
-	/* the power on applies the stored state; the barrier orders the
-	 * store before the test, as the power on orders its bit clear
-	 * before its read of the state
+	/* the power on, or the full reset after a module reset, applies the
+	 * stored state; the barrier orders the store before the tests, as
+	 * each of them orders its state change before its read of the state
 	 */
 	phy->led.delay_on = delay_on;
 	phy->led.delay_off = delay_off;
 	phy->led.valid = true;
 	smp_mb();
 
-	if (mt7996_chip_is_off(phy->dev))
