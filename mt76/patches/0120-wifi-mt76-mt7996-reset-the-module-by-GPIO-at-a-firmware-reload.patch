+		if (!mt76_queue_is_emi(q))
 			Q_WRITE(q, cpu_idx, 0);
 		Q_WRITE(q, dma_idx, 0);
 	}
@@ -415,7 +427,7 @@ mt76_dma_kick_queue(struct mt76_dev *dev
 	wmb();
 	if (mt76_queue_is_emi(q))
 		*q->emi_cpu_idx = cpu_to_le16(q->head);
-	else
