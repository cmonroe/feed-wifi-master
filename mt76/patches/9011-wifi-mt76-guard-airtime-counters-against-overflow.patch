+++ b/mt7996/debugfs.c
@@ -1503,7 +1503,9 @@ mt7996_link_sta_info_show(struct seq_fil
 		   stats->tx_mpdus ? stats->tx_failed * 1000 / stats->tx_mpdus / 10 : 0,
 		   stats->tx_mpdus ? stats->tx_failed * 1000 / stats->tx_mpdus % 10 : 0);
 	seq_printf(file, "\t\tMPDU Retries: %u\n", stats->tx_retries);
-	seq_printf(file, "\t\tAirtime: %llu (unit: 1.024 us)\n", stats->tx_airtime);
+	seq_printf(file, "\t\tAirtime (unit: 1.024 us):\n");
+	for (ac = IEEE80211_AC_VO; ac < IEEE80211_NUM_ACS; ++ac)
+		seq_printf(file, "\t\t\t%s: %u\n", ac_to_str(ac), stats->tx_airtime[ac]);
 	seq_printf(file, "\t\tNumber of non-AQL packets: %u (Max: %u)\n",
 		   atomic_read(&wcid->non_aql_packets), MT_MAX_NON_AQL_PKT);
 	seq_printf(file, "\tRX:\n");
@@ -1514,7 +1516,9 @@ mt7996_link_sta_info_show(struct seq_fil
 	seq_printf(file, "\t\tMPDU FCS Errors: %u (PER: %u.%u%%)\n", stats->rx_fcs_err,
 		   stats->rx_mpdus ? stats->rx_fcs_err * 1000 / stats->rx_mpdus / 10 : 0,
 		   stats->rx_mpdus ? stats->rx_fcs_err * 1000 / stats->rx_mpdus % 10 : 0);
-	seq_printf(file, "\t\tAirtime: %llu (unit: 1.024 us)\n", stats->rx_airtime);
+	seq_printf(file, "\t\tAirtime (unit: 1.024 us):\n");
+	for (ac = IEEE80211_AC_VO; ac < IEEE80211_NUM_ACS; ++ac)
+		seq_printf(file, "\t\t\t%s: %u\n", ac_to_str(ac), stats->rx_airtime[ac]);
 
 	seq_printf(file, "\tWCID flags:\n");
 	for (flag = 0; flag < NUM_MT76_WCID_FLAGS; flag++) {
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -2090,11 +2090,6 @@ static void mt7996_link_sta_statistics(s
 	link_sinfo->fcs_err_count = stats->rx_fcs_err;
 	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_FCS_ERROR_COUNT);
 
-	link_sinfo->tx_duration = stats->tx_airtime;
-	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_DURATION);
-
-	link_sinfo->rx_duration = stats->rx_airtime;
-	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_RX_DURATION);
 out:
 	mutex_unlock(&dev->mt76.mutex);
 }
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -802,6 +802,7 @@ static void
 mt7996_mcu_rx_all_sta_info_event(struct mt7996_dev *dev, struct sk_buff *skb)
 {
 	struct mt7996_mcu_all_sta_info_event *res;
+	u32 elapsed_us = 0;
 	u32 elem_size;
 	u16 sta_num;
 	u16 i;
@@ -848,6 +849,13 @@ mt7996_mcu_rx_all_sta_info_event(struct
 	if (sta_num > (skb->len - sizeof(*res)) / elem_size)
 		sta_num = (skb->len - sizeof(*res)) / elem_size;
 
+	if (le16_to_cpu(res->tag) == UNI_ALL_STA_TXRX_AIR_TIME) {
+		unsigned long now = jiffies;
+
+		elapsed_us = jiffies_to_usecs(now - dev->mt76.airtime_last_poll);
+		dev->mt76.airtime_last_poll = now;
+	}
+
 	rcu_read_lock();
 	for (i = 0; i < sta_num; i++) {
 		u8 ac;
@@ -856,7 +864,7 @@ mt7996_mcu_rx_all_sta_info_event(struct
 		struct mt76_wcid *wcid;
 		struct mt76_phy *mphy;
 		struct ieee80211_sta *sta;
-		u32 tx_bytes, rx_bytes, tx_bytes_failed = 0, tx_airtime, rx_airtime,
+		u32 tx_bytes, rx_bytes, tx_bytes_failed = 0,
 		    tx_packets, rx_packets;
 
 		switch (le16_to_cpu(res->tag)) {
@@ -926,13 +934,17 @@ mt7996_mcu_rx_all_sta_info_event(struct
 
 			for (ac = IEEE80211_AC_VO; ac < IEEE80211_NUM_ACS; ++ac) {
 				u8 lmac_ac = mt76_connac_lmac_mapping(ac);
-				tx_airtime = le32_to_cpu(res->airtime[i].tx[lmac_ac]);
-				rx_airtime = le32_to_cpu(res->airtime[i].rx[lmac_ac]);
+				u32 tx = mt76_airtime_clamp(
+						le32_to_cpu(res->airtime[i].tx[lmac_ac]),
+						elapsed_us);
+				u32 rx = mt76_airtime_clamp(
+						le32_to_cpu(res->airtime[i].rx[lmac_ac]),
+						elapsed_us);
 
-				wcid->stats.tx_airtime += tx_airtime;
-				wcid->stats.rx_airtime += rx_airtime;
+				wcid->stats.tx_airtime[ac] += tx;
+				wcid->stats.rx_airtime[ac] += rx;
 				ieee80211_sta_register_airtime(sta, mt76_ac_to_tid(ac),
-				                               tx_airtime, rx_airtime);
+							       tx, rx);
 			}
 			break;
 		case UNI_ALL_STA_RX_MPDU_COUNT:
@@ -5232,6 +5244,8 @@ int mt7996_mcu_get_chan_mib_info(struct
 	struct mt7996_dev *dev = phy->dev;
 	struct mt7996_mcu_mib *res;
 	struct sk_buff *skb;
+	unsigned long now;
+	u32 elapsed_us;
 	int i, ret;
 
 	for (i = 0; i < IDX_NUM; i++) {
@@ -5253,16 +5267,22 @@ int mt7996_mcu_get_chan_mib_info(struct
 		goto out;
 
 #define __res_u64(s) le64_to_cpu(res[s].data)
-	state->cc_tx += __res_u64(IDX_TX_TIME) - state_ts->cc_tx;
-	state->cc_bss_rx += __res_u64(IDX_RX_TIME) - state_ts->cc_bss_rx;
-	state->cc_rx += __res_u64(IDX_RX_TIME) +
-			__res_u64(IDX_OBSS_AIRTIME) -
-			state_ts->cc_rx;
-	state->cc_busy += __res_u64(IDX_TX_TIME) +
-			  __res_u64(IDX_RX_TIME) +
-			  __res_u64(IDX_OBSS_AIRTIME) +
-			  __res_u64(IDX_NON_WIFI_TIME) -
-			  state_ts->cc_busy;
