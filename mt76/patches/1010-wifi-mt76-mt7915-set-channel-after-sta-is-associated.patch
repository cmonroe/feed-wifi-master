From: Chad Monroe <chad@monroe.io>
Date: Sun, 09 Aug 2026 20:00:28 -0700
Subject: [PATCH] wifi: mt76: mt7915: set channel after sta is associated

When a STA interface associates on a DFS channel, re-issue the MCU
CHANNEL_SWITCH command so the switch reason moves from CH_SWITCH_DFS,
used at auth time while the DFS state is still USABLE, to
CH_SWITCH_NORMAL.

mac80211 only marks the channel AVAILABLE via
cfg80211_sta_update_dfs_state() after the MLME event callback
returns, so defer the channel update to a wiphy_delayed_work and
gate it on cfg80211_chandef_dfs_required() to leave non-DFS
associations alone.

Based-on-work-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7915/main.c |   21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

--- a/mt7915/main.c
+++ b/mt7915/main.c
@@ -114,6 +114,7 @@ static void mt7915_stop(struct ieee80211
 	struct mt7915_phy *phy = mt7915_hw_phy(hw);
 
 	cancel_delayed_work_sync(&phy->mt76->mac_work);
+	wiphy_delayed_work_cancel(hw->wiphy, &phy->mt76->assoc_chan_work);
 
 	mutex_lock(&dev->mt76.mutex);
 
@@ -780,6 +781,25 @@ mt7915_post_channel_switch(struct ieee80
 	return ret;
 }
 
+static void
+mt7915_event_callback(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		      const struct ieee80211_event *event)
+{
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+
+	switch (event->type) {
+	case MLME_EVENT:
+		if (event->u.mlme.data == ASSOC_EVENT &&
+		    event->u.mlme.status == MLME_SUCCESS)
+			wiphy_delayed_work_queue(hw->wiphy,
+						 &phy->mt76->assoc_chan_work,
+						 0);
+		break;
+	default:
+		break;
+	}
+}
+
 int mt7915_mac_sta_add(struct mt76_dev *mdev, struct ieee80211_vif *vif,
 		       struct ieee80211_sta *sta)
 {
@@ -1907,6 +1927,7 @@ const struct ieee80211_ops mt7915_ops =
 	.set_sar_specs = mt7915_set_sar_specs,
 	.channel_switch_beacon = mt7915_channel_switch_beacon,
 	.post_channel_switch = mt7915_post_channel_switch,
+	.event_callback = mt7915_event_callback,
 	.get_stats = mt7915_get_stats,
 	.get_et_sset_count = mt7915_get_et_sset_count,
 	.get_et_stats = mt7915_get_et_stats,
