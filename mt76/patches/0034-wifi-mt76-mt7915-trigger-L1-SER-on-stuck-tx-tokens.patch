+bool mt7915_wcid_ps_get(struct mt76_dev *mdev, u16 idx)
+{
+	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
+	u32 val;
+
+	/* the station poll selects the WTBL group under the same lock */
+	spin_lock_bh(&mdev->sta_poll_lock);
+	val = mt76_rr(dev, mt7915_mac_wtbl_lmac_addr(dev, idx, 5));
+	spin_unlock_bh(&mdev->sta_poll_lock);
+
+	return !!(val & MT_WTBL_LMAC_DW5_PSM);
+}
