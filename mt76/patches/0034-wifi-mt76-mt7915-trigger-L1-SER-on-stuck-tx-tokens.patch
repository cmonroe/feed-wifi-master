 	debugfs_create_bool("led_active_low", 0600, dir, &phy->leds.al);
 	debugfs_create_u32("regidx", 0600, dir, &dev->debugfs_reg);
 	debugfs_create_file_unsafe("regval", 0600, dir, dev, fops);
+	debugfs_create_u32("token_timeout", 0600, dir, &dev->token_timeout);
+	debugfs_create_bool("token_ser", 0600, dir, &dev->token_ser);
 	debugfs_create_file_unsafe("napi_threaded", 0600, dir, dev,
 				   &fops_napi_threaded);
 	debugfs_create_blob("eeprom", 0400, dir, &dev->eeprom);
--- a/mac80211.c
+++ b/mac80211.c
@@ -757,6 +757,10 @@ mt76_alloc_device(struct device *pdev, u
 	INIT_LIST_HEAD(&dev->rxwi_cache);
 	dev->token_size = dev->drv->token_size;
 	dev->token_threshold = dev->token_size;
+	dev->token_timeout = MT76_TOKEN_TIMEOUT_DEFAULT;
+	dev->token_ser = true;
+	dev->token_check_next = jiffies;
+	dev->token_event_next = jiffies;
 	INIT_DELAYED_WORK(&dev->scan_work, mt76_scan_work);
 	spin_lock_init(&dev->scan_lock);
 
--- a/mt76.h
+++ b/mt76.h
@@ -34,6 +34,11 @@
 
 #define MT76_TOKEN_FREE_THR	64
 
+#define MT76_TOKEN_TIMEOUT_DEFAULT	420
+#define MT76_TOKEN_TIMEOUT_MAX		86400
+#define MT76_TOKEN_CHECK_INTERVAL	(10 * HZ)
+#define MT76_TOKEN_STALE_LOG_MAX	8
+
 #define MT76_WED_WDS_MIN	256
 #define MT76_WED_WDS_MAX	272
 
@@ -990,6 +995,10 @@ struct mt76_dev {
 	u16 token_start;
 	u16 token_size;
 	u16 token_threshold;
+	u32 token_timeout;
+	bool token_ser;
+	unsigned long token_check_next;
+	unsigned long token_event_next;
 
 	spinlock_t rx_token_lock;
 	struct idr rx_token;
@@ -2077,6 +2086,9 @@ struct mt76_txwi_cache *
 mt76_token_release(struct mt76_dev *dev, int token, bool *wake);
 int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi,
 		       u8 phy_idx);
+bool mt76_token_check_due(struct mt76_dev *dev);
+int mt76_token_check_stale(struct mt76_dev *dev);
+void mt76_token_event_hold(struct mt76_dev *dev);
 void __mt76_set_tx_blocked(struct mt76_dev *dev, bool blocked);
 struct mt76_txwi_cache *mt76_rx_token_release(struct mt76_dev *dev, int token);
 int mt76_rx_token_consume(struct mt76_dev *dev, void *ptr,
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -750,6 +750,7 @@ int mt7915_tx_prepare_skb(struct mt76_de
 	t = (struct mt76_txwi_cache *)(txwi + mdev->drv->txwi_size);
 	t->skb = tx_info->skb;
 	t->wcid = wcid->idx;
+	t->jiffies = jiffies;
 
 	id = mt76_token_consume(mdev, &t, wcid->phy_idx);
 	if (id < 0)
@@ -1929,6 +1930,27 @@ void mt7915_mac_update_stats(struct mt79
 	}
 }
 
+static void mt7915_mac_token_check(struct mt7915_phy *phy)
+{
+	struct mt7915_dev *dev = phy->dev;
+	int band, ret;
+
+	if (dev->recovery.restart || !mt76_token_check_due(&dev->mt76))
+		return;
+
+	band = mt76_token_check_stale(&dev->mt76);
+	if (band < 0)
+		return;
+
+	ret = mt7915_mcu_set_ser(dev, SER_ENABLE, BIT(SER_SET_RECOVER_L1), band);
+	if (!ret)
+		ret = mt7915_mcu_set_ser(dev, SER_RECOVER, SER_SET_RECOVER_L1,
+					 band);
+	if (ret)
+		dev_err(dev->mt76.dev, "band%d: L1 SER trigger failed: %d\n",
+			band, ret);
+}
+
 static void mt7915_mac_severe_check(struct mt7915_phy *phy)
 {
 	struct mt7915_dev *dev = phy->dev;
@@ -1959,8 +1981,9 @@ static void mt7915_mac_severe_check(stru
 		dev_warn(dev->mt76.dev,
 			 "band%d: PLE error 0x%x detected, triggering L1 SER\n",
 			 phy->mt76->band_idx, ple_err);
-		mt7915_mcu_set_ser(dev, SER_RECOVER, SER_SET_RECOVER_L1,
-				   phy->mt76->band_idx);
+		if (!mt7915_mcu_set_ser(dev, SER_RECOVER, SER_SET_RECOVER_L1,
+					phy->mt76->band_idx))
+			mt76_token_event_hold(&dev->mt76);
 	}
 	dev->ple1_sts = ple_err;
 }
@@ -2018,6 +2041,7 @@ void mt7915_mac_work(struct work_struct
 
 		mt7915_mac_update_stats(phy);
 		mt7915_mac_severe_check(phy);
+		mt7915_mac_token_check(phy);
 
 		if (phy->dev->muru_debug)
 			mt7915_mcu_muru_debug_get(phy);
--- a/tx.c
+++ b/tx.c
@@ -3,6 +3,7 @@
  * Copyright (C) 2016 Felix Fietkau <nbd@nbd.name>
  */
 
+#include <linux/sort.h>
 #include "mt76.h"
 
 static int
@@ -1076,6 +1077,203 @@ mt76_token_release(struct mt76_dev *dev,
 }
 EXPORT_SYMBOL_GPL(mt76_token_release);
 
+static unsigned long mt76_token_hold_time(struct mt76_dev *dev)
+{
+	u32 timeout = min_t(u32, READ_ONCE(dev->token_timeout),
+			    MT76_TOKEN_TIMEOUT_MAX);
+
+	return max_t(unsigned long, (unsigned long)timeout * HZ,
+		     MT76_TOKEN_CHECK_INTERVAL);
+}
+
+void mt76_token_event_hold(struct mt76_dev *dev)
+{
+	dev->token_event_next = jiffies + mt76_token_hold_time(dev);
+}
+EXPORT_SYMBOL_GPL(mt76_token_event_hold);
+
+bool mt76_token_check_due(struct mt76_dev *dev)
+{
+	unsigned long now = jiffies;
+
+	lockdep_assert_held(&dev->mutex);
+
+	/* an expired deadline left far behind jiffies reads as future
+	 * again after a wrap, so keep both deadlines near jiffies
+	 */
+	if (time_after(now, dev->token_event_next))
+		dev->token_event_next = now;
+	if (time_after(now, dev->token_check_next))
+		dev->token_check_next = now;
+
+	if (test_bit(MT76_MCU_RESET, &dev->phy.state) ||
+	    test_bit(MT76_REMOVED, &dev->phy.state))
+		return false;
+
+	if (time_before(now, dev->token_check_next))
+		return false;
+
+	dev->token_check_next = now + MT76_TOKEN_CHECK_INTERVAL;
+
+	return true;
+}
+EXPORT_SYMBOL_GPL(mt76_token_check_due);
+
+struct mt76_token_stale {
+	u32 age_ms;
+	u16 id;
+	u16 wcid;
+	u8 band;
+	bool slot;
+};
+
+static void
+mt76_token_stale_record(struct mt76_token_stale *stale, int *n,
+			const struct mt76_token_stale *entry)
+{
+	int i, youngest = 0;
+
+	if (*n < MT76_TOKEN_STALE_LOG_MAX) {
+		stale[(*n)++] = *entry;
+		return;
+	}
+
+	for (i = 1; i < MT76_TOKEN_STALE_LOG_MAX; i++)
+		if (stale[i].age_ms < stale[youngest].age_ms)
+			youngest = i;
+
+	if (entry->age_ms > stale[youngest].age_ms)
+		stale[youngest] = *entry;
+}
+
+static int mt76_token_stale_cmp(const void *a, const void *b)
+{
+	const struct mt76_token_stale *sa = a, *sb = b;
+
+	if (sa->age_ms == sb->age_ms)
+		return 0;
+
+	return sa->age_ms > sb->age_ms ? -1 : 1;
+}
+
+struct mt76_token_scan {
+	struct mt76_dev *dev;
+	unsigned long now;
+	unsigned long tmo;
+	struct mt76_token_stale stale[MT76_TOKEN_STALE_LOG_MAX];
+	int count[__MT_MAX_BAND];
+	int n;
+	int total;
+	int oldest;
+	u32 oldest_age;
+};
+
+/* same result as mt76_dev_phy(dev, phy_idx)->band_idx, without a
+ * dereference of an extra phy that its removal may free meanwhile
+ */
+static u8 mt76_token_band(struct mt76_dev *dev, u8 phy_idx)
+{
+	if ((phy_idx == MT_BAND1 || phy_idx == MT_BAND2) &&
+	    READ_ONCE(dev->phys[phy_idx]))
+		return phy_idx;
+
+	return dev->phy.band_idx;
+}
+
+static int mt76_token_scan_one(int id, void *p, void *data)
+{
+	struct mt76_token_scan *scan = data;
+	struct mt76_dev *dev = scan->dev;
+	struct mt76_txwi_cache *t = p;
+	struct mt76_token_stale entry;
+	unsigned long stamp;
+	u16 wcid;
+
+	if (!t)
+		return 0;
+
+	stamp = READ_ONCE(t->jiffies);
+	if (!time_after(scan->now, stamp + scan->tmo))
+		return 0;
+
+	wcid = READ_ONCE(t->wcid);
+	entry.age_ms = jiffies_to_msecs(scan->now - stamp);
+	entry.id = id;
+	entry.wcid = wcid;
+	entry.band = mt76_token_band(dev, READ_ONCE(t->phy_idx));
+	entry.slot = wcid < ARRAY_SIZE(dev->wcid) &&
+		     rcu_access_pointer(dev->wcid[wcid]);
+
+	scan->count[entry.band]++;
+	scan->total++;
+	mt76_token_stale_record(scan->stale, &scan->n, &entry);
+
+	if (scan->oldest < 0 || entry.age_ms > scan->oldest_age) {
+		scan->oldest = entry.band;
+		scan->oldest_age = entry.age_ms;
+	}
+
+	return 0;
+}
+
+int mt76_token_check_stale(struct mt76_dev *dev)
+{
+	struct mt76_token_scan scan = {
+		.dev = dev,
+		.now = jiffies,
+		.oldest = -1,
+	};
+	const char *action;
+	u32 tmo_s;
+	bool ser;
+	int i;
+
+	lockdep_assert_held(&dev->mutex);
+
+	tmo_s = min_t(u32, READ_ONCE(dev->token_timeout),
+		      MT76_TOKEN_TIMEOUT_MAX);
+	if (!tmo_s || time_before(scan.now, dev->token_event_next) ||
+	    !READ_ONCE(dev->token_count))
+		return -1;
+
+	scan.tmo = (unsigned long)tmo_s * HZ;
+
+	/* no token lock, so the walk never stalls the TX and TX-free paths:
+	 * txwi buffers stay allocated until mt76_dma_cleanup(), and a slot
+	 * that a concurrent release clears reads as NULL
+	 */
+	rcu_read_lock();
+	idr_for_each(&dev->token, mt76_token_scan_one, &scan);
+	rcu_read_unlock();
+
+	if (!scan.total)
+		return -1;
+
+	mt76_token_event_hold(dev);
+	ser = READ_ONCE(dev->token_ser);
+	action = ser ? "triggering L1 SER" : "log only";
+
+	for (i = 0; i < __MT_MAX_BAND; i++) {
+		if (!scan.count[i])
+			continue;
+
+		dev_warn(dev->dev, "band%d: %d tx token(s) pending > %u s, %s\n",
+			 i, scan.count[i], tmo_s, action);
+	}
+
+	sort(scan.stale, scan.n, sizeof(scan.stale[0]), mt76_token_stale_cmp,
+	     NULL);
+	for (i = 0; i < scan.n; i++)
+		dev_info(dev->dev,
+			 "band%u: stale token %u wcid %u age %u ms wcid slot %s\n",
+			 scan.stale[i].band, scan.stale[i].id,
+			 scan.stale[i].wcid, scan.stale[i].age_ms,
+			 scan.stale[i].slot ? "occupied" : "empty");
+
+	return ser ? scan.oldest : -1;
+}
+EXPORT_SYMBOL_GPL(mt76_token_check_stale);
+
 struct mt76_txwi_cache *
 mt76_rx_token_release(struct mt76_dev *dev, int token)
 {
