From: Chad Monroe <chad@monroe.io>
Date: Tue, 03 Nov 2026 19:49:51 -0800
Subject: [PATCH] wifi: mt76: mt7996: report the failing stage of a full chip reset

A failed full chip reset logs no band, step or firmware status. It
also reloads the firmware ten times when every try returns the same
status.

Each radio start failure names its band, step and result, and a
failed hardware restart logs its result. A channel set failure names
its request. The reset loop ends when two consecutive radio starts
fail with the same firmware status at the same band and step. A
reload does not change such a status. A timeout, a send failure or a
failed hardware restart keeps the ten tries.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7996/mac.c    |   36 ++++++++++++++++++++++++++++--------
 mt7996/main.c   |   22 ++++++++++++++++++++--
 mt7996/mcu.c    |   12 ++++++++++--
 mt7996/mt7996.h |    7 +++++++
 4 files changed, 65 insertions(+), 12 deletions(-)

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2463,8 +2463,10 @@ mt7996_mac_restart(struct mt7996_dev *de
 	int ret;
 
 	ret = __mt7996_mac_restart_hw(dev);
-	if (ret)
+	if (ret) {
+		dev_err(dev->mt76.dev, "hardware restart failed: %d\n", ret);
 		goto out;
+	}
 
 	mt7996_for_each_phy(dev, phy) {
 		if (!test_bit(MT76_STATE_RUNNING, &phy->mt76->state))
@@ -2581,12 +2583,25 @@ mt7996_mac_reset_vif_iter(void *data, u8
 	rcu_read_unlock();
 }
 
+static bool
+mt7996_start_fail_repeated(const struct mt7996_start_fail *fail,
+			   const struct mt7996_start_fail *prev)
+{
+	/* a positive value is a firmware status; a reload does not change it,
+	 * but only a radio start names the command that returned it
+	 */
+	return fail->step && fail->ret > 0 && fail->step == prev->step &&
+	       fail->band == prev->band && fail->ret == prev->ret;
+}
+
 static void
 mt7996_mac_full_reset(struct mt7996_dev *dev)
 {
+	struct mt7996_start_fail *fail = &dev->recovery.start_fail;
 	struct ieee80211_hw *hw = mt76_hw(dev);
+	struct mt7996_start_fail prev;
 	struct mt7996_phy *phy;
-	int i;
+	int i, ret;
 
 	dev->recovery.hw_full_reset = true;
 
@@ -2606,13 +2621,18 @@ mt7996_mac_full_reset(struct mt7996_dev
 	mt76_abort_scan(&dev->mt76);
 
 	mutex_lock(&dev->mt76.mutex);
-	for (i = 0; i < 10; i++) {
-		if (!mt7996_mac_restart(dev))
-			break;
-	}
+	memset(fail, 0, sizeof(*fail));
+	i = 0;
+	do {
+		prev = *fail;
+		fail->step = NULL;
+		ret = mt7996_mac_restart(dev);
+		i++;
+	} while (ret && i < 10 && !mt7996_start_fail_repeated(fail, &prev));
 
-	if (i == 10)
-		dev_err(dev->mt76.dev, "chip full reset failed\n");
+	if (ret)
+		dev_err(dev->mt76.dev,
+			"chip full reset failed after %d tries: %d\n", i, ret);
 
 	mt7996_mac_restart_state_reset(dev);
 
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -13,36 +13,44 @@
 int mt7996_run(struct mt7996_phy *phy)
 {
 	struct mt7996_dev *dev = phy->dev;
+	const char *step;
 	int ret;
 
 	mt7996_mac_enable_nf(dev, phy->mt76->band_idx);
 
+	step = "rts";
 	ret = mt7996_mcu_set_rts_thresh(phy, 0x92b);
 	if (ret)
-		return ret;
+		goto fail;
 
+	step = "radio";
 	ret = mt7996_mcu_set_radio_en(phy, true);
 	if (ret)
-		return ret;
+		goto fail;
 
+	step = "rx path";
 	ret = mt7996_mcu_set_chan_info(phy, UNI_CHANNEL_RX_PATH);
 	if (ret)
 		goto disable_radio;
 
 	/* set a parking channel */
+	step = "channel";
 	ret = mt7996_mcu_set_chan_info(phy, UNI_CHANNEL_SWITCH);
 	if (ret)
 		goto disable_radio;
 
+	step = "throttle";
 	ret = mt7996_mcu_set_thermal_throttling(phy, MT7996_THERMAL_THROTTLE_MAX -
 						     phy->cdev_state);
 	if (ret)
 		goto disable_radio;
 
+	step = "protect";
 	ret = mt7996_mcu_set_thermal_protect(phy, true);
 	if (ret)
 		goto disable_radio;
 
+	step = "scs";
 	ret = mt7996_mcu_set_carrier_sense(phy, SCS_ENABLE);
 	if (ret)
 		goto disable_radio;
@@ -54,19 +62,23 @@ int mt7996_run(struct mt7996_phy *phy)
 	dev_info(dev->mt76.dev, "%s: band = %d, sku enable = %d, path enable = %d\n", __func__, phy->mt76->band_idx,
 		dev->dbg.sku_disable ? 0 : phy->sku_limit_en, dev->dbg.sku_disable ? 0 : phy->sku_path_en);
 
+	step = "sku";
 	ret = mt7996_mcu_set_tx_power_ctrl(phy, UNI_TXPOWER_SKU_POWER_LIMIT_CTRL,
 						dev->dbg.sku_disable ? 0 : phy->sku_limit_en);
 	if (ret)
 		goto disable_radio;
 
+	step = "backoff";
 	ret = mt7996_mcu_set_tx_power_ctrl(phy, UNI_TXPOWER_BACKOFF_POWER_LIMIT_CTRL,
 						dev->dbg.sku_disable ? 0 : phy->sku_path_en);
 #else
+	step = "sku";
 	ret = mt7996_mcu_set_tx_power_ctrl(phy, UNI_TXPOWER_SKU_POWER_LIMIT_CTRL,
 						phy->sku_limit_en);
 	if (ret)
 		goto disable_radio;
 
+	step = "backoff";
 	ret = mt7996_mcu_set_tx_power_ctrl(phy, UNI_TXPOWER_BACKOFF_POWER_LIMIT_CTRL,
 						phy->sku_path_en);
 #endif
@@ -99,6 +111,12 @@ int mt7996_run(struct mt7996_phy *phy)
 
 disable_radio:
 	mt7996_mcu_set_radio_en(phy, false);
+fail:
+	dev->recovery.start_fail.step = step;
+	dev->recovery.start_fail.band = phy->mt76->band_idx;
+	dev->recovery.start_fail.ret = ret;
+	dev_err(dev->mt76.dev, "band%d: radio start failed at %s: %d\n",
+		phy->mt76->band_idx, step, ret);
 
 	return ret;
 }
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -4925,6 +4925,7 @@ int mt7996_mcu_set_chan_info(struct mt79
 	struct cfg80211_chan_def *chandef = &phy->mt76->chandef;
 	int freq1 = chandef->center_freq1;
 	u8 band_idx = phy->mt76->band_idx;
+	int ret;
 	struct {
 		/* fixed field */
 		u8 __rsv[4];
@@ -4979,8 +4980,15 @@ int mt7996_mcu_set_chan_info(struct mt79
 		req.center_ch2 = ieee80211_frequency_to_channel(freq2);
 	}
 
-	return mt76_mcu_send_msg(&dev->mt76, MCU_WMWA_UNI_CMD(CHANNEL_SWITCH),
-				 &req, sizeof(req), true);
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_WMWA_UNI_CMD(CHANNEL_SWITCH),
+				&req, sizeof(req), true);
+	if (ret)
+		dev_err(dev->mt76.dev,
+			"band%u: channel set failed: tag %u ctrl %u center %u bw %u reason %u: %d\n",
+			band_idx, tag, req.control_ch, req.center_ch, req.bw,
+			req.switch_reason, ret);
+
+	return ret;
 }
 
 int mt7996_mcu_set_punct(struct mt7996_phy *phy)
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -554,6 +554,12 @@ struct mt7996_phy {
 	struct mt7996_scs_ctrl scs_ctrl;
 };
 
+struct mt7996_start_fail {
+	const char *step;
+	int band;
+	int ret;
+};
+
 struct mt7996_dev {
 	union { /* must be first */
 		struct mt76_dev mt76;
@@ -596,6 +602,7 @@ struct mt7996_dev {
 		u32 wa_reset_count;
 		u32 wm_reset_count;
 		u32 l1_fail_count;
+		struct mt7996_start_fail start_fail;
 		bool hw_full_reset:1;
 		bool hw_init_done:1;
 		bool restart:1;
