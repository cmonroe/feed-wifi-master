+void mt7915_update_lpi(struct mt7915_phy *phy)
+{
+	int ret;
+
+	if (!phy->mt76->lpi_psd)
+		return;
+
+	ret = mt7915_mcu_set_lpi(phy, phy->mt76->lpi_psd);
+	if (ret)
+		dev_warn(phy->dev->mt76.dev, "failed to set LPI: %d\n", ret);
+}
+
+static void mt7915_regd_txpower_update(struct mt7915_phy *phy)
+{
+	struct mt7915_dev *dev = phy->dev;
+	int ret;
+
+	/* psd_limit of the LPI command depends on the country */
+	mt7915_update_lpi(phy);
+
+	ret = mt7915_mcu_set_sku_en(phy);
+	if (ret)
+		dev_warn(dev->mt76.dev, "failed to update the SKU limits: %d\n",
+			 ret);
+}
