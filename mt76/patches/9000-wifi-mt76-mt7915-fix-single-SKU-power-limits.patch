 	err = mt7915_mcu_set_txpower_sku(phy);
@@ -212,6 +207,32 @@ static int mt7915_vendor_txpower_ctrl(st
 	return 0;
 }
 
+static int mt7915_vendor_txpower_ctrl(struct wiphy *wiphy,
+				  struct wireless_dev *wdev,
+				  const void *data,
+				  int data_len)
+{
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+	struct mt7915_dev *dev = mt7915_hw_dev(hw);
+	struct mt7915_phy *phy = mt7915_hw_phy(hw);
+	struct nlattr *tb[NUM_MTK_VENDOR_ATTRS_TXPOWER_CTRL];
+	int err;
+
+	err = nla_parse(tb, MTK_VENDOR_ATTR_TXPOWER_CTRL_MAX, data, data_len,
+			txpower_ctrl_policy, NULL);
+	if (err)
+		return err;
+
+	/* the full reset and the regulatory notifier read lpi_psd and
+	 * send LPI under this mutex
+	 */
+	mutex_lock(&dev->mt76.mutex);
+	err = __mt7915_vendor_txpower_ctrl(phy, tb);
+	mutex_unlock(&dev->mt76.mutex);
+
+	return err;
+}
