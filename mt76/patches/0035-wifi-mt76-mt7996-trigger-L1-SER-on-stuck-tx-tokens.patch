From: Chad Monroe <chad@monroe.io>
Date: Mon, 28 Sep 2026 13:50:00 -0700
Subject: [PATCH] wifi: mt76: mt7996: trigger L1 SER on stuck TX tokens

Stuck TX tokens on mt7996 need an L1 SER from the driver, and the
firmware appeared to ignore the trigger unless a SER enable word was
written first.

The hook sends the request from the shared token check. It writes the
SER enable word before the trigger on MT7996 and MT7992; the offsets
and the value come from the field workaround, and MT7990 has no known
offset, so the driver warns once and sends the trigger anyway. The
request carries only the trigger, because a SER mask command replaces
the whole recovery mask of the firmware. The MAC work runs the check
on the token cadence of the core, so it runs once per device and not
once per band.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7996/mac.c  |   29 +++++++++++++++++++++++++++++
 mt7996/regs.h |    8 ++++++++
 2 files changed, 37 insertions(+)

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2942,6 +2942,31 @@ void mt7996_mac_update_stats(struct mt79
 	}
 }
 
+static void mt7996_mac_token_check(struct mt7996_phy *phy)
+{
+	struct mt7996_dev *dev = phy->dev;
+	int band, ret;
+
+	band = mt76_token_check_stale(&dev->mt76);
+	if (band < 0)
+		return;
+
+	if (is_mt7996(&dev->mt76))
+		mt76_wr(dev, MT_SWDEF_SER_ENABLE_MT7996, MT_SWDEF_SER_ENABLE_VAL);
+	else if (is_mt7992(&dev->mt76))
+		mt76_wr(dev, MT_SWDEF_SER_ENABLE_MT7992, MT_SWDEF_SER_ENABLE_VAL);
+	else
+		dev_warn_once(dev->mt76.dev,
+			      "chip %04x: no SER enable offset, the L1 trigger may be ignored\n",
+			      mt76_chip(&dev->mt76));
+
+	ret = mt7996_mcu_set_ser(dev, UNI_CMD_SER_TRIGGER,
+				 UNI_CMD_SER_SET_RECOVER_L1, band);
+	if (ret)
+		dev_err(dev->mt76.dev, "band%d: L1 SER trigger failed: %d\n",
+			band, ret);
+}
+
 void mt7996_mac_sta_rc_work(struct work_struct *work)
 {
 	struct mt7996_dev *dev = container_of(work, struct mt7996_dev, rc_work);
@@ -3015,6 +3040,10 @@ void mt7996_mac_work(struct work_struct
 			mt7996_mcu_get_all_sta_info(phy, UNI_ALL_STA_TXRX_ADM_STAT);
 			mt7996_mcu_get_all_sta_info(phy, UNI_ALL_STA_TXRX_MSDU_COUNT);
 		}
+
+		if (!phy->dev->recovery.restart &&
+		    mt76_token_check_due(&phy->dev->mt76))
+			mt7996_mac_token_check(phy);
 	}
 
 	mutex_unlock(&mphy->dev->mutex);
--- a/mt7996/regs.h
+++ b/mt7996/regs.h
@@ -715,6 +715,14 @@ enum offs_rev {
 #define MT_SWDEF_LAMC_WISR7_BN1_STATS		MT_SWDEF(0x068)
 #define MT_SWDEF_LAMC_WISR7_BN2_STATS		MT_SWDEF(0x06c)
 
+/* The firmware appeared to ignore the L1 SER trigger unless this word
+ * was written first. The offsets and the value come from the field
+ * workaround; no documentation and no MT7990 (0x7993) offset is known.
+ */
+#define MT_SWDEF_SER_ENABLE_MT7996		MT_SWDEF(0x084)
+#define MT_SWDEF_SER_ENABLE_MT7992		MT_SWDEF(0x0ac)
+#define MT_SWDEF_SER_ENABLE_VAL			0x15100002
+
 /* LED */
 #define MT_LED_TOP_BASE				0x18013000
 #define MT_LED_PHYS(_n)				(MT_LED_TOP_BASE + (_n))
