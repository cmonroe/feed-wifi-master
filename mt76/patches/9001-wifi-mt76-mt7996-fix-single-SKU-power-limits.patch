+/* phy->txpower also takes the highest channel limit when the country
+ * changes, so the power that mac80211 configures is kept apart
+ */
+int mt7996_get_txpower_setting(struct mt7996_phy *phy)
+{
+	int max_power = phy->mt76->chandef.chan->max_power;
+
+	if (phy->bss_txpower == INT_MIN)
+		return max_power;
+
+	return min(phy->bss_txpower, max_power);
+}
