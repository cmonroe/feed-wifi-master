From: Chad Monroe <chad@monroe.io>
Date: Tue, 03 Nov 2026 09:17:45 -0800
Subject: [PATCH] wifi: mt76: mt7996: return RRO tables to probe state at a full reset

A full chip reset frees the hardware RRO page pool and allocates a
new one, and the restart programs the RRO address element and
session table bases into the chip again. Those tables keep the head
page and count of every session from before the reset. The chip
treats such entries as live chains and writes receive descriptors
and chain pointers into pages the kernel freed and reused, which
corrupts slab objects and page tables minutes after the reset.

The restart returns address element, session, BA bitmap and MSDU
page tables to probe state, because the chip holds no session after
a wfsys reset and every entry must say so. Probe and restart share
one function that writes that state.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 mt7996/init.c   |   63 ++++++++++++++++++++++++++++++++--------------
 mt7996/mac.c    |    1 
 mt7996/mt7996.h |    1 
 3 files changed, 46 insertions(+), 19 deletions(-)

--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -977,10 +977,51 @@ void mt7996_rro_hw_init(struct mt7996_de
 		MT_RRO_HOST_INT_ENA_HOST_RRO_DONE_ENA);
 }
 
-static int mt7996_wed_rro_init(struct mt7996_dev *dev)
+/* The chip and WED read the tables as session state, so a full reset
+ * must return them to probe state: no chain for any sequence number.
+ */
+void mt7996_rro_tables_init(struct mt7996_dev *dev)
 {
 	u32 val = FIELD_PREP(WED_RRO_ADDR_SIGNATURE_MASK, 0xff);
 	struct mt7996_wed_rro_addr *addr;
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(dev->wed_rro.ba_bitmap); i++) {
+		if (dev->wed_rro.ba_bitmap[i].ptr)
+			memset(dev->wed_rro.ba_bitmap[i].ptr, 0,
+			       MT7996_RRO_BA_BITMAP_CR_SIZE);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(dev->wed_rro.addr_elem); i++) {
+		addr = dev->wed_rro.addr_elem[i].ptr;
+		if (!addr)
+			continue;
+
+		for (j = 0; j < MT7996_RRO_WINDOW_MAX_SIZE; j++, addr++) {
+			addr->head_low = 0;
+			addr->data = cpu_to_le32(val);
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(dev->wed_rro.msdu_pg); i++) {
+		if (dev->wed_rro.msdu_pg[i].ptr)
+			memset(dev->wed_rro.msdu_pg[i].ptr, 0,
+			       MT7996_RRO_MSDU_PG_SIZE_PER_CR);
+	}
+
+	addr = dev->wed_rro.session.ptr;
+	if (!addr)
+		return;
+
+	for (i = 0; i < MT7996_RRO_WINDOW_MAX_LEN; i++, addr++) {
+		addr->head_low = 0;
+		addr->data = cpu_to_le32(val);
+	}
+}
+
+static int mt7996_wed_rro_init(struct mt7996_dev *dev)
+{
+	struct mt7996_wed_rro_addr *addr;
 	void *ptr;
 	int i;
 
@@ -1001,8 +1042,6 @@ static int mt7996_wed_rro_init(struct mt
 	}
 
 	for (i = 0; i < ARRAY_SIZE(dev->wed_rro.addr_elem); i++) {
-		int j;
-
 		ptr = dmam_alloc_coherent(dev->mt76.dma_dev,
 				MT7996_RRO_WINDOW_MAX_SIZE * sizeof(*addr),
 				&dev->wed_rro.addr_elem[i].phy_addr,
@@ -1011,14 +1050,6 @@ static int mt7996_wed_rro_init(struct mt
 			return -ENOMEM;
 
 		dev->wed_rro.addr_elem[i].ptr = ptr;
-		memset(dev->wed_rro.addr_elem[i].ptr, 0,
-		       MT7996_RRO_WINDOW_MAX_SIZE * sizeof(*addr));
-
-		addr = dev->wed_rro.addr_elem[i].ptr;
-		for (j = 0; j < MT7996_RRO_WINDOW_MAX_SIZE; j++) {
-			addr->data = cpu_to_le32(val);
-			addr++;
-		}
 
 		if (is_mt7996(&dev->mt76) &&
 		    mt76_npu_device_active(&dev->mt76))
@@ -1046,9 +1077,6 @@ static int mt7996_wed_rro_init(struct mt
 			return -ENOMEM;
 
 		dev->wed_rro.msdu_pg[i].ptr = ptr;
-
-		memset(dev->wed_rro.msdu_pg[i].ptr, 0,
-		       MT7996_RRO_MSDU_PG_SIZE_PER_CR);
 	}
 
 	if (!mtk_wed_device_active(&dev->mt76.mmio.wed) &&
@@ -1080,16 +1108,12 @@ static int mt7996_wed_rro_init(struct mt
 		return -ENOMEM;
 
 	dev->wed_rro.session.ptr = ptr;
-	addr = dev->wed_rro.session.ptr;
-	for (i = 0; i < MT7996_RRO_WINDOW_MAX_LEN; i++) {
-		addr->data = cpu_to_le32(val);
-		addr++;
-	}
 
 	if (is_mt7996(&dev->mt76) && mt76_npu_device_active(&dev->mt76))
 		mt76_npu_send_txrx_addr(&dev->mt76, 1, 0,
 					dev->wed_rro.session.phy_addr, 0, 0);
 
+	mt7996_rro_tables_init(dev);
 	mt7996_rro_hw_init(dev);
 
 	return mt7996_dma_rro_init(dev);
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2399,6 +2399,7 @@ mt7996_mac_restart(struct mt7996_dev *de
 		u32 wed_irq_mask = dev->mt76.mmio.irqmask |
 				   MT_INT_TX_DONE_BAND2;
 
+		mt7996_rro_tables_init(dev);
 		mt7996_rro_hw_init(dev);
 		mt76_for_each_q_rx(&dev->mt76, i) {
 			if (mt76_queue_is_wed_rro_ind(&dev->mt76.q_rx[i]) ||
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -788,6 +788,7 @@ extern struct pci_driver mt7996_hif_driv
 
 struct mt7996_dev *mt7996_mmio_probe(struct device *pdev,
 				     void __iomem *mem_base, u32 device_id);
+void mt7996_rro_tables_init(struct mt7996_dev *dev);
 void mt7996_rro_hw_init(struct mt7996_dev *dev);
 void mt7996_wfsys_reset(struct mt7996_dev *dev);
 irqreturn_t mt7996_irq_handler(int irq, void *dev_instance);
