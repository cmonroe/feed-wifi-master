From 76e54b095fdd8ab65a562c28fba330afcfb519ec Mon Sep 17 00:00:00 2001
From: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Date: Wed, 5 Jul 2023 10:44:15 +0800
Subject: [PATCH] hostapd: mtk: Fix background channel overlapping operating
 channel issue

A STA can mark the block of the background chain available while the
AP and the chain both run a CAC. A radar during the CAC of the AP can
then select that block, and the AP starts there without a CAC. No CAC
start stops the chain, so hostapd keeps the record, and a later radar
on the new operating channel matches the chain instead of the AP.

hostapd now drops the record when the AP leaves a radar during its CAC
for a block that holds a channel of the chain. A test of the primary
channels is not sufficient: a chain that the search narrowed can lie
inside the new AP block with a primary channel of its own. Its record
then stays, and the completion of its CAC moves the AP onto the narrow
chain without a radar. After the background chain search narrows the
width, it also refuses the primary channel of the AP and of the
current chain. Other overlaps stay with the kernel, which stops a
chain whose primary channel lies in a new CAC block.

Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Co-developed-by: Chad Monroe <chad@monroe.io>
Signed-off-by: Chad Monroe <chad@monroe.io>
Co-developed-by: Piotr Kubik <piotr.kubik@adtran.com>
Signed-off-by: Piotr Kubik <piotr.kubik@adtran.com>
---
 src/ap/dfs.c | 37 +++++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1236,6 +1236,8 @@ static void hostapd_dfs_update_backgroun
 						  &oper_centr_freq_seg1_idx,
 						  &channel_type);
 	if (!channel ||
+	    channel->chan == iface->conf->channel ||
+	    channel->chan == iface->radar_background.channel ||
 	    hostapd_start_dfs_cac(iface, iface->conf->hw_mode,
 				  channel->freq, channel->chan,
 				  iface->conf->ieee80211n,
@@ -1334,6 +1336,31 @@ static bool dfs_background_chandef_conta
 }
 
 
+static bool dfs_background_overlaps_ap(struct hostapd_iface *iface)
+{
+	struct hostapd_hw_modes *mode = iface->current_mode;
+	int start_chan_idx, start_chan_idx1, n_chans, n_chans1, i;
+
+	start_chan_idx = dfs_get_start_chan_idx(iface, &start_chan_idx1);
+	if (start_chan_idx < 0)
+		return false;
+
+	n_chans = dfs_get_used_n_chans(iface, &n_chans1);
+	for (i = 0; i < n_chans; i++) {
+		if (dfs_background_chandef_contains(
+			    iface, mode->channels[start_chan_idx + i].freq))
+			return true;
+	}
+	for (i = 0; start_chan_idx1 >= 0 && i < n_chans1; i++) {
+		if (dfs_background_chandef_contains(
+			    iface, mode->channels[start_chan_idx1 + i].freq))
+			return true;
+	}
+
+	return false;
+}
+
+
 static bool dfs_background_chandef_available(struct hostapd_iface *iface)
 {
 	struct hostapd_hw_modes *mode = iface->current_mode;
@@ -1623,6 +1650,16 @@ static int hostapd_dfs_start_channel_swi
 	}
 	err = 0;
 
+	/* A STA can make the chain block available while both CACs run.
+	 * The AP then starts there without a CAC that would stop the chain.
+	 * A chain that the search narrowed has a primary channel of its
+	 * own, so the test covers the whole AP block.
+	 */
+	if (dfs_use_radar_background(iface) &&
+	    iface->radar_background.channel != -1 &&
+	    dfs_background_overlaps_ap(iface))
+		hostapd_dfs_chain_drop(iface);
+
 	hostapd_setup_interface_complete(iface, err);
 	return err;
 }
