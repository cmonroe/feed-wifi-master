From: Koral Ilgun <koral.ilgun@adtran.com>
Date: Wed, 11 Nov 2026 09:24:58 -0800
Subject: [PATCH] SAE: Let each STA reach its password with sae_track_password

With sae_track_password, hostapd tries the wildcard-addr passwords one
by one. In three cases, a STA that uses a valid password still did not
connect:

- A STA with an entry for its own address got that entry only after
  each wildcard-addr password failed for it, and only when no
  wildcard-addr entry came before it in the list.
- A STA that failed with each wildcard-addr password, for example
  after a typo, got the password of its last attempt again, and after
  hostapd removed its station entry, the first entry of the list. Any
  other valid password did not work again for that STA.
- A STA that succeeded with one wildcard-addr password got that
  password first at each later attempt, also after it changed to
  another valid password.

Use an entry for the address of the STA before the wildcard-addr
entries. That entry is then the only password of the STA: an attempt
with a wildcard-addr password fails. A failure with such an entry, or
with an entry that has a password identifier, is a plain mismatch:
answer it with status 15 and do not record it.

A success clears the fail records of the STA. A failure removes the
success record of the password that failed, so a success no longer
locks that password in for the STA. A forged failure can therefore
make the STA go through the iteration again at its next SAE exchange.
When each wildcard-addr password failed, remove the fail records of
the STA, and make the next attempt derive its PWE again, so that the
iteration starts again.

Fixes: ca9f86a19c44 ("SAE: Multiple default password iteration")
---
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -846,6 +846,27 @@ static int sae_password_mark_success(str
 }
 
 
+static void mac_addr_list_del(u8 *list, unsigned int num, const u8 *addr)
+{
+	unsigned int i;
+
+	for (i = 0; list && i < num; i++) {
+		if (ether_addr_equal(&list[i * ETH_ALEN], addr))
+			os_memset(&list[i * ETH_ALEN], 0, ETH_ALEN);
+	}
+}
+
+
+static void sae_password_clear_fails(struct hostapd_data *hapd,
+				     const u8 *addr)
+{
+	struct sae_password_entry *pw;
+
+	for (pw = hapd->conf->sae_passwords; pw; pw = pw->next)
+		mac_addr_list_del(pw->fail_mac, pw->num_fail_mac, addr);
+}
+
+
 static void sae_password_track_success(struct hostapd_data *hapd,
 				       struct sta_info *sta)
 {
@@ -858,10 +879,34 @@ static void sae_password_track_success(s
 	if (!pw)
 		return;
 
+	/* A later failure starts a new iteration, in which the passwords
+	 * that failed before this success are untried again. */
+	sae_password_clear_fails(hapd, sta->addr);
 	sae_password_mark_success(hapd, pw, sta->addr);
 }
 
 
+static int sae_password_mark_fail(struct hostapd_data *hapd,
+				  struct sae_password_entry *pw,
+				  const u8 *addr)
+{
+	if (in_mac_addr_list(pw->fail_mac, pw->num_fail_mac, addr))
+		return 0;
+
+	if (!pw->fail_mac) {
+		pw->fail_mac = os_zalloc(hapd->conf->sae_track_password *
+					 ETH_ALEN);
+		if (!pw->fail_mac)
+			return -1;
+		pw->num_fail_mac = hapd->conf->sae_track_password;
+	}
+
+	os_memcpy(&pw->fail_mac[pw->next_fail_mac * ETH_ALEN], addr, ETH_ALEN);
+	pw->next_fail_mac = (pw->next_fail_mac + 1) % pw->num_fail_mac;
+	return 0;
+}
+
+
 static bool sae_password_track_fail(struct hostapd_data *hapd,
 				    struct sta_info *sta)
 {
@@ -874,24 +919,35 @@ static bool sae_password_track_fail(stru
 	if (!pw)
 		return false;
 
-	if (in_mac_addr_list(pw->fail_mac,
-			     pw->num_fail_mac,
-			     sta->addr))
-		return is_other_sae_password(hapd, sta, pw);
+	/* Only the wildcard-addr entries are tried one by one, so a failure
+	 * with any other entry is a plain password mismatch. */
+	if (pw->identifier || !is_broadcast_ether_addr(pw->peer_addr))
+		return false;
 
-	if (!pw->fail_mac) {
-		pw->fail_mac = os_zalloc(hapd->conf->sae_track_password *
-					 ETH_ALEN);
-		if (!pw->fail_mac)
-			return false;
-		pw->num_fail_mac = hapd->conf->sae_track_password;
-	}
+	if (sae_password_mark_fail(hapd, pw, sta->addr) < 0)
+		return false;
 
-	os_memcpy(&pw->fail_mac[pw->next_fail_mac * ETH_ALEN], sta->addr,
-		  ETH_ALEN);
-	pw->next_fail_mac = (pw->next_fail_mac + 1) % pw->num_fail_mac;
+	/* A STA that changed its password fails with the one that worked
+	 * before, so that password must not be tried first again. */
+	mac_addr_list_del(pw->success_mac, pw->num_success_mac, sta->addr);
+
+	if (is_other_sae_password(hapd, sta, pw))
+		return true;
+
+	/* Each wildcard-addr password failed. Start again with the next
+	 * attempt, so that a STA that corrects its password can connect.
+	 * Without this, each later attempt gets the first wildcard-addr entry
+	 * of the list. The next attempt must not reuse the PWE of this
+	 * password, because it uses the password that sae_get_password()
+	 * selects. */
+	wpa_printf(MSG_DEBUG,
+		   "SAE: Each default password failed for " MACSTR
+		   " - start again with the next attempt",
+		   MAC2STR(sta->addr));
+	sae_password_clear_fails(hapd, sta->addr);
+	sta->sae->tmp->try_other_password = 1;
 
-	return is_other_sae_password(hapd, sta, pw);
+	return false;
 }
 
 
@@ -939,13 +995,19 @@ const char * sae_get_password(struct hos
 	 * not used. Select an wildcard-addr entry if the STA is known to have
 	 * used it successfully before. If no such entry exists, pick a
 	 * wildcard-addr entry that does not have a failed entry tracked for the
-	 * STA. */
+	 * STA. An entry for the address of the STA is selected first, and it
+	 * is then the only password for that STA. */
 	if (!rx_id && sta && hapd->conf->sae_track_password) {
 		struct sae_password_entry *success = NULL, *no_fail = NULL;
 
 		for (pw = hapd->conf->sae_passwords; pw; pw = pw->next) {
-			if (pw->identifier ||
-			    !is_broadcast_ether_addr(pw->peer_addr))
+			if (pw->identifier)
+				continue;
+			if (ether_addr_equal(pw->peer_addr, sta->addr)) {
+				success = pw;
+				break;
+			}
+			if (!is_broadcast_ether_addr(pw->peer_addr))
 				continue;
 			if (in_mac_addr_list(pw->success_mac,
 					     pw->num_success_mac,
