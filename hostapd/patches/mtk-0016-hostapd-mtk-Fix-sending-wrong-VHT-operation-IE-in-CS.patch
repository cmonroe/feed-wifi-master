From ded7bc8b684fa76874abc1ba47f59ecdf7126bdb Mon Sep 17 00:00:00 2001
From: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Date: Mon, 20 Feb 2023 11:01:18 +0800
Subject: [PATCH 16/28] hostapd: mtk: Fix sending wrong VHT operation IE in CSA
 while using ZWDFS

A move onto the background chain writes the chain channel into the AP
configuration before the CSA, so the beacons of the countdown show
the new channel in the VHT operation element. The CSA also takes its
width from the AP configuration, while the chain runs its CAC at its
own width, which can be narrower.

hostapd now requests the CSA at the width of the chain CAC, keeps the
old configuration for the countdown and writes the chain channel
after the request. It copies the chain record first, because the
restart of a refused switch drops the record. When the request fails
on its parameters, the interface is disabled, and no other switch
and no chain search follow. When every BSS refuses the switch, the
fallback restart chooses the channel, so hostapd keeps that channel
and only searches a new chain.

Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Co-developed-by: Chad Monroe <chad@monroe.io>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 src/ap/dfs.c | 40 +++++++++++++++++++++++++++-------------
 1 file changed, 27 insertions(+), 13 deletions(-)

--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1277,27 +1277,41 @@ static int
 hostapd_dfs_start_channel_switch_background(struct hostapd_iface *iface)
 {
 	u8 current_vht_oper_chwidth = hostapd_get_oper_chwidth(iface->conf);
+	/* the restart of a refused switch drops the record */
+	int channel = iface->radar_background.channel;
+	int freq = iface->radar_background.freq;
+	int secondary_channel = iface->radar_background.secondary_channel;
+	enum oper_chan_width chwidth = iface->radar_background.chwidth;
+	u8 seg0 = iface->radar_background.centr_freq_seg0_idx;
+	u8 seg1 = iface->radar_background.centr_freq_seg1_idx;
 
 	/* A radar always moves the AP, and a switch does not overlap a
 	 * manual ACS run. */
 	hostapd_manual_acs_end(iface);
 
-	iface->conf->channel = iface->radar_background.channel;
-	iface->freq = iface->radar_background.freq;
-	iface->conf->secondary_channel =
-		iface->radar_background.secondary_channel;
-	hostapd_set_oper_centr_freq_seg0_idx(
-		iface->conf, iface->radar_background.centr_freq_seg0_idx);
-	hostapd_set_oper_centr_freq_seg1_idx(
-		iface->conf, iface->radar_background.centr_freq_seg1_idx);
+	/* the CAC of the chain covered its own width, not the AP width */
+	hostapd_set_oper_chwidth(iface->conf, chwidth);
+	/* a failed request disabled the AP; the caller must not switch it */
+	if (hostapd_dfs_request_channel_switch(iface, channel, freq,
+					       secondary_channel,
+					       current_vht_oper_chwidth,
+					       seg0, seg1))
+		return 0;
+
+	/* a switch that every BSS refused restarted the AP on a channel of
+	 * its own choice */
+	if (hostapd_csa_in_progress(iface)) {
+		iface->conf->channel = channel;
+		iface->freq = freq;
+		iface->conf->secondary_channel = secondary_channel;
+		hostapd_set_oper_chwidth(iface->conf, chwidth);
+		hostapd_set_oper_centr_freq_seg0_idx(iface->conf, seg0);
+		hostapd_set_oper_centr_freq_seg1_idx(iface->conf, seg1);
+	}
 
 	hostapd_dfs_update_background_chain(iface);
 
-	return hostapd_dfs_request_channel_switch(
-		iface, iface->conf->channel, iface->freq,
-		iface->conf->secondary_channel, current_vht_oper_chwidth,
-		hostapd_get_oper_centr_freq_seg0_idx(iface->conf),
-		hostapd_get_oper_centr_freq_seg1_idx(iface->conf));
+	return 0;
 }
 
 
