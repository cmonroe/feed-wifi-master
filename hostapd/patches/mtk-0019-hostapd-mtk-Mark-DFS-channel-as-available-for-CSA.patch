From 5832d4ddc23f535932b590f5e8d16c349b4c4a51 Mon Sep 17 00:00:00 2001
From: "himanshu.goyal" <himanshu.goyal@mediatek.com>
Date: Fri, 3 Mar 2023 12:45:42 +0800
Subject: [PATCH 19/28] hostapd: mtk: Mark DFS channel as available for CSA.

The skip_cac option of the chan_switch control command asks the
kernel to switch to a DFS channel without a CAC. The kernel marks the
channel available only when it accepts the switch, and it refuses a
channel in non-occupancy.

hostapd does not run its own CAC for a skip_cac request. It marks the
channel available in its own list only after the kernel accepts the
switch. If the kernel refuses, hostapd and the kernel keep the old
channel state.

Co-developed-by: Chad Monroe <chad@monroe.io>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 hostapd/ctrl_iface.c   | 17 +++++++++++++++--
 hostapd/hostapd_cli.c  |  2 +-
 src/ap/ctrl_iface_ap.c |  2 ++
 3 files changed, 18 insertions(+), 3 deletions(-)

--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -2561,7 +2561,7 @@ static int hostapd_ctrl_iface_chan_switc
 		dfs_range += hostapd_is_dfs_overlap(
 			iface, bandwidth, settings.freq_params.center_freq2);
 
-	if (dfs_range) {
+	if (dfs_range && !settings.freq_params.radar_background) {
 		ret = ieee80211_freq_to_chan(settings.freq_params.freq, &chan);
 		if (ret == NUM_HOSTAPD_MODES) {
 			wpa_printf(MSG_ERROR,
@@ -2607,7 +2607,20 @@ static int hostapd_ctrl_iface_chan_switc
 		}
 	}
 
-	return (iface->num_bss == num_err) ? ret : 0;
+	if (iface->num_bss == num_err)
+		return ret;
+
+	/* The kernel skips the CAC only for a switch that it accepts */
+	if (settings.freq_params.radar_background)
+		hostapd_dfs_sta_update_state(iface,
+			settings.freq_params.freq,
+			settings.freq_params.ht_enabled,
+			settings.freq_params.sec_channel_offset,
+			bandwidth, settings.freq_params.center_freq1,
+			settings.freq_params.center_freq2,
+			HOSTAPD_CHAN_DFS_AVAILABLE);
+
+	return 0;
 #else /* NEED_AP_MLME */
 	return -1;
 #endif /* NEED_AP_MLME */
--- a/hostapd/hostapd_cli.c
+++ b/hostapd/hostapd_cli.c
@@ -1816,7 +1816,7 @@ static const struct hostapd_cli_cmd host
 	  "<addr> = send QoS Map Configure frame" },
 	{ "chan_switch", hostapd_cli_cmd_chan_switch, NULL,
 	  "<cs_count> <freq> [sec_channel_offset=] [center_freq1=]\n"
-	  "  [center_freq2=] [bandwidth=] [blocktx] [ht|vht]\n"
+	  "  [center_freq2=] [bandwidth=] [blocktx] [ht|vht] [skip_cac]\n"
 	  "  = initiate channel switch announcement" },
 #ifdef CONFIG_IEEE80211AX
 	{ "color_change", hostapd_cli_cmd_color_change, NULL,
--- a/src/ap/ctrl_iface_ap.c
+++ b/src/ap/ctrl_iface_ap.c
@@ -1450,6 +1450,8 @@ int hostapd_parse_csa_settings(struct ho
 		return ret;
 	}
 
+	settings->freq_params.radar_background = !!os_strstr(pos, " skip_cac");
+
 	target_mode = get_target_hw_mode(iface, settings->freq_params.freq);
 	if (!target_mode) {
 		wpa_printf(MSG_DEBUG,
