From: colinw <colin.whittaker@adtran.com>
Date: Thu, 13 Aug 2026 12:43:34 -0700
Subject: [PATCH] hostapd: send WPS passphrase even when wpa_psk_file is set

With wpa_psk_file set, upstream WPS has no shared key to send, so an
enrollee with a display gets a random per-device PSK. Send the shared
key of the BSS instead: wpa_passphrase, or wpa_psk as hex. A wps=1
entry in wpa_psk_file for the enrollee still comes first.

hostapd prepends the wpa_psk_file entries and the WPS per-device PSKs
to the PSK list of the BSS, so the head of that list can be the key
of another station. Mark the entry that comes from wpa_passphrase or
wpa_psk, and give WPS only that entry. This also applies to the PSK
that an enrollee without a display receives. With no marked entry,
WPS sends no shared key and the enrollee gets a per-device PSK. That
is the case with wpa_psk_file alone. It is also the case with a
wpa_psk and a wpa_psk_file after RELOAD_WPA_PSK, from the next BSS
reload on, because RELOAD_WPA_PSK drops the configured wpa_psk.

Signed-off-by: colinw <colin.whittaker@adtran.com>
Co-developed-by: Chad Monroe <chad@monroe.io>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 hostapd/config_file.c |    1 +
 src/ap/ap_config.c    |    1 +
 src/ap/ap_config.h    |    1 +
 src/ap/wps_hostapd.c  |   47 +++++++++++++++++++++++++++++++++--------------
 wpa_supplicant/ap.c   |    1 +
 5 files changed, 37 insertions(+), 14 deletions(-)

--- a/src/ap/wps_hostapd.c
+++ b/src/ap/wps_hostapd.c
@@ -430,6 +430,7 @@ static int hapd_wps_reconfig_in_memory(s
 			    hexstr2bin((const char *) cred->key,
 				       bss->ssid.wpa_psk->psk, PMK_LEN) == 0) {
 				bss->ssid.wpa_psk->group = 1;
+				bss->ssid.wpa_psk->shared = 1;
 				os_free(bss->ssid.wpa_passphrase);
 				bss->ssid.wpa_passphrase = NULL;
 			}
@@ -1091,12 +1092,31 @@ static void hostapd_free_wps(struct wps_
 }
 
 
+/*
+ * wpa_psk_file and WPS prepend per-station entries to ssid->wpa_psk, so the
+ * head of the list can be the key of another station.
+ */
+static const struct hostapd_wpa_psk *
+hostapd_wps_shared_psk(const struct hostapd_ssid *ssid)
+{
+	const struct hostapd_wpa_psk *psk;
+
+	for (psk = ssid->wpa_psk; psk; psk = psk->next) {
+		if (psk->shared)
+			return psk;
+	}
+
+	return NULL;
+}
+
+
 int hostapd_init_wps(struct hostapd_data *hapd,
 		     struct hostapd_bss_config *conf)
 {
 	struct wps_context *wps;
 	struct wps_registrar_config cfg;
 	u8 *multi_ap_netw_key = NULL;
+	const struct hostapd_wpa_psk *shared_psk;
 
 	if (conf->wps_state == 0) {
 		hostapd_wps_clear_ies(hapd, 0);
@@ -1235,17 +1255,16 @@ int hostapd_init_wps(struct hostapd_data
 		wps->auth_types |= WPS_AUTH_OPEN;
 	}
 
-	if (conf->ssid.wpa_psk_file) {
-		/* Use per-device PSKs */
-	} else if (conf->ssid.wpa_passphrase) {
+	shared_psk = hostapd_wps_shared_psk(&conf->ssid);
+	if (conf->ssid.wpa_passphrase) {
 		wps->network_key = (u8 *) os_strdup(conf->ssid.wpa_passphrase);
 		wps->network_key_len = os_strlen(conf->ssid.wpa_passphrase);
-	} else if (conf->ssid.wpa_psk) {
+	} else if (shared_psk) {
 		wps->network_key = os_malloc(2 * PMK_LEN + 1);
 		if (wps->network_key == NULL)
 			goto fail;
 		wpa_snprintf_hex((char *) wps->network_key, 2 * PMK_LEN + 1,
-				 conf->ssid.wpa_psk->psk, PMK_LEN);
+				 shared_psk->psk, PMK_LEN);
 		wps->network_key_len = 2 * PMK_LEN;
 #ifdef CONFIG_WEP
 	} else if (conf->ssid.wep.keys_set && conf->ssid.wep.key[0]) {
@@ -1258,8 +1277,8 @@ int hostapd_init_wps(struct hostapd_data
 #endif /* CONFIG_WEP */
 	}
 
-	if (conf->ssid.wpa_psk) {
-		os_memcpy(wps->psk, conf->ssid.wpa_psk->psk, PMK_LEN);
+	if (shared_psk) {
+		os_memcpy(wps->psk, shared_psk->psk, PMK_LEN);
 		wps->psk_set = 1;
 	}
 
@@ -1463,6 +1482,7 @@ void hostapd_update_wps(struct hostapd_d
 {
 	struct wps_context *wps = hapd->wps;
 	struct hostapd_bss_config *conf = hapd->conf;
+	const struct hostapd_wpa_psk *shared_psk;
 
 	if (!wps)
 		return;
@@ -1483,19 +1503,18 @@ void hostapd_update_wps(struct hostapd_d
 	wps->network_key = NULL;
 	wps->network_key_len = 0;
 	wps->psk_set = 0;
-	if (conf->ssid.wpa_psk_file) {
-		/* Use per-device PSKs */
-	} else if (conf->ssid.wpa_passphrase) {
+	shared_psk = hostapd_wps_shared_psk(&conf->ssid);
+	if (conf->ssid.wpa_passphrase) {
 		wps->network_key = (u8 *) os_strdup(conf->ssid.wpa_passphrase);
 		if (!wps->network_key)
 			return;
 		wps->network_key_len = os_strlen(conf->ssid.wpa_passphrase);
-	} else if (conf->ssid.wpa_psk) {
+	} else if (shared_psk) {
 		wps->network_key = os_malloc(2 * PMK_LEN + 1);
 		if (!wps->network_key)
 			return;
 		wpa_snprintf_hex((char *) wps->network_key, 2 * PMK_LEN + 1,
-				 conf->ssid.wpa_psk->psk, PMK_LEN);
+				 shared_psk->psk, PMK_LEN);
 		wps->network_key_len = 2 * PMK_LEN;
 #ifdef CONFIG_WEP
 	} else if (conf->ssid.wep.keys_set && conf->ssid.wep.key[0]) {
@@ -1508,8 +1527,8 @@ void hostapd_update_wps(struct hostapd_d
 #endif /* CONFIG_WEP */
 	}
 
-	if (conf->ssid.wpa_psk) {
-		os_memcpy(wps->psk, conf->ssid.wpa_psk->psk, PMK_LEN);
+	if (shared_psk) {
+		os_memcpy(wps->psk, shared_psk->psk, PMK_LEN);
 		wps->psk_set = 1;
 	}
 
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3095,6 +3095,7 @@ static int hostapd_config_fill(struct ho
 			return 1;
 		}
 		bss->ssid.wpa_psk->group = 1;
+		bss->ssid.wpa_psk->shared = 1;
 		os_free(bss->ssid.wpa_passphrase);
 		bss->ssid.wpa_passphrase = NULL;
 		bss->ssid.wpa_psk_set = 1;
--- a/src/ap/ap_config.c
+++ b/src/ap/ap_config.c
@@ -495,6 +495,7 @@ static int hostapd_derive_psk(struct hos
 	}
 	wpa_hexdump_key(MSG_DEBUG, "PSK (from passphrase)",
 			ssid->wpa_psk->psk, PMK_LEN);
+	ssid->wpa_psk->shared = 1;
 	return 0;
 }
 
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -164,6 +164,7 @@ struct hostapd_sta_wpa_psk_short {
 struct hostapd_wpa_psk {
 	struct hostapd_wpa_psk *next;
 	int group;
+	int shared; /* from wpa_passphrase or wpa_psk, not from a file or WPS */
 	char keyid[KEYID_LEN];
 	int wps;
 	u8 psk[PMK_LEN];
--- a/wpa_supplicant/ap.c
+++ b/wpa_supplicant/ap.c
@@ -601,6 +601,7 @@ static int wpa_supplicant_conf_ap(struct
 			return -1;
 		os_memcpy(bss->ssid.wpa_psk->psk, ssid->psk, PMK_LEN);
 		bss->ssid.wpa_psk->group = 1;
+		bss->ssid.wpa_psk->shared = 1;
 		bss->ssid.wpa_psk_set = 1;
 	} else if (ssid->passphrase) {
 		bss->ssid.wpa_passphrase = os_strdup(ssid->passphrase);
