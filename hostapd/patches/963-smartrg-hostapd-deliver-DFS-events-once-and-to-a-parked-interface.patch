From: Chad Monroe <chad@monroe.io>
Date: Thu, 08 Oct 2026 18:02:59 -0700
Subject: [PATCH] hostapd: deliver DFS events once and to a parked interface

An interface that waits in the DFS state for the end of a
Non-Occupancy Period has no link frequency. A NOP finished event goes
only to a BSS whose link frequency matches it or is in the 5 GHz
band, so the AP stays down. Both waits in the DFS setup, also the
channel-follow wait, now give the driver the frequency of the waiting
interface. When an AP MLD has added links, the driver sets the
frequency only on an added link, because it would otherwise overwrite
the first link. The wait follows mtk-openwrt-feeds ac18972d24e5
("[openwrt-25][MAC80211][WiFi7][critical patch][hostapd: fix DFS
bootup radar detection issues]") without its bandwidth fallback,
which lowers the configured width.

An event that matches no link frequency goes to every BSS in the
5 GHz band. The BSSs of one interface share its DFS state, so a
background chain event or a NOP end runs once per BSS. A repeated
background CAC abort then counts as an abort of the main CAC and
clears a channel switch in progress. Each link frequency now gets
such an event once, so the links of an AP MLD on different radios
still get one each. A handler can deinit the driver, so the delivery
stops when the driver or the BSS is gone.

Co-developed-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 src/ap/ap_drv_ops.c                |   17 +++++++++++
 src/ap/ap_drv_ops.h                |    1 
 src/ap/dfs.c                       |    4 +-
 src/drivers/driver.h               |   13 +++++++++
 src/drivers/driver_nl80211.c       |   26 ++++++++++++++++++
 src/drivers/driver_nl80211_event.c |   39 ++++++++++++++++++++++++++-
 6 files changed, 97 insertions(+), 3 deletions(-)

--- a/src/ap/ap_drv_ops.c
+++ b/src/ap/ap_drv_ops.c
@@ -1161,6 +1161,23 @@ int hostapd_start_dfs_cac(struct hostapd
 }
 
 
+int hostapd_wait_dfs_nop(struct hostapd_iface *iface, int freq)
+{
+	struct hostapd_data *hapd = iface->bss[0];
+	s8 link_id = -1;
+
+	if (!hapd->driver || !hapd->driver->wait_dfs_nop)
+		return 0;
+
+#ifdef CONFIG_IEEE80211BE
+	if (hapd->conf->mld_ap)
+		link_id = hapd->mld_link_id;
+#endif /* CONFIG_IEEE80211BE */
+
+	return hapd->driver->wait_dfs_nop(hapd->drv_priv, link_id, freq);
+}
+
+
 int hostapd_drv_set_qos_map(struct hostapd_data *hapd,
 			    const u8 *qos_map_set, u8 qos_map_set_len)
 {
--- a/src/ap/ap_drv_ops.h
+++ b/src/ap/ap_drv_ops.h
@@ -146,6 +146,7 @@ int hostapd_start_dfs_cac(struct hostapd
 			  int sec_channel_offset, int oper_chwidth,
 			  int center_segment0, int center_segment1,
 			  bool radar_background);
+int hostapd_wait_dfs_nop(struct hostapd_iface *iface, int freq);
 int hostapd_drv_do_acs(struct hostapd_data *hapd);
 int hostapd_drv_update_dh_ie(struct hostapd_data *hapd, const u8 *peer,
 			     u16 reason_code, const u8 *ie, size_t ielen);
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -936,11 +936,11 @@ int hostapd_handle_dfs(struct hostapd_if
 				wpa_printf(MSG_INFO,
 					   "DFS channel_follow: followed channel unavailable, waiting instead of relocating");
 				hostapd_set_state(iface, HAPD_IFACE_DFS);
-				return 0;
+				return hostapd_wait_dfs_nop(iface, iface->freq);
 			}
 			if (dfs_set_valid_channel(iface, skip_radar) < 0) {
 				hostapd_set_state(iface, HAPD_IFACE_DFS);
-				return 0;
+				return hostapd_wait_dfs_nop(iface, iface->freq);
 			}
 		}
 	} while (res);
--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -5137,6 +5137,19 @@ struct wpa_driver_ops {
 	int (*start_dfs_cac)(void *priv, struct hostapd_freq_params *freq);
 
 	/**
+	 * wait_dfs_nop - Receive the DFS events of a channel that is in NOP
+	 * @priv: Private driver interface data
+	 * @link_id: Link ID of the specified link; -1 for non-MLD
+	 * @freq: Channel frequency
+	 * Returns: 0 on success, -1 on failure
+	 *
+	 * This optional function is used when the AP waits in the DFS state
+	 * for the end of the Non-Occupancy Period. It associates the BSS
+	 * with the frequency, so that the NOP finished event reaches it.
+	 */
+	int (*wait_dfs_nop)(void *priv, s8 link_id, int freq);
+
+	/**
 	 * stop_ap - Removes beacon from AP
 	 * @priv: Private driver interface data
 	 * @link_id: Link ID of the specified link; -1 for non-MLD
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -11637,6 +11637,31 @@ static int nl80211_start_radar_detection
 	return -1;
 }
 
+
+static int nl80211_wait_dfs_nop(void *priv, s8 link_id, int freq)
+{
+	struct i802_bss *bss = priv;
+
+	if (!(bss->drv->capa.flags & WPA_DRIVER_FLAGS_RADAR)) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Driver does not support radar detection");
+		return -1;
+	}
+
+	/* nl80211_get_link() would return the first link, which another link
+	 * of the MLD can own */
+	if (link_id >= 0 && bss->valid_links &&
+	    !nl80211_link_valid(bss->valid_links, link_id)) {
+		wpa_printf(MSG_INFO,
+			   "nl80211: Link %d not added, cannot wait for the NOP end",
+			   link_id);
+		return -1;
+	}
+
+	nl80211_link_set_freq(bss, link_id, freq);
+	return 0;
+}
+
 #ifdef CONFIG_TDLS
 
 static int nl80211_add_peer_capab(struct nl_msg *msg,
@@ -16916,6 +16941,7 @@ const struct wpa_driver_ops wpa_driver_n
 	.poll_client = nl80211_poll_client,
 	.set_p2p_powersave = nl80211_set_p2p_powersave,
 	.start_dfs_cac = nl80211_start_radar_detection,
+	.wait_dfs_nop = nl80211_wait_dfs_nop,
 	.stop_ap = wpa_driver_nl80211_stop_ap,
 #ifdef CONFIG_TDLS
 	.send_tdls_mgmt = nl80211_send_tdls_mgmt,
--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -2755,9 +2755,39 @@ static void nl80211_process_radar_event(
 }
 
 
+/*
+ * The BSSs of one interface share its frequency and its DFS state, so a link
+ * frequency that an earlier BSS or link has already received the event for
+ * must not get it again.
+ */
+static bool nl80211_radar_freq_done(struct i802_bss *bss, int link_id)
+{
+	struct i802_bss *iter;
+	int i;
+
+	for (iter = bss->drv->first_bss; iter; iter = iter->next) {
+		for_each_link_default(iter->valid_links, i, 0) {
+			if (iter == bss && i == link_id)
+				return false;
+			if (iter->links[i].freq == bss->links[link_id].freq)
+				return true;
+		}
+	}
+
+	return false;
+}
+
+
+static bool nl80211_drv_in_list(struct nl80211_global *global,
+				unsigned int unique_drv_id);
+static bool nl80211_bss_in_drv(struct wpa_driver_nl80211_data *drv,
+			       struct i802_bss *bss);
+
 static void nl80211_radar_event(struct i802_bss *bss, struct nlattr **tb)
 {
 	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl80211_global *global = drv->global;
+	unsigned int unique_drv_id = drv->unique_drv_id;
 	union wpa_event_data data;
 	enum nl80211_radar_event event_type;
 	struct i802_bss *bss_iter;
@@ -2833,7 +2863,8 @@ static void nl80211_radar_event(struct i
 		 */
 		for_each_link_default(bss_iter->valid_links, i, 0) {
 			if (bss_iter->links[i].freq < 5180 ||
-			    bss_iter->links[i].freq > 5900)
+			    bss_iter->links[i].freq > 5900 ||
+			    nl80211_radar_freq_done(bss_iter, i))
 				continue;
 
 			data.dfs_event.link_id = bss_iter->valid_links ?
@@ -2850,6 +2881,12 @@ static void nl80211_radar_event(struct i
 						    event_type);
 
 			hit = true;
+
+			/* the handler can deinit the driver, which frees drv
+			 * and its BSSs */
+			if (!nl80211_drv_in_list(global, unique_drv_id) ||
+			    !nl80211_bss_in_drv(drv, bss_iter))
+				return;
 		}
 	}
 
