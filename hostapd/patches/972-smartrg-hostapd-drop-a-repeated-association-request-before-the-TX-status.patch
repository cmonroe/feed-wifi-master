From: Koral Ilgun <koral.ilgun@smartrg.com>
Date: Sun, 11 Oct 2026 19:38:42 -0700
Subject: [PATCH] hostapd: drop a repeated association request before the TX status

A non-AP STA that does not receive the (Re)Association Response frame
in time sends its request again, with a new sequence number. The check
for a repeated frame catches only a retry with the same sequence
number, so the AP processed the request again and replaced the STA
entry in the driver. A driver that reports the pending frames of a
removed STA as not acknowledged then reported the first response as
failed, and the AP removed the new entry. The STA had the first
response and considered itself associated, but the driver had no entry
for it.

Drop a (Re)Association Request frame while the response to the
previous one waits for its TX status. A new authentication or a new FT
request over the DS ends this state, and so does one second without a
TX status.
---
 src/ap/ieee802_11.c    |   32 ++++++++++++++++++++++++++++++++
 src/ap/sta_info.h      |    7 +++++++
 src/ap/wpa_auth_glue.c |    1 +
 3 files changed, 40 insertions(+)

--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -4555,6 +4555,7 @@ static void handle_auth(struct hostapd_d
 	if (sta) {
 		sta->flags &= ~WLAN_STA_PENDING_FILS_ERP;
 		sta->ft_over_ds = 0;
+		sta->assoc_resp_pending = 0;
 		if ((fc & WLAN_FC_RETRY) &&
 		    sta->last_seq_ctrl != WLAN_INVALID_MGMT_SEQ &&
 		    sta->last_seq_ctrl == seq_ctrl &&
@@ -7649,6 +7650,28 @@ static void handle_assoc(struct hostapd_
 	sta->last_subtype = reassoc ? WLAN_FC_STYPE_REASSOC_REQ :
 		WLAN_FC_STYPE_ASSOC_REQ;
 
+	if (sta->assoc_resp_pending) {
+		struct os_reltime now, age;
+
+		os_get_reltime(&now);
+		os_reltime_sub(&now, &sta->assoc_resp_time, &age);
+		if (age.sec == 0) {
+			/*
+			 * The STA did not get the response in time and sent its
+			 * request again. The STA entry is in the driver for
+			 * the pending response. To process the request again
+			 * would replace that entry, and the driver would then
+			 * report the pending response as not acknowledged.
+			 */
+			hostapd_logger(hapd, sta->addr,
+				       HOSTAPD_MODULE_IEEE80211,
+				       HOSTAPD_LEVEL_DEBUG,
+				       "Drop repeated association frame - response is pending");
+			return;
+		}
+		sta->assoc_resp_pending = 0;
+	}
+
 	if (hapd->tkip_countermeasures) {
 		resp = WLAN_STATUS_UNSPECIFIED_FAILURE;
 		goto fail;
@@ -7940,6 +7963,12 @@ static void handle_assoc(struct hostapd_
 					    mgmt->sa, resp, reassoc,
 					    pos, left, rssi, omit_rsnxe);
 
+	if (sta && resp == WLAN_STATUS_SUCCESS &&
+	    reply_res == WLAN_STATUS_SUCCESS) {
+		sta->assoc_resp_pending = 1;
+		os_get_reltime(&sta->assoc_resp_time);
+	}
+
 	if (set_beacon)
 		ieee802_11_update_beacons(hapd->iface);
 
@@ -8824,6 +8853,9 @@ static void handle_assoc_cb(struct hosta
 	else
 		status = le_to_host16(mgmt->u.assoc_resp.status_code);
 
+	if (status == WLAN_STATUS_SUCCESS)
+		sta->assoc_resp_pending = 0;
+
 	if (!ok) {
 		hostapd_logger(hapd, mgmt->da, HOSTAPD_MODULE_IEEE80211,
 			       HOSTAPD_LEVEL_DEBUG,
--- a/src/ap/sta_info.h
+++ b/src/ap/sta_info.h
@@ -169,6 +169,9 @@ struct sta_info {
 	unsigned int agreed_to_steer:1;
 	unsigned int hs20_t_c_filtering:1;
 	unsigned int ft_over_ds:1;
+	/* (Re)Association Response frame with a success status waits for its
+	 * TX status */
+	unsigned int assoc_resp_pending:1;
 	unsigned int external_dh_updated:1;
 	unsigned int post_csa_sa_query:1;
 
@@ -264,6 +267,10 @@ struct sta_info {
 	/* valid only if session_timeout_set == 1 */
 	struct os_reltime session_timeout;
 
+	/* Time of the (Re)Association Response frame that assoc_resp_pending
+	 * refers to */
+	struct os_reltime assoc_resp_time;
+
 	/* Last Authentication/(Re)Association Request/Action frame sequence
 	 * control */
 	u16 last_seq_ctrl;
--- a/src/ap/wpa_auth_glue.c
+++ b/src/ap/wpa_auth_glue.c
@@ -1298,6 +1298,7 @@ hostapd_wpa_auth_add_sta(void *ctx, cons
 		sta->added_unassoc = 1;
 
 	sta->ft_over_ds = 1;
+	sta->assoc_resp_pending = 0;
 	if (sta->wpa_sm) {
 		sta->auth_alg = WLAN_AUTH_FT;
 		return sta->wpa_sm;
