+	static const struct bitfield_descriptor supported_mcs_set[] = {
+		// { "rx_mcs_bitmask", 0, 77 },
+		// { "reserved", 77, 3 },
+		{ "rx_highest_data_rate", 80, 10 }
+		// { "reserved", 90, 6 },
+		// { "tx_mcs_set_defined", 96, 1 },
+		// { "tx_rx_mcs_set_not_equal", 97, 1 },
