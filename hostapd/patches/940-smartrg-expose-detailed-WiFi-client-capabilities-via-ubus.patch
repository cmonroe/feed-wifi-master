+static uint16_t bitfield_value_get(uint8_t *data, uint8_t bit_start, uint8_t bit_count)
+{
+	uint16_t value = 0;
+	uint8_t bit_end = bit_start + bit_count - 1;
+	uint8_t byte_idx = bit_end / 8;
+	uint8_t bit_mask = 1 << (bit_end % 8);
+
+	while (bit_count--) {
+		value = (value << 1) | !!(data[byte_idx] & bit_mask);
+		bit_mask = (bit_mask >> 1) & 0x7f;
+		if (!bit_mask) {
+			bit_mask = 0x80;
+			byte_idx--;
+		}
+	}
+	return value;
 }
 
 static void
-hostapd_parse_capab_blobmsg(struct sta_info *sta)
+capab_table_add(const char *table_name, const bitfield_descriptor *capas,
+		uint8_t capas_len, uint8_t *data, bool filter_false)
 {
-	void *r, *v;
+	void *table = table_name ? blobmsg_open_table(&b, table_name) : NULL;
 
-	v = blobmsg_open_table(&b, "capabilities");
+	for (int i = 0; i < capas_len; i++) {
+		if (capas[i].bitcount > 1) {
+			uint32_t val = bitfield_value_get(data, capas[i].bitstart, capas[i].bitcount);
+			blobmsg_add_u32(&b, capas[i].name, val);
+			continue;
+		}
+
+		uint8_t byte_idx = capas[i].bitstart / 8;
+		uint8_t bit_mask = 1 << (capas[i].bitstart % 8);
+		uint8_t bit_val = !!(data[byte_idx] & bit_mask);
+
+		if (filter_false && !bit_val)
+			continue;
+
+		blobmsg_add_u8(&b, capas[i].name, bit_val);
+	}
+
+	if (table_name)
+		blobmsg_close_table(&b, table);
+}
