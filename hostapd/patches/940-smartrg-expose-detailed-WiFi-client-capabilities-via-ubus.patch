+static void
+sta_vendors_add(struct sta_info *sta)
+{
+	void *table = blobmsg_open_table(&b, "vendors");
+	const struct element *elem;
+	const u8 *ie_buf;
+
+	if (!sta->vendors_ie)
+		goto out;
+
+	ie_buf = wpabuf_head_u8(sta->vendors_ie);
+	for_each_element(elem, ie_buf, sta->vendors_ie->used) {
+		const u8 *oui = elem->data;
+		const u8 *ie_data = elem->data + 3;
+		int data_len = elem->datalen - 3;
+		char oui_str[16];
+		char *out;
+
+		snprintf(oui_str, sizeof(oui_str), "%02x:%02x:%02x",
+			 oui[0], oui[1], oui[2]);
+		out = blobmsg_alloc_string_buffer(&b, oui_str, data_len * 2 + 1);
+		for (int i = 0; i < data_len; i++, out += 2)
+			sprintf(out, "%02x", ie_data[i]);
+		blobmsg_add_string_buffer(&b);
 	}
 
-	/* ToDo: Add HT / HE capability parsing */
+out:
+	blobmsg_close_table(&b, table);
+}
 
