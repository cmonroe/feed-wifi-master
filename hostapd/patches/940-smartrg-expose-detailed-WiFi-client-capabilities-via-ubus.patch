+		os_memset(&he_tmp, 0, sizeof(he_tmp));
+		os_memcpy(&he_tmp, elems->he_capabilities, elems->he_capabilities_len);
+		table = blobmsg_open_table(&b, "he");
+		he_capab_add(&he_tmp, filter_false);
+		blobmsg_close_table(&b, table);
