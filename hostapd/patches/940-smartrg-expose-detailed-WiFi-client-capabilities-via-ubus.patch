+	      struct ieee80211_he_capabilities *hec, int freq, bool filter_false)
+{
+	void *mcs_table;
+	u8 *ptr;
+	char str[2 + EHT_PPE_THRESH_CAPAB_LEN + 1];
+
+	static const struct bitfield_descriptor mac_capas[] = {
+		{ "epcs_priority_access", 0, 1 },
+		{ "eht_om_control", 1, 1 },
+		{ "txs_mode_1", 2, 1 },
+		{ "txs_mode_2", 3, 1 },
+		{ "restricted_twt", 4, 1 },
+		{ "scs_traffic_descr", 5, 1 },
+		{ "max_mpdu_len", 6, 2 },
+		{ "max_a-mpdu_len_exp", 8, 1 },
+		{ "eht_trs", 9, 1 },
+		{ "txop_return", 10, 1 },
