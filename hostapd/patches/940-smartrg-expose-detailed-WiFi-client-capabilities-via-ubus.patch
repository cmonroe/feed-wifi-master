+static void
+ht_mcs_map_add(uint8_t *mcs_bitmask, uint8_t nss, bool ueqm)
+{
+	static const ht_mcs_t ht_mcs[] = {
+		{ "1ss",  0,  7 },
+		{ "2ss",  8, 15 },
+		{ "3ss", 16, 23 },
+		{ "4ss", 24, 31 },
+		{ "1ss",  0,  7 },
+		{ "2ss", 33, 38 },
+		{ "3ss", 39, 52 },
+		{ "4ss", 53, 76 },
+		{ "1ss", 32, 32 }
+	};
+	int mcs_idx = ueqm ? 4 : 0;
+
+	for (int i = 0; i < nss; i++, mcs_idx++) {
+		const ht_mcs_t *mcs = &ht_mcs[mcs_idx];
+		uint8_t byte_idx = mcs->max_mcs / 8;
+		uint8_t bit_mask = 1 << (mcs->max_mcs % 8);
+		int value = -1;
+
+		for (int j = mcs->max_mcs; j >= mcs->min_mcs; j--) {
+			if (mcs_bitmask[byte_idx] & bit_mask) {
+				value = j;
+				break;
+			}
+			bit_mask = (bit_mask >> 1) & 0x7f;
+			if (!bit_mask) {
+				bit_mask = 0x80;
+				byte_idx--;
+			}
+		}
+
+		if (i == 0 && (mcs_bitmask[4] & 0x01))
+			value = HT_MCS_32;
+
+		blobmsg_add_u16(&b, mcs->name, value);
+	}
+}
