+		   elems->eht_capabilities_len >= IEEE80211_EHT_CAPAB_MIN_LEN &&
+		   elems->eht_capabilities_len <= sizeof(struct ieee80211_eht_capabilities)) {
+		struct ieee80211_he_capabilities he_tmp;
