+
+enum dfs_mode {
+	DFS_DETECT_MODE_DISABLE,
+	DFS_DETECT_MODE_AP_ENABLE,
+	DFS_DETECT_MODE_BACKGROUND_ENABLE,
+	DFS_DETECT_MODE_ALL_ENABLE,
+
+	/* keep last */
+	NUM_DFS_DETECT_MODE,
+	DFS_DETECT_MODE_MAX =
+		NUM_DFS_DETECT_MODE - 1
 };
 
 enum edcca_mode {
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1780,6 +1780,77 @@ static int dfs_follow_radar_detected(str
 }
 
 
+/* A detect mode keeps only the chain that saw the radar on its channel */
+static bool dfs_detect_mode_skip(struct hostapd_iface *iface, int freq)
+{
+	switch (iface->conf->dfs_detect_mode) {
+	case DFS_DETECT_MODE_ALL_ENABLE:
+		return true;
+	case DFS_DETECT_MODE_BACKGROUND_ENABLE:
+		return hostapd_dfs_is_background_event(iface, freq);
+	case DFS_DETECT_MODE_AP_ENABLE:
+		return !hostapd_dfs_is_background_event(iface, freq);
+	default:
+		return false;
+	}
+}
+
+
+/*
+ * The kernel keeps its own DFS state and refuses a beacon update on a
+ * channel it marked unavailable, so a held chain needs the same mode
+ * in the kernel. The file comes from the DFS test files of cfg80211.
+ */
+int hostapd_dfs_detect_mode_apply(struct hostapd_iface *iface,
+				  unsigned int mode)
+{
+	const char *phy = hostapd_drv_get_radio_name(iface->bss[0]);
+	char path[128];
+	FILE *f;
+	int ret = 0;
+
+	if (!phy) {
+		wpa_printf(MSG_ERROR,
+			   "DFS: no radio name for the detect mode file");
+		return -1;
+	}
+
+	os_snprintf(path, sizeof(path),
+		    "/sys/kernel/debug/ieee80211/%s/dfs_detect_mode", phy);
+	f = fopen(path, "w");
+	if (!f) {
+		if (errno == ENOENT) {
+			wpa_printf(MSG_INFO,
+				   "DFS: %s: the kernel has no detect mode file",
+				   path);
+			return 0;
+		}
+		wpa_printf(MSG_ERROR, "DFS: %s: %s", path, strerror(errno));
+		return -1;
+	}
+
+	if (fprintf(f, "%u\n", mode) < 0)
+		ret = -1;
+	if (fclose(f))
+		ret = -1;
+	if (ret)
+		wpa_printf(MSG_ERROR, "DFS: %s: %s", path, strerror(errno));
+
+	return ret;
+}
+
+
+void hostapd_dfs_detect_mode_clear(struct hostapd_iface *iface)
+{
+	/* a mesh setup that fails before its config reaches the deinit */
+	if (!iface->conf || !iface->conf->dfs_detect_mode || !iface->bss ||
+	    hostapd_is_dfs_required(iface) <= 0)
+		return;
+
+	hostapd_dfs_detect_mode_apply(iface, 0);
+}
+
+
 int hostapd_dfs_radar_detected(struct hostapd_iface *iface, int freq,
 			       int ht_enabled, int chan_offset, int chan_width,
 			       int cf1, int cf2)
@@ -1818,6 +1889,10 @@ int hostapd_dfs_radar_detected(struct ho
 						 chan_offset, chan_width,
 						 cf1, cf2);
 
+	/* a held chain keeps its channel available in the table as well */
+	if (dfs_detect_mode_skip(iface, freq))
+		return 0;
+
 	/* mark radar frequency as invalid */
 	if (!set_dfs_state(iface, freq, ht_enabled, chan_offset, chan_width,
 			   cf1, cf2, HOSTAPD_CHAN_DFS_UNAVAILABLE))
--- a/src/ap/dfs.h
+++ b/src/ap/dfs.h
@@ -12,6 +12,10 @@
 int hostapd_handle_dfs(struct hostapd_iface *iface);
 void hostapd_dfs_chain_drop(struct hostapd_iface *iface);
 
