From 246c1629481117413fd4648cdfc25f6fb24a5502 Mon Sep 17 00:00:00 2001
From: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Date: Mon, 20 Feb 2023 14:55:49 +0800
Subject: [PATCH 10/28] hostapd: mtk: Add DFS detection mode

Add DFS detection modes to test the radar detection rate. In a detect
mode, the chain that saw the radar stays on its channel: mode 1 holds
the AP channel, mode 2 the background chain, mode 3 both.

The mode applies after hostapd knows which chain saw the radar, so
the other chain acts on its radar as usual. In mode 2, a radar on the
AP channel still moves the AP. In mode 1, a radar on the AP channel
does not move the AP onto the background chain. The configuration
file and the DFS_DETECT_MODE command refuse a value that is not a
whole number from 0 to 3, and the previous mode stays.

Signed-off-by: StanleyYP Wang <StanleyYP.Wang@mediatek.com>
Co-developed-by: Chad Monroe <chad@monroe.io>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 hostapd/config_file.c | 12 ++++++++++++
 hostapd/ctrl_iface.c  | 25 +++++++++++++++++++++++++
 src/ap/ap_config.h    | 13 +++++++++++++
 src/ap/dfs.c          | 19 +++++++++++++++++++
 4 files changed, 69 insertions(+)

--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -5339,6 +5339,18 @@ static int hostapd_config_fill(struct ho
 			return 1;
 		}
 		conf->edcca_compensation = (s8) val;
+	} else if (os_strcmp(buf, "dfs_detect_mode") == 0) { /*bypass channel switch*/
+		char *end;
+		long mode = strtol(pos, &end, 10);
+
+		if (end == pos || *end || mode < 0 ||
+		    mode > DFS_DETECT_MODE_MAX) {
+			wpa_printf(MSG_ERROR,
+				   "Line %d: invalid dfs_detect_mode '%s'",
+				   line, pos);
+			return 1;
+		}
+		conf->dfs_detect_mode = mode;
 	} else {
 		wpa_printf(MSG_ERROR,
 			   "Line %d: unknown configuration item '%s'",
--- a/hostapd/ctrl_iface.c
+++ b/hostapd/ctrl_iface.c
@@ -4239,6 +4239,28 @@ static int hostapd_ctrl_afc_send_request
 #endif /* CONFIG_AFC */
 
 
+static int
+hostapd_ctrl_iface_set_dfs_detect_mode(struct hostapd_data *hapd, char *value,
+				       char *buf, size_t buflen)
+{
+	long dfs_detect_mode;
+	char *end;
+
+	if (!value)
+		return -1;
+
+	dfs_detect_mode = strtol(value, &end, 10);
+	if (end == value || *end || dfs_detect_mode < 0 ||
+	    dfs_detect_mode > DFS_DETECT_MODE_MAX) {
+		wpa_printf(MSG_ERROR, "Invalid value for dfs detect mode");
+		return -1;
+	}
+	hapd->iconf->dfs_detect_mode = dfs_detect_mode;
+
+	return os_snprintf(buf, buflen, "OK\n");
+}
+
+
 static int hostapd_ctrl_iface_receive_process(struct hostapd_data *hapd,
 					      char *buf, char *reply,
 					      int reply_size,
@@ -4887,6 +4909,9 @@ static int hostapd_ctrl_iface_receive_pr
 	} else if (os_strncmp(buf, "GET_EDCCA ", 10) == 0) {
 		reply_len = hostapd_ctrl_iface_get_edcca(hapd, buf+10, reply,
 							  reply_size);
+	} else if (os_strncmp(buf, "DFS_DETECT_MODE ", 16) == 0) {
+		reply_len = hostapd_ctrl_iface_set_dfs_detect_mode(hapd, buf + 16,
+								   reply, reply_size);
 	} else {
 		os_memcpy(reply, "UNKNOWN COMMAND\n", 16);
 		reply_len = 16;
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1368,6 +1368,19 @@ struct hostapd_config {
 	u8 edcca_enable;
 	s8 edcca_compensation;
 	int *edcca_threshold;
+	u8 dfs_detect_mode;
+};
+
+enum dfs_mode {
+	DFS_DETECT_MODE_DISABLE,
+	DFS_DETECT_MODE_AP_ENABLE,
+	DFS_DETECT_MODE_BACKGROUND_ENABLE,
+	DFS_DETECT_MODE_ALL_ENABLE,
+
+	/* keep last */
+	NUM_DFS_DETECT_MODE,
+	DFS_DETECT_MODE_MAX =
+		NUM_DFS_DETECT_MODE - 1
 };
 
 enum edcca_mode {
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1780,6 +1780,22 @@ static int dfs_follow_radar_detected(str
 }
 
 
+/* A detect mode keeps only the chain that saw the radar on its channel */
+static bool dfs_detect_mode_skip(struct hostapd_iface *iface, int freq)
+{
+	switch (iface->conf->dfs_detect_mode) {
+	case DFS_DETECT_MODE_ALL_ENABLE:
+		return true;
+	case DFS_DETECT_MODE_BACKGROUND_ENABLE:
+		return hostapd_dfs_is_background_event(iface, freq);
+	case DFS_DETECT_MODE_AP_ENABLE:
+		return !hostapd_dfs_is_background_event(iface, freq);
+	default:
+		return false;
+	}
+}
+
+
 int hostapd_dfs_radar_detected(struct hostapd_iface *iface, int freq,
 			       int ht_enabled, int chan_offset, int chan_width,
 			       int cf1, int cf2)
@@ -1830,6 +1846,9 @@ int hostapd_dfs_radar_detected(struct ho
 			return 0;
 	}
 
+	if (dfs_detect_mode_skip(iface, freq))
+		return 0;
+
 	if (hostapd_dfs_background_start_channel_switch(iface, freq)) {
 		/* Radar detected while operating, switch the channel. */
 		return hostapd_dfs_start_channel_switch(iface);
