+/* the test of the kernel: the primary channel of one chandef lies in the
+ * other
+ */
+static bool dfs_csa_overlaps_chain(struct hostapd_iface *iface,
+				   const struct hostapd_freq_params *target)
+{
+	int half = (target->bandwidth > 20 ? target->bandwidth : 20) / 2;
+	int freq = iface->radar_background.freq;
+
+	if (iface->radar_background.channel == -1)
+		return false;
+
+	if (abs(freq - target->center_freq1) < half ||
+	    (target->center_freq2 && abs(freq - target->center_freq2) < half))
+		return true;
+
+	return dfs_background_chandef_contains(iface, target->freq);
+}
