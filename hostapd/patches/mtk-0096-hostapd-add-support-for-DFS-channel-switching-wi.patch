+/* The kernel stops a chain without a running CAC that overlaps the target
+ * of an accepted CSA, and it sends no event for that chain.
+ */
+void hostapd_dfs_csa_started(struct hostapd_iface *iface,
+			     const struct hostapd_freq_params *target)
+{
+	if (iface->radar_background.cac_started ||
+	    !dfs_csa_overlaps_chain(iface, target))
+		return;
+
+	iface->radar_background.channel = -1;
+}
