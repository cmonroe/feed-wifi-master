From: Chad Monroe <chad@monroe.io>
Date: Fri, 07 Aug 2026 16:14:15 -0700
Subject: [PATCH] hostapd: honor selected channel on fallback restarts

Several paths restart the interface on a concrete target channel
after a radar or a failed CSA. On a channel=auto radio the restart
runs ACS again and drops the selected channel. The ACS scan extends
the outage, and an ACS failure leads to a radio restart by netifd.

Each of these restarts now sets the restart flag, so setup keeps the
selected channel, as upstream does for its DFS restart. The restart
after a radar with no channel left does not set the flag, because
ACS is the recovery there. Setup clears the flag at once, so a stale
flag cannot stop ACS on a later restart. mtk-openwrt-feeds
d575b5bbfd51 ("[MAC80211][WiFi6][hostapd][Backport hostapd ACS
patches and some ACS fixes]") clears the ACS setting instead. That
stops ACS for good, because a reload keeps the runtime value. A radar
restart also recomputes the operating class for a narrower width,
and restores the HT40 capability that a 20 MHz switch can clear.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 src/ap/dfs.c     |   79 +++++++++++++++++++++++++++++++++++++------------------
 src/ap/hostapd.c |   10 +++++-
 2 files changed, 62 insertions(+), 27 deletions(-)

--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1098,6 +1098,51 @@ int hostapd_is_dfs_chan_available(struct
 }
 
 
+static void dfs_restore_ht40_cap(struct hostapd_iface *iface,
+				 int secondary_channel)
+{
+	if ((!iface->current_mode ||
+	     (iface->current_mode->ht_capab &
+	      HT_CAP_INFO_SUPP_CHANNEL_WIDTH_SET)) &&
+	    secondary_channel)
+		iface->conf->ht_capab |= HT_CAP_INFO_SUPP_CHANNEL_WIDTH_SET;
+}
+
+
+/*
+ * Install a concrete restart target ahead of a disable/enable cycle:
+ * recompute op_class for the (possibly downgraded) width so setup does
+ * not force the old width back, restore the HT40 capability a prior
+ * 20 MHz ch_switch event may have cleared, and mark the restart so
+ * setup_interface2() does not re-run ACS.
+ */
+static void dfs_apply_chandef(struct hostapd_iface *iface, int freq,
+			      int channel, int secondary_channel,
+			      enum oper_chan_width oper_chwidth,
+			      u8 seg0_idx, u8 seg1_idx)
+{
+	u8 op_class, chan;
+
+	iface->freq = freq;
+	iface->conf->channel = channel;
+	iface->conf->secondary_channel = secondary_channel;
+	hostapd_set_oper_chwidth(iface->conf, oper_chwidth);
+	hostapd_set_oper_centr_freq_seg0_idx(iface->conf, seg0_idx);
+	hostapd_set_oper_centr_freq_seg1_idx(iface->conf, seg1_idx);
+
+	if (ieee80211_freq_to_channel_ext(freq, secondary_channel, oper_chwidth,
+					  &op_class, &chan) !=
+	    NUM_HOSTAPD_MODES) {
+		wpa_printf(MSG_DEBUG, "Update op_class %d->%d",
+			   iface->conf->op_class, op_class);
+		iface->conf->op_class = op_class;
+	}
+
+	dfs_restore_ht40_cap(iface, secondary_channel);
+	iface->is_ch_switch_dfs = true;
+}
+
+
 static int hostapd_dfs_request_channel_switch(struct hostapd_iface *iface,
 					      int channel, int freq,
 					      int secondary_channel,
@@ -1176,23 +1221,10 @@ static int hostapd_dfs_request_channel_s
 		wpa_printf(MSG_WARNING,
 			   "DFS failed to schedule CSA (%d) - trying fallback",
 			   err);
-		iface->freq = freq;
-		iface->conf->channel = channel;
-		iface->conf->secondary_channel = secondary_channel;
-		hostapd_set_oper_chwidth(iface->conf, new_vht_oper_chwidth);
-		hostapd_set_oper_centr_freq_seg0_idx(iface->conf,
-						     oper_centr_freq_seg0_idx);
-		hostapd_set_oper_centr_freq_seg1_idx(iface->conf,
-						     oper_centr_freq_seg1_idx);
-		if (ieee80211_freq_to_channel_ext(freq, secondary_channel,
-						  new_vht_oper_chwidth,
-						  &op_class, &chan) !=
-		    NUM_HOSTAPD_MODES) {
-			wpa_printf(MSG_DEBUG, "Update op_class %d->%d",
-				   iface->conf->op_class, op_class);
-			iface->conf->op_class = op_class;
-		}
-
+		dfs_apply_chandef(iface, freq, channel, secondary_channel,
+				  new_vht_oper_chwidth,
+				  oper_centr_freq_seg0_idx,
+				  oper_centr_freq_seg1_idx);
 		hostapd_disable_iface(iface);
 		hostapd_enable_iface(iface);
 
@@ -1759,14 +1791,11 @@ static int hostapd_dfs_start_channel_swi
 		}
 
 		if (channel_type == DFS_ANY_CHANNEL) {
-			iface->freq = channel->freq;
-			iface->conf->channel = channel->chan;
-			iface->conf->secondary_channel = secondary_channel;
-			hostapd_set_oper_centr_freq_seg0_idx(
-				iface->conf, oper_centr_freq_seg0_idx);
-			hostapd_set_oper_centr_freq_seg1_idx(
-				iface->conf, oper_centr_freq_seg1_idx);
-
+			dfs_apply_chandef(iface, channel->freq, channel->chan,
+					  secondary_channel,
+					  hostapd_get_oper_chwidth(iface->conf),
+					  oper_centr_freq_seg0_idx,
+					  oper_centr_freq_seg1_idx);
 			hostapd_disable_iface(iface);
 			hostapd_enable_iface(iface);
 			return 0;
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -2636,6 +2636,12 @@ static void hostapd_set_6ghz_sec_chan(st
 
 static int setup_interface2(struct hostapd_iface *iface)
 {
+	bool ch_switch_dfs = iface->is_ch_switch_dfs;
+
+	/* Consume the one-shot restart marker even if the feature query
+	 * below fails, so a stale flag cannot suppress ACS on an
+	 * unrelated later restart. */
+	iface->is_ch_switch_dfs = false;
 	iface->wait_channel_update = 0;
 	iface->is_no_ir = false;
 
@@ -2645,11 +2651,10 @@ static int setup_interface2(struct hosta
 	} else {
 		int ret;
 
-		if (iface->conf->acs && !iface->is_ch_switch_dfs) {
+		if (iface->conf->acs && !ch_switch_dfs) {
 			iface->freq = 0;
 			iface->conf->channel = 0;
 		}
-		iface->is_ch_switch_dfs = false;
 
 		ret = configured_fixed_chan_to_freq(iface);
 		if (ret < 0)
@@ -5595,6 +5600,7 @@ hostapd_switch_channel_fallback(struct h
 	 * argument may actually point to one of these.
 	 * These params will be cleared during interface disable below.
 	 */
+	iface->is_ch_switch_dfs = true;
 	hostapd_disable_iface(iface);
 	hostapd_enable_iface(iface);
 }
