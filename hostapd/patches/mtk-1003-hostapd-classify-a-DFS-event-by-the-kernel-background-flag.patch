--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -1339,11 +1339,9 @@ hostapd_is_freq_in_current_hw_info(struc
 
 
 static bool
-hostapd_dfs_is_background_event(struct hostapd_iface *iface, int freq)
+hostapd_dfs_is_background_event(struct hostapd_iface *iface, bool background)
 {
-	return dfs_use_radar_background(iface) &&
-		iface->radar_background.channel != -1 &&
-		iface->radar_background.freq == freq;
+	return dfs_use_radar_background(iface) && background;
 }
 
 
@@ -1393,6 +1391,66 @@ static bool dfs_background_overlaps_ap(s
 }
 
 
+/* The record of the chain from a kernel event. A wide event carries no
+ * offset; calculate_chan_offset() rule. */
+static void dfs_chain_record_set(struct hostapd_iface *iface, int freq,
+				 u8 chan, int chan_offset,
+				 enum chan_width chan_width, int cf1, int cf2)
+{
+	int sec = chan_offset, half = 0;
+
+	switch (chan_width) {
+	case CHAN_WIDTH_80:
+	case CHAN_WIDTH_80P80:
+		half = 40;
+		break;
+	case CHAN_WIDTH_160:
+		half = 80;
+		break;
+	default:
+		break;
+	}
+	if (half)
+		sec = (abs(freq - (cf1 - half + 10)) / 20) % 2 == 0 ? 1 : -1;
+
+	iface->radar_background.freq = freq;
+	iface->radar_background.channel = chan;
+	iface->radar_background.secondary_channel = sec;
+	iface->radar_background.chwidth =
+		chan_width_to_oper_chwidth(chan_width);
+	iface->radar_background.centr_freq_seg0_idx = (cf1 - 5000) / 5;
+	iface->radar_background.centr_freq_seg1_idx = cf2 ? (cf2 - 5000) / 5 : 0;
+	iface->radar_background.owner = iface->bss[0];
+}
+
+
+/* The kernel runs a chain that hostapd holds no record of, for example
+ * after a chain search found no channel while the request of the chain
+ * was already out. The events of that chain restore the record. */
+static void dfs_chain_adopt(struct hostapd_iface *iface, int freq,
+			    int chan_offset, enum chan_width chan_width,
+			    int cf1, int cf2)
+{
+	u8 chan;
+
+	if (iface->radar_background.channel != -1 ||
+	    ieee80211_freq_to_chan(freq, &chan) == NUM_HOSTAPD_MODES)
+		return;
+
+	/* the AP can move onto the block of a running chain; that block is
+	 * no spare block for the next radar */
+	if (dfs_are_channels_overlapped(iface, freq, chan_width, cf1, cf2))
+		return;
+
+	wpa_printf(MSG_INFO, "DFS: background chain at %d MHz adopted from its event",
+		   freq);
+	dfs_chain_record_set(iface, freq, chan, chan_offset, chan_width, cf1,
+			     cf2);
+	/* a record set from an event starts without a pending switch */
+	iface->radar_background.temp_ch = 0;
+}
+
+
 static bool dfs_background_chandef_available(struct hostapd_iface *iface)
 {
 	struct hostapd_hw_modes *mode = iface->current_mode;
@@ -1464,7 +1522,7 @@ hostapd_dfs_start_channel_switch_backgro
 
 int hostapd_dfs_complete_cac(struct hostapd_iface *iface, int success, int freq,
 			     int ht_enabled, int chan_offset, int chan_width,
-			     int cf1, int cf2)
+			     int cf1, int cf2, bool background)
 {
 	if (!hostapd_is_freq_in_current_hw_info(iface, freq)) {
 		wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO,
@@ -1506,8 +1564,15 @@ int hostapd_dfs_complete_cac(struct host
 			 * selected channel and configure the background chain
 			 * to a new DFS channel.
 			 */
-			if (hostapd_dfs_is_background_event(iface, freq)) {
+			if (hostapd_dfs_is_background_event(iface, background)) {
+				dfs_chain_adopt(iface, freq, chan_offset,
+						chan_width, cf1, cf2);
 				iface->radar_background.cac_started = 0;
+				if (iface->radar_background.channel == -1) {
+					iface->radar_background.temp_ch = 0;
+					hostapd_dfs_update_background_chain(iface);
+					return 0;
+				}
 				if (!iface->radar_background.temp_ch)
 					return 0;
 
@@ -1540,9 +1605,18 @@ int hostapd_dfs_complete_cac(struct host
 			    iface->radar_background.channel == -1)
 				hostapd_dfs_update_background_chain(iface);
 		}
-	} else if (hostapd_dfs_is_background_event(iface, freq)) {
-		iface->radar_background.cac_started = 0;
-		hostapd_dfs_update_background_chain(iface);
+	} else if (hostapd_dfs_is_background_event(iface, background)) {
+		/* the kernel can abort a chain after hostapd armed its
+		 * replacement in another block; an abort without a record
+		 * leaves no chain on either side */
+		if (iface->radar_background.channel == -1 ||
+		    dfs_background_chandef_contains(iface, freq)) {
+			iface->radar_background.cac_started = 0;
+			hostapd_dfs_update_background_chain(iface);
+		} else {
+			wpa_printf(MSG_DEBUG,
+				   "DFS: the abort of a chain that is no longer recorded");
+		}
 	} else if (iface->state == HAPD_IFACE_ENABLED) {
 		int i;
 
@@ -1709,7 +1783,7 @@ static int hostapd_dfs_start_channel_swi
 
 static int
 hostapd_dfs_background_start_channel_switch(struct hostapd_iface *iface,
-					    int freq)
+					    bool chain)
 {
 	if (!dfs_use_radar_background(iface))
 		return -1; /* Background radar chain not supported. */
@@ -1722,12 +1796,12 @@ hostapd_dfs_background_start_channel_swi
 	/* Check if CSA in progress */
 	if (hostapd_csa_in_progress(iface)) {
 		/* the kernel stopped the chain; move it once the CSA ends */
-		if (hostapd_dfs_is_background_event(iface, freq))
+		if (chain)
 			iface->radar_background.update_after_csa = 1;
 		return 0;
 	}
 
-	if (hostapd_dfs_is_background_event(iface, freq)) {
+	if (chain) {
 		/*
 		 * Radar pattern is reported on the background chain.
 		 * Just select a new random channel according to the
@@ -1961,15 +2035,15 @@ static int dfs_follow_radar_detected(str
 
 
 /* A detect mode keeps only the chain that saw the radar on its channel */
-static bool dfs_detect_mode_skip(struct hostapd_iface *iface, int freq)
+static bool dfs_detect_mode_skip(struct hostapd_iface *iface, bool chain)
 {
 	switch (iface->conf->dfs_detect_mode) {
 	case DFS_DETECT_MODE_ALL_ENABLE:
 		return true;
 	case DFS_DETECT_MODE_BACKGROUND_ENABLE:
-		return hostapd_dfs_is_background_event(iface, freq);
+		return chain;
 	case DFS_DETECT_MODE_AP_ENABLE:
-		return !hostapd_dfs_is_background_event(iface, freq);
+		return !chain;
 	default:
 		return false;
 	}
@@ -2033,8 +2107,10 @@ void hostapd_dfs_detect_mode_clear(struc
 
 int hostapd_dfs_radar_detected(struct hostapd_iface *iface, int freq,
 			       int ht_enabled, int chan_offset, int chan_width,
-			       int cf1, int cf2)
+			       int cf1, int cf2, bool background)
 {
+	bool chain;
+
 	if (!hostapd_is_freq_in_current_hw_info(iface, freq)) {
 		wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO,
 			DFS_EVENT_RADAR_DETECTED
@@ -2069,8 +2145,10 @@ int hostapd_dfs_radar_detected(struct ho
 						 chan_offset, chan_width,
 						 cf1, cf2);
 
+	chain = hostapd_dfs_is_background_event(iface, background);
+
 	/* a held chain keeps its channel available in the table as well */
-	if (dfs_detect_mode_skip(iface, freq))
+	if (dfs_detect_mode_skip(iface, chain))
 		return 0;
 
 	/* mark radar frequency as invalid */
@@ -2078,14 +2156,31 @@ int hostapd_dfs_radar_detected(struct ho
 			   cf1, cf2, HOSTAPD_CHAN_DFS_UNAVAILABLE))
 		return 0;
 
-	if (!hostapd_dfs_is_background_event(iface, freq)) {
+	/* The chain can run on the AP block while hostapd holds no record of
+	 * it, after the drop in hostapd_dfs_start_channel_switch_cac(); a
+	 * radar there moves the AP. */
+	if (chain &&
+	    dfs_are_channels_overlapped(iface, freq, chan_width, cf1, cf2))
+		chain = false;
+
+	if (!chain) {
 		/* Skip if reported radar event not overlapped our channels */
 		if (!dfs_are_channels_overlapped(iface, freq, chan_width,
 						 cf1, cf2))
 			return 0;
+	} else if (iface->radar_background.channel != -1 &&
+		   !dfs_background_chandef_contains(iface, freq)) {
+		/* The firmware can report one radar twice, and the second
+		 * report comes after the chain moved. A second search would
+		 * find no channel and drop the record of the chain that the
+		 * kernel runs. */
+		wpa_printf(MSG_INFO,
+			   "DFS: radar at %d MHz outside the recorded chain block, record kept",
+			   freq);
+		return 0;
 	}
 
-	if (hostapd_dfs_background_start_channel_switch(iface, freq)) {
+	if (hostapd_dfs_background_start_channel_switch(iface, chain)) {
 		/* Radar detected while operating, switch the channel. */
 		return hostapd_dfs_start_channel_switch(iface);
 	}
@@ -2211,23 +2306,16 @@ static void dfs_chain_half_adopt(struct
 	wpa_printf(MSG_DEBUG,
 		   "DFS: background chain runs the 80 MHz half at %d MHz",
 		   cf1);
-	iface->radar_background.freq = freq;
-	iface->radar_background.channel = chan;
-	/* a wide event carries no offset; calculate_chan_offset() rule */
-	iface->radar_background.secondary_channel =
-		(abs(freq - (cf1 - 30)) / 20) % 2 == 0 ? 1 : -1;
-	iface->radar_background.chwidth =
-		chan_width_to_oper_chwidth(chan_width);
-	iface->radar_background.centr_freq_seg0_idx = (cf1 - 5000) / 5;
-	iface->radar_background.centr_freq_seg1_idx = 0;
+	dfs_chain_record_set(iface, freq, chan, 0, chan_width, cf1, 0);
 }
 
 
