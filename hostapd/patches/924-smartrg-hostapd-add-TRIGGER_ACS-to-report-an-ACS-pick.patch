+void hostapd_manual_acs_save(struct hostapd_iface *iface)
+{
+	struct hostapd_config *conf = iface->conf;
+	struct hostapd_manual_acs_saved *saved = &iface->manual_acs_saved;
+
+	if (!iface->manual_acs_triggered)
+		return;
+
+	saved->valid = true;
+	saved->current_mode = iface->current_mode;
+	saved->freq = iface->freq;
+	saved->is_no_ir = iface->is_no_ir;
+	saved->hw_mode = conf->hw_mode;
+	saved->channel = conf->channel;
+	saved->acs = conf->acs;
+	saved->edmg_channel = conf->edmg_channel;
+	saved->secondary_channel = conf->secondary_channel;
+	saved->ht40_plus_minus_allowed = conf->ht40_plus_minus_allowed;
+	saved->ieee80211n = conf->ieee80211n;
+	saved->ieee80211ac = conf->ieee80211ac;
+	saved->ieee80211ax = conf->ieee80211ax;
+	saved->ieee80211be = conf->ieee80211be;
+	saved->vht_oper_chwidth = conf->vht_oper_chwidth;
+	saved->vht_oper_centr_freq_seg0_idx = conf->vht_oper_centr_freq_seg0_idx;
+	saved->vht_oper_centr_freq_seg1_idx = conf->vht_oper_centr_freq_seg1_idx;
+#ifdef CONFIG_IEEE80211AX
+	saved->he_oper_chwidth = conf->he_oper_chwidth;
+	saved->he_oper_centr_freq_seg0_idx = conf->he_oper_centr_freq_seg0_idx;
+	saved->he_oper_centr_freq_seg1_idx = conf->he_oper_centr_freq_seg1_idx;
+#endif /* CONFIG_IEEE80211AX */
+#ifdef CONFIG_IEEE80211BE
+	saved->eht_oper_chwidth = conf->eht_oper_chwidth;
+	saved->eht_oper_centr_freq_seg0_idx = conf->eht_oper_centr_freq_seg0_idx;
+	saved->eht_bw320_offset = conf->eht_bw320_offset;
+	saved->punct_bitmap = conf->punct_bitmap;
+#endif /* CONFIG_IEEE80211BE */
+}
+
+
+void hostapd_manual_acs_restore(struct hostapd_iface *iface)
+{
+	struct hostapd_config *conf = iface->conf;
+	struct hostapd_manual_acs_saved *saved = &iface->manual_acs_saved;
+
+	if (!saved->valid)
+		return;
+
+	saved->valid = false;
+	iface->current_mode = saved->current_mode;
+	iface->freq = saved->freq;
+	iface->is_no_ir = saved->is_no_ir;
+	conf->hw_mode = saved->hw_mode;
+	conf->channel = saved->channel;
+	conf->acs = saved->acs;
+	conf->edmg_channel = saved->edmg_channel;
+	conf->secondary_channel = saved->secondary_channel;
+	conf->ht40_plus_minus_allowed = saved->ht40_plus_minus_allowed;
+	conf->ieee80211n = saved->ieee80211n;
+	conf->ieee80211ac = saved->ieee80211ac;
+	conf->ieee80211ax = saved->ieee80211ax;
+	conf->ieee80211be = saved->ieee80211be;
+	conf->vht_oper_chwidth = saved->vht_oper_chwidth;
+	conf->vht_oper_centr_freq_seg0_idx = saved->vht_oper_centr_freq_seg0_idx;
+	conf->vht_oper_centr_freq_seg1_idx = saved->vht_oper_centr_freq_seg1_idx;
+#ifdef CONFIG_IEEE80211AX
+	conf->he_oper_chwidth = saved->he_oper_chwidth;
+	conf->he_oper_centr_freq_seg0_idx = saved->he_oper_centr_freq_seg0_idx;
+	conf->he_oper_centr_freq_seg1_idx = saved->he_oper_centr_freq_seg1_idx;
+#endif /* CONFIG_IEEE80211AX */
+#ifdef CONFIG_IEEE80211BE
+	conf->eht_oper_chwidth = saved->eht_oper_chwidth;
+	conf->eht_oper_centr_freq_seg0_idx = saved->eht_oper_centr_freq_seg0_idx;
+	conf->eht_bw320_offset = saved->eht_bw320_offset;
+	conf->punct_bitmap = saved->punct_bitmap;
+#endif /* CONFIG_IEEE80211BE */
+}
+
+
+void hostapd_manual_acs_end(struct hostapd_iface *iface)
+{
+	if (!iface->manual_acs_triggered)
+		return;
+
+	iface->manual_acs_triggered = false;
+	/* a later scan result must not complete the run as a setup ACS */
+	acs_cleanup(iface);
+}
+
+
+static const char * hostapd_manual_acs_refusal(struct hostapd_iface *iface)
+{
+	if (iface->state != HAPD_IFACE_ENABLED)
+		return "the interface is not enabled";
+	if (iface->manual_acs_triggered)
+		return "a manual run is in progress";
+	if (iface->drv_flags & WPA_DRIVER_FLAGS_ACS_OFFLOAD)
+		return "the driver offloads ACS";
+	if (hostapd_csa_in_progress(iface))
+		return "a channel switch is in progress";
+	/* mac80211 also refuses a scan during a CAC */
+	if (iface->cac_started || iface->radar_background.cac_started)
+		return "a CAC is in progress";
+	return NULL;
+}
+
+
+int hostapd_manual_acs_start(struct hostapd_iface *iface)
+{
+	const char *reason = hostapd_manual_acs_refusal(iface);
+
+	if (reason) {
+		wpa_printf(MSG_INFO, "ACS(%s): TRIGGER_ACS refused: %s",
+			   iface->conf->bss[0]->iface, reason);
+		return -1;
+	}
+
+	iface->manual_acs_triggered = true;
+	if (acs_init(iface) == HOSTAPD_CHAN_ACS)
+		return 0;
+
+	hostapd_manual_acs_end(iface);
+	return -1;
+}
+
+
+static void hostapd_acs_result_write(struct hostapd_iface *iface)
+{
+	char filename[32];
+	FILE *f;
+
+	os_snprintf(filename, sizeof(filename), "/tmp/hapd_acs_%s", iface->phy);
+	f = fopen(filename, "w");
+	if (!f) {
+		wpa_printf(MSG_ERROR, "Unable to open %s for writing", filename);
+		return;
+	}
+
+	fprintf(f, "phy=%s\n", iface->phy);
+	fprintf(f, "config_fname=%s\n", iface->config_fname);
+	fprintf(f, "freq=%d\n", iface->freq);
+	fprintf(f, "channel=%d\n", iface->conf->channel);
+	fclose(f);
+}
+
+
+static int hostapd_manual_acs_completed(struct hostapd_iface *iface, int err)
+{
+	if (!err && hostapd_check_chans(iface) == HOSTAPD_CHAN_VALID) {
+		wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO,
+			ACS_EVENT_COMPLETED "freq=%d channel=%d",
+			iface->freq, iface->conf->channel);
+		hostapd_acs_result_write(iface);
+	} else {
+		wpa_msg(iface->bss[0]->msg_ctx, MSG_INFO, ACS_EVENT_FAILED);
+	}
+
+	hostapd_manual_acs_restore(iface);
+	hostapd_manual_acs_end(iface);
+	return 0;
+}
+
+
 int hostapd_acs_completed(struct hostapd_iface *iface, int err)
 {
 	int ret = -1;
 
+	if (iface->manual_acs_triggered)
+		return hostapd_manual_acs_completed(iface, err);
+
 	if (err)
 		goto out;
 
