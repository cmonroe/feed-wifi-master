From: Chad Monroe <chad@monroe.io>
Date: Tue, 02 Dec 2025 04:52:11 -0800
Subject: [PATCH] hostapd: defer ACS and DFS in AP+STA mode

When an AP shares a PHY with a STA interface, the AP must use the same
channel as the STA. The ucode setup writes channel_defer=1 for every
AP on a radio with a configured STA, also before wpa_supplicant
creates the STA interface. ACS and DFS CAC then wait until the STA
connects and the ucode start call supplies the channel.

The start call clears the option, and a failed start is reported as a
failure. ACS deferral prevents selecting a conflicting channel. DFS
CAC deferral prevents locking the radio for radar detection before the
STA can connect. Without it, the mesh state machine times out and
disables wireless, and a DFS_FAILED loop follows. The deferral has an
option of its own, because other users set start_disabled. A
wpa_supplicant mesh BSS sets it, and the setup of that BSS must
complete. An AP on a radio that a station MLD spans without a link
has no channel to follow and runs the radio's own configuration. The
AP restarts when a link appears on such a radio, and when the link of
a following radio leaves.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 hostapd/config_file.c           |    2 
 openwrt/files/hostapd.uc        |  117 +++++++++++++++++++++++++++++++++-------
 openwrt/files/wpa_supplicant.uc |    3 +
 src/ap/ap_config.h              |    1 
 src/ap/dfs.c                    |   15 +++++
 src/ap/hw_features.c            |   15 +++++
 src/ap/ucode.c                  |    1 
 7 files changed, 134 insertions(+), 20 deletions(-)

--- a/openwrt/files/hostapd.uc
+++ b/openwrt/files/hostapd.uc
@@ -18,6 +18,7 @@ hostapd.data.config = {};
 hostapd.data.pending_config = {};
 hostapd.data.apsta_freq = {};
 hostapd.data.apsta_stopped = {};
+hostapd.data.apsta_linkless = {};
 
 hostapd.data.file_fields = {
 	vlan_file: true,
@@ -145,9 +146,29 @@ function iface_freq_info(iface, config,
 	return hostapd.freq_info(freq, sec_offset, width);
 }
 
-function iface_add(phy, config, phy_status)
+function iface_add(phy, config, phy_status, start_disabled)
 {
-	let config_inline = iface_gen_config(config, !!phy_status);
+	let linkless = !!phy_status?.no_link;
+	if (linkless) {
+		if (hostapd.add_iface(`bss_config=${phy}:${iface_gen_config(config, false, false)}`) < 0)
+			return false;
+
+		delete hostapd.data.apsta_freq[phy];
+		hostapd.data.apsta_linkless[phy] = true;
+		hostapd.printf(`Radio ${phy} has no station link, running its own channel configuration`);
+		return true;
+	}
+
+	start_disabled ??= !!phy_status;
+
+	let config_inline = iface_gen_config(config, start_disabled);
+
+	/*
+	 * A STA configured on this radio supplies the channel, also before
+	 * wpa_supplicant creates its interface and phy_status can see it.
+	 */
+	if (start_disabled || config.radio.channel_follow)
+		config_inline += "channel_defer=1\n";
 
 	let bss = config.bss[0];
 	let ret = hostapd.add_iface(`bss_config=${phy}:${config_inline}`);
@@ -163,7 +184,21 @@ function iface_add(phy, config, phy_stat
 
 	let freq_info = iface_freq_info(iface, config, phy_status);
 
-	return iface.start(freq_info) >= 0;
+	/*
+	 * A colocated STA exists but reported no usable frequency yet.
+	 * Leave the AP deferred (channel_defer) instead of starting it
+	 * on stale channel data; apsta_state delivers the real channel
+	 * once the STA link has a chandef.
+	 */
+	if (!freq_info)
+		return true;
+
+	if (!iface.start(freq_info))
+		return false;
+
+	hostapd.data.apsta_freq[phy] = phy_status.frequency;
+	delete hostapd.data.apsta_linkless[phy];
+	return true;
 }
 
 function bss_macaddr_name(group, bss)
@@ -303,6 +338,7 @@ function __iface_pending_next(pending, s
 		return "check_phy";
 	case "check_phy":
 		let phy_status = data;
+		pending.has_sta_iface = !!(phy_status && phy_status.state);
 		if (phy_status && phy_status.state == "COMPLETED") {
 			if (iface_add(phy, config, phy_status))
 				return "done";
@@ -316,7 +352,7 @@ function __iface_pending_next(pending, s
 		});
 		return "wpas_stopped";
 	case "wpas_stopped":
-		if (!iface_add(phy, config))
+		if (!iface_add(phy, config, null, pending.has_sta_iface))
 			hostapd.printf(`hostapd.add_iface failed for phy ${phy} ifname=${bss.ifname}`);
 		pending.call("wpa_supplicant", "phy_set_state", {
 			phy: phydev.phy,
@@ -415,6 +451,7 @@ function iface_restart(phydev, config, o
 		pending.abort();
 
 	delete hostapd.data.apsta_stopped[phy];
+	delete hostapd.data.apsta_linkless[phy];
 	hostapd.remove_iface(phy);
 
 	let prev_bssid = {};
@@ -1021,6 +1058,17 @@ function iface_start_failed(name)
 	       !hostapd.data.apsta_stopped[name];
 }
 
+// A stop keeps the channel, so a start without channel info resumes the
+// beacons of a stopped interface; a disabled one needs a restart.
+function iface_resume(name, iface)
+{
+	if (!iface.start(null))
+		return false;
+
+	delete hostapd.data.apsta_stopped[name];
+	return true;
+}
+
 // Whether the interface runs the channel `config` names already. A channel
 // switch hostapd makes by itself, after a radar, leaves the stored config on
 // the channel it left, so a config that names the channel it moved to is no
@@ -1279,7 +1327,8 @@ function iface_reload_config(name, phyde
 		bsscfg.bssid = addr;
 	}
 
-	let config_inline = iface_gen_config(config);
+	let config_inline = iface_gen_config(config, null,
+		config.radio.channel_follow && !hostapd.data.apsta_linkless[name]);
 
 	// Step 7: fill in the gaps with new interfaces
 	for (let i = 0; i < length(config.bss); i++) {
@@ -1436,6 +1485,7 @@ function iface_config_remove(name, old_c
 
 	delete hostapd.data.apsta_freq[name];
 	delete hostapd.data.apsta_stopped[name];
+	delete hostapd.data.apsta_linkless[name];
 	hostapd.remove_iface(name);
 	return iface_remove(old_config);
 }
@@ -2049,6 +2099,20 @@ let main_obj = {
 				return 0;
 			}
 
+			let restart = () => {
+				let phydev = phy_open(config.phy, config.radio_idx);
+				if (phydev)
+					iface_restart(phydev, config, config);
+				return 0;
+			};
+
+			/*
+			 * A link appeared on a radio that runs its own configuration;
+			 * only a restart writes channel_follow into the hostapd config.
+			 */
+			if (req.args.frequency && hostapd.data.apsta_linkless[phy])
+				return restart();
+
 			if (req.args.frequency)
 				hostapd.data.apsta_freq[phy] = req.args.frequency;
 			else if (req.args.no_link && hostapd.data.apsta_freq[phy]) {
@@ -2059,39 +2123,52 @@ let main_obj = {
 				 * happened to use last.
 				 */
 				delete hostapd.data.apsta_freq[phy];
-
-				if (iface_channel_switch(phy, config)) {
-					delete hostapd.data.apsta_stopped[phy];
+				return restart();
+			} else if (req.args.no_link) {
+				if (hostapd.data.pending_config[phy])
 					return 0;
-				}
 
-				let phydev = phy_open(config.phy, config.radio_idx);
-				if (phydev)
-					iface_restart(phydev, config, config);
+				let linkless = hostapd.data.apsta_linkless[phy];
+				let stopped = hostapd.data.apsta_stopped[phy];
+				if (linkless && !stopped && !iface_start_failed(phy))
+					return 0;
+				if (linkless && stopped && iface_resume(phy, iface))
+					return 0;
 
-				return 0;
+				return restart();
 			}
 
+			let fail = () => {
+				delete hostapd.data.apsta_freq[phy];
+				return libubus.STATUS_UNKNOWN_ERROR;
+			};
+
 			let freq_info;
 			if (req.args.frequency) {
 				freq_info = iface_freq_info(iface, config, req.args);
 				if (!freq_info)
-					return libubus.STATUS_UNKNOWN_ERROR;
+					return fail();
 
 				if (req.args.csa) {
 					freq_info.csa_count = req.args.csa_count ?? 10;
-					let ret = iface.switch_channel(freq_info);
-					if (!ret)
-						return libubus.STATUS_UNKNOWN_ERROR;
+					if (!iface.switch_channel(freq_info))
+						return fail();
 
 					delete hostapd.data.apsta_stopped[phy];
 					return 0;
 				}
 			}
 
-			let ret = iface.start(freq_info);
-			if (!ret)
-				return libubus.STATUS_UNKNOWN_ERROR;
+			/*
+			 * The STA is up but has no usable frequency yet. Keep a
+			 * deferred AP parked; a later update with a real
+			 * frequency starts it.
+			 */
+			if (!freq_info)
+				return 0;
+
+			if (!iface.start(freq_info))
+				return fail();
 
 			delete hostapd.data.apsta_stopped[phy];
 			return 0;
--- a/src/ap/hw_features.c
+++ b/src/ap/hw_features.c
@@ -1322,6 +1322,21 @@ hostapd_check_chans(struct hostapd_iface
 	 * which is used to trigger ACS.
 	 */
 
+	/*
+	 * With channel_defer=1 the AP shares the PHY with a STA and gets its
+	 * channel from the ucode iface.start() call, so ACS waits for it.
+	 *
+	 * Return HOSTAPD_CHAN_ACS to signal setup should wait, but don't
+	 * change the interface state (stays in COUNTRY_UPDATE).  This
+	 * avoids triggering the ACS_FAILED notification when iface.start()
+	 * later disables and re-enables the interface with a real channel.
+	 */
+	if (iface->conf->channel_defer) {
+		wpa_printf(MSG_INFO,
+			   "ACS deferred: channel_defer=1, waiting for channel via iface.start()");
+		return HOSTAPD_CHAN_ACS;
+	}
+
 	switch (acs_init(iface)) {
 	case HOSTAPD_CHAN_ACS:
 		return HOSTAPD_CHAN_ACS;
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -871,6 +871,21 @@ int hostapd_handle_dfs(struct hostapd_if
 		return 1;
 	}
 
+	/*
+	 * With channel_defer=1, defer DFS CAC. Same rationale as ACS
+	 * deferral in hw_features.c: the AP waits for the STA to connect
+	 * and provide channel info via iface.start() before starting
+	 * radar detection.
+	 *
+	 * Return 0 to pause setup without changing interface state
+	 * or starting CAC.
+	 */
+	if (iface->conf->channel_defer) {
+		wpa_printf(MSG_INFO,
+			   "DFS deferred: channel_defer=1, waiting for channel via iface.start()");
+		return 0;
+	}
+
 	iface->cac_started = 0;
 
 	do {
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3360,6 +3360,8 @@ static int hostapd_config_fill(struct ho
 		conf->acs_exclude_dfs = atoi(pos);
 	} else if (os_strcmp(buf, "op_class") == 0) {
 		conf->op_class = atoi(pos);
+	} else if (os_strcmp(buf, "channel_defer") == 0) {
+		conf->channel_defer = atoi(pos);
 	} else if (os_strcmp(buf, "channel") == 0) {
 		if (os_strcmp(pos, "acs_survey") == 0) {
 #ifndef CONFIG_ACS
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1116,6 +1116,7 @@ struct hostapd_config {
 	int enable_edmg;
 	u8 edmg_channel;
 	u8 acs;
+	int channel_defer;
 	struct wpa_freq_range_list acs_ch_list;
 	struct wpa_freq_range_list acs_freq_list;
 	u8 acs_freq_list_present;
--- a/src/ap/ucode.c
+++ b/src/ap/ucode.c
@@ -820,6 +820,7 @@ out:
 
 	for (i = 0; i < iface->num_bss; i++)
 		iface->bss[i]->conf->start_disabled = 0;
+	iface->conf->channel_defer = 0;
 
 	if (iface->state != HAPD_IFACE_ENABLED) {
 		hostapd_enable_iface(iface);
--- a/openwrt/files/wpa_supplicant.uc
+++ b/openwrt/files/wpa_supplicant.uc
@@ -810,6 +810,9 @@ let main_obj = {
 
 					let mld = wpas.data.mld[ifname];
 					iface_status_fill_radio(mld, phy.radio, ret, status);
+					// same meaning as no_link in the apsta_state report
+					if (ret.state == "COMPLETED" && !ret.frequency)
+						ret.no_link = true;
 					return ret;
 				} catch (e) {
 					ex_handler(e);
