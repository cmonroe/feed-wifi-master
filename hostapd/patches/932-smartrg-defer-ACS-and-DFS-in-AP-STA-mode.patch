From: Chad Monroe <chad@monroe.io>
Date: Tue, 02 Dec 2025 04:52:11 -0800
Subject: [PATCH] hostapd: defer ACS and DFS in AP+STA mode

When an AP shares a PHY with a STA interface, the AP must use the same
channel as the STA. Defer both ACS and DFS CAC until the STA connects
and provides channel information via iface.start().

ACS deferral prevents selecting a conflicting channel. DFS CAC deferral
prevents locking the radio for radar detection before the STA can
connect, which otherwise causes a DFS_FAILED loop when the mesh state
machine times out and disables wireless.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 openwrt/files/hostapd.uc |    7 ++++---
 src/ap/dfs.c             |   16 ++++++++++++++++
 src/ap/hw_features.c     |   19 +++++++++++++++++++
 src/ap/ucode.c           |    2 ++
 4 files changed, 41 insertions(+), 3 deletions(-)

--- a/openwrt/files/hostapd.uc
+++ b/openwrt/files/hostapd.uc
@@ -144,9 +144,9 @@ function iface_freq_info(iface, config,
 	return hostapd.freq_info(freq, sec_offset, width);
 }
 
-function iface_add(phy, config, phy_status)
+function iface_add(phy, config, phy_status, start_disabled)
 {
-	let config_inline = iface_gen_config(config, !!phy_status);
+	let config_inline = iface_gen_config(config, start_disabled ?? !!phy_status);
 
 	let bss = config.bss[0];
 	let ret = hostapd.add_iface(`bss_config=${phy}:${config_inline}`);
@@ -162,6 +162,15 @@ function iface_add(phy, config, phy_stat
 
 	let freq_info = iface_freq_info(iface, config, phy_status);
 
+	/*
+	 * A colocated STA exists but reported no usable frequency yet.
+	 * Leave the AP deferred (start_disabled) instead of starting it
+	 * on stale channel data; apsta_state delivers the real channel
+	 * once the STA link has a chandef.
+	 */
+	if (!freq_info)
+		return true;
+
 	return iface.start(freq_info) >= 0;
 }
 
@@ -228,6 +237,7 @@ function __iface_pending_next(pending, s
 		return "check_phy";
 	case "check_phy":
 		let phy_status = data;
+		pending.has_sta_iface = !!(phy_status && phy_status.state);
 		if (phy_status && phy_status.state == "COMPLETED") {
 			if (iface_add(phy, config, phy_status))
 				return "done";
@@ -241,7 +251,7 @@ function __iface_pending_next(pending, s
 		});
 		return "wpas_stopped";
 	case "wpas_stopped":
-		if (!iface_add(phy, config))
+		if (!iface_add(phy, config, null, pending.has_sta_iface))
 			hostapd.printf(`hostapd.add_iface failed for phy ${phy} ifname=${bss.ifname}`);
 		pending.call("wpa_supplicant", "phy_set_state", {
 			phy: phydev.phy,
@@ -1485,24 +1495,35 @@ let main_obj = {
 				return 0;
 			}
 
+			let fail = () => {
+				delete hostapd.data.apsta_freq[phy];
+				return libubus.STATUS_UNKNOWN_ERROR;
+			};
+
 			let freq_info;
 			if (req.args.frequency) {
 				freq_info = iface_freq_info(iface, config, req.args);
 				if (!freq_info)
-					return libubus.STATUS_UNKNOWN_ERROR;
+					return fail();
 
 				if (req.args.csa) {
 					freq_info.csa_count = req.args.csa_count ?? 10;
-					let ret = iface.switch_channel(freq_info);
-					if (!ret)
-						return libubus.STATUS_UNKNOWN_ERROR;
+					if (!iface.switch_channel(freq_info))
+						return fail();
 					return 0;
 				}
 			}
 
-			let ret = iface.start(freq_info);
-			if (!ret)
-				return libubus.STATUS_UNKNOWN_ERROR;
+			/*
+			 * The STA is up but has no usable frequency yet. Keep a
+			 * deferred AP parked; a later update with a real
+			 * frequency starts it.
+			 */
+			if (!freq_info)
+				return 0;
+
+			if (!iface.start(freq_info))
+				return fail();
 
 			return 0;
 		}
--- a/src/ap/hw_features.c
+++ b/src/ap/hw_features.c
@@ -1231,6 +1231,25 @@ hostapd_check_chans(struct hostapd_iface
 	 * which is used to trigger ACS.
 	 */
 
+	/*
+	 * If the first BSS has start_disabled=1, defer ACS instead of
+	 * starting a scan.  The interface will wait for channel info to
+	 * be provided via hostapd ucode iface.start() call.  This enables
+	 * AP+STA coexistence where the AP waits for the STA to connect
+	 * and provide channel information before starting.
+	 *
+	 * Return HOSTAPD_CHAN_ACS to signal setup should wait, but don't
+	 * change the interface state (stays in COUNTRY_UPDATE).  This
+	 * avoids triggering the ACS_FAILED notification when iface.start()
+	 * later disables and re-enables the interface with a real channel.
+	 */
+	if (iface->conf->num_bss > 0 &&
+	    iface->bss[0]->conf->start_disabled) {
+		wpa_printf(MSG_INFO,
+			   "ACS deferred: start_disabled=1, waiting for channel via iface.start()");
+		return HOSTAPD_CHAN_ACS;
+	}
+
 	switch (acs_init(iface)) {
 	case HOSTAPD_CHAN_ACS:
 		return HOSTAPD_CHAN_ACS;
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -870,6 +870,22 @@ int hostapd_handle_dfs(struct hostapd_if
 		return 1;
 	}
 
+	/*
+	 * If the first BSS has start_disabled=1, defer DFS CAC.
+	 * Same rationale as ACS deferral in hw_features.c: the AP
+	 * waits for the STA to connect and provide channel info via
+	 * iface.start() before starting radar detection.
+	 *
+	 * Return 0 to pause setup without changing interface state
+	 * or starting CAC.
+	 */
+	if (iface->conf->num_bss > 0 &&
+	    iface->bss[0]->conf->start_disabled) {
+		wpa_printf(MSG_INFO,
+			   "DFS deferred: start_disabled=1, waiting for channel via iface.start()");
+		return 0;
+	}
+
 	iface->cac_started = 0;
 
 	do {
