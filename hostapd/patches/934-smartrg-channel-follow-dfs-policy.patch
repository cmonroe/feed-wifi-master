From: Chad Monroe <chad@monroe.io>
Date: Sun, 9 Aug 2026 23:00:00 -0700
Subject: [PATCH] hostapd: never self-select a channel in channel-follow mode

The colocated STA owns the radio's only channel context. A channel
that hostapd picks on its own can never start: the CAC or the beacon
fails against the STA's channel context, setup fails with DFS_FAILED,
and netifd loops.

Add a real channel_follow=1 config keyword. Parse it into
hostapd_config and emit it in iface_gen_config().

In follow mode:
- hostapd_handle_dfs() parks the iface in the DFS state when the
  followed block has unavailable channels. It does not relocate.
  The NOP-finished retry stays armed. The usable-to-CAC path does
  not change.
- On a radar event, keep the AP up when the kernel's STA-coverage
  path kept the channel available (its STA_CAC_SKIPPED event comes
  before the radar event). If not, disable the AP and wait for the
  STA to supply the next channel. Never send a CSA to a
  self-selected chandef.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -3374,6 +3374,8 @@ static int hostapd_config_fill(struct ho
 			conf->channel = atoi(pos);
 			conf->acs = conf->channel == 0;
 		}
+	} else if (os_strcmp(buf, "channel_follow") == 0) {
+		conf->channel_follow = atoi(pos);
 	} else if (os_strcmp(buf, "edmg_channel") == 0) {
 		conf->edmg_channel = atoi(pos);
 	} else if (os_strcmp(buf, "enable_edmg") == 0) {
--- a/openwrt/files/hostapd.uc
+++ b/openwrt/files/hostapd.uc
@@ -81,6 +81,9 @@ ${join("\n", config.radio.data)}
 channel=${config.radio.channel}
 `;
 
+	if (config.radio.channel_follow)
+		str += "channel_follow=1\n";
+
 	for (let i = 0; i < length(config.bss); i++) {
 		let bss = config.bss[i];
 		let type = i > 0 ? "bss" : "interface";
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1112,6 +1112,7 @@ struct hostapd_config {
 	int fragm_threshold;
 	u8 op_class;
 	u8 channel;
+	int channel_follow;
 	int enable_edmg;
 	u8 edmg_channel;
 	u8 acs;
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -924,6 +924,20 @@ int hostapd_handle_dfs(struct hostapd_if
 		wpa_printf(MSG_DEBUG, "DFS %d chans unavailable - choose other channel: %s",
 			   res, res ? "yes": "no");
 		if (res) {
+			if (iface->conf->channel_follow) {
+				/*
+				 * A channel-following AP must never pick its
+				 * own channel; a self-selected chandef cannot
+				 * coexist with the colocated STA's channel
+				 * context. Park in DFS state so the
+				 * NOP-finished retry or the next iface.start()
+				 * re-attempts the followed channel.
+				 */
+				wpa_printf(MSG_INFO,
+					   "DFS channel_follow: followed channel unavailable, waiting instead of relocating");
+				hostapd_set_state(iface, HAPD_IFACE_DFS);
+				return 0;
+			}
 			if (dfs_set_valid_channel(iface, skip_radar) < 0) {
 				hostapd_set_state(iface, HAPD_IFACE_DFS);
 				return 0;
@@ -1570,6 +1584,32 @@ int hostapd_dfs_radar_detected(struct ho
 	if (!iface->conf->ieee80211h)
 		return 0;
 
+	if (iface->conf->channel_follow) {
+		/*
+		 * A channel-following AP never self-selects a replacement
+		 * channel. When the STA-coverage path revalidated the channel
+		 * (the STA_CAC_SKIPPED event precedes this radar event), keep
+		 * operating; otherwise vacate and wait for the STA to deliver
+		 * the next channel via iface.start().
+		 */
+		if (!dfs_are_channels_overlapped(iface, freq, chan_width,
+						 cf1, cf2))
+			return 0;
+
+		if (hostapd_is_dfs_chan_available(iface)) {
+			wpa_printf(MSG_INFO,
+				   "DFS channel_follow: STA coverage keeps followed channel available, ignoring radar event");
+			return 0;
+		}
+
+		set_dfs_state(iface, freq, ht_enabled, chan_offset, chan_width,
+			      cf1, cf2, HOSTAPD_CHAN_DFS_UNAVAILABLE);
+		wpa_printf(MSG_INFO,
+			   "DFS channel_follow: radar on followed channel, disabling AP until the STA provides a channel");
+		hostapd_disable_iface(iface);
+		return 0;
+	}
+
 	/* mark radar frequency as invalid */
 	if (!set_dfs_state(iface, freq, ht_enabled, chan_offset, chan_width,
 			   cf1, cf2, HOSTAPD_CHAN_DFS_UNAVAILABLE))
