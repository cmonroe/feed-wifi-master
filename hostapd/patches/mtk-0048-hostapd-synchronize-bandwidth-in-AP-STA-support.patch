+
 	if (!iface)
 		return NULL;
 
@@ -627,6 +630,9 @@ uc_hostapd_iface_start(uc_vm_t *vm, size
 	uint64_t intval;
 	int i;
 
+	wpa_printf(MSG_INFO, "%s: start iface for %s in state %s\n",
+			__func__, iface->phy, hostapd_state_text(iface->state));
+
 	if (!iface)
 		return NULL;
 
@@ -650,6 +656,7 @@ uc_hostapd_iface_start(uc_vm_t *vm, size
 	UPDATE_VAL(hw_mode, "hw_mode");
 	UPDATE_VAL(channel, "channel");
 	UPDATE_VAL(secondary_channel, "sec_channel");
+
 	if (!changed &&
 	    (iface->bss[0]->beacon_set_done ||
 	     iface->state == HAPD_IFACE_DFS))
@@ -700,6 +707,15 @@ out:
 		return ucv_boolean_new(true);
 	}
 
+	wpa_printf(MSG_INFO, "%s: updated channel=%d op_class=%d secondary channel=%d seg0=%d seg1=%d oper_chwidth=%d\n",
+			__func__,
+			conf->channel,
+			conf->op_class,
