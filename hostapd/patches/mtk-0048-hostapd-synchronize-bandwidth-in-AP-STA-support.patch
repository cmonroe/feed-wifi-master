+static bool is_bw320_offset2(int center_freq1)
+{
+	/* center channels 63, 127, 191: the second 320 MHz channelization */
+	return center_freq1 == 6265 || center_freq1 == 6585 ||
+	       center_freq1 == 6905;
+}
