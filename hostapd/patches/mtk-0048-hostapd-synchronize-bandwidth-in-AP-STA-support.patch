+/* -1 when the chandef has no operating class */
+static int
+uc_wpas_iface_status_chandef(uc_value_t *ret,
+			     const struct wpa_channel_info *ci)
+{
+	int freq = ci->frequency, sec_chan = 0, bw320_offset = 1, is_24ghz;
+	enum oper_chan_width ch_width;
+	enum hostapd_hw_mode hw_mode;
+	u8 op_class, channel;
+
+	hw_mode = ieee80211_freq_to_chan(freq, &channel);
+	is_24ghz = hw_mode == HOSTAPD_MODE_IEEE80211G ||
+		hw_mode == HOSTAPD_MODE_IEEE80211B;
+
+	if (freq != ci->center_frq1) {
+		if (is_24ghz)
+			sec_chan = (freq < ci->center_frq1) ? 1 : -1;
+		else
+			sec_chan = (freq / 20) & 1 ? 1 : -1;
+	}
+
+	if (ieee80211_chaninfo_to_channel(freq, ci->chanwidth, sec_chan,
+					  &op_class, &channel))
+		return -1;
+
+	ch_width = op_class_to_ch_width(op_class);
+	if (ch_width == CONF_OPER_CHWIDTH_320MHZ &&
+	    is_bw320_offset2(ci->center_frq1))
+		bw320_offset = 2;
+
+	ucv_object_add(ret, "sec_chan_offset", ucv_int64_new(sec_chan));
+	ucv_object_add(ret, "frequency", ucv_int64_new(freq));
+	ucv_object_add(ret, "ch_width", ucv_int64_new(ch_width));
+	ucv_object_add(ret, "bw320_offset", ucv_int64_new(bw320_offset));
+	return 0;
+}
+
+static void
+uc_wpas_iface_status_bss(uc_value_t *ret, struct wpa_supplicant *wpa_s)
+{
+	struct wpa_channel_info ci;
+
+	/*
+	 * Without a driver chandef (scanning, associating, netdev being
+	 * recreated) any width/op-class derived here would be garbage.
+	 * Report nothing so the AP side keeps its start deferred; a
+	 * fresh status arrives once the association has a live chandef.
+	 * The channel info query is a blocking netlink round-trip, so
+	 * skip it outright before the association completes.
+	 */
+	if (wpa_s->wpa_state != WPA_COMPLETED)
+		return;
+
+	os_memset(&ci, 0, sizeof(ci));
+	if (wpa_drv_channel_info(wpa_s, &ci) < 0 ||
+	    !ci.frequency || ci.chanwidth == CHAN_WIDTH_UNKNOWN)
+		return;
+
+	uc_wpas_iface_status_chandef(ret, &ci);
+}
+
+static void
+uc_wpas_iface_status_link(uc_value_t *ret, struct wpa_bss *bss,
+			  const struct driver_sta_mlo_info *mlo, int link_id)
+{
+	struct wpa_channel_info ci;
+
+	os_memset(&ci, 0, sizeof(ci));
+	if ((mlo->valid_links & BIT(link_id)) &&
+	    mlo->links[link_id].chanwidth != CHAN_WIDTH_UNKNOWN &&
+	    mlo->links[link_id].center_frq1) {
+		ci.frequency = mlo->links[link_id].freq;
+		ci.chanwidth = mlo->links[link_id].chanwidth;
+		ci.center_frq1 = mlo->links[link_id].center_frq1;
+		if (!uc_wpas_iface_status_chandef(ret, &ci))
+			return;
+	}
+
+	uc_wpas_iface_status_ht(ret, bss);
+}
+
+static void
+uc_wpas_iface_status_mlo(uc_vm_t *vm, uc_value_t *ret,
+			 struct wpa_supplicant *wpa_s)
+{
+	struct driver_sta_mlo_info mlo;
+	uc_value_t *links = ucv_array_new(vm);
+	int i;
+
+	/*
+	 * An MLO association has no interface chandef, only one per link.
+	 * As for a single link, query them only once the association
+	 * completes; without a link chandef, report the BSS channel only.
+	 */
+	os_memset(&mlo, 0, sizeof(mlo));
+	if (wpa_s->wpa_state == WPA_COMPLETED) {
+		if (wpas_drv_get_sta_mlo_links(wpa_s, &mlo) < 0)
+			mlo.valid_links = 0;
+		if (wpa_s->current_bss)
+			uc_wpas_iface_status_link(ret, wpa_s->current_bss, &mlo,
+						  wpa_s->mlo_assoc_link_id);
+	}
+
+	for_each_link(wpa_s->valid_links, i) {
+		struct wpa_bss *bss = wpa_s->links[i].bss;
+		uc_value_t *link;
+
+		if (!bss)
+			continue;
+
+		link = ucv_object_new(vm);
+		uc_wpas_iface_status_link(link, bss, &mlo, i);
+		ucv_array_set(links, i, link);
+	}
+
+	ucv_object_add(ret, "links", links);
+}
+
