From: Chad Monroe <chad@monroe.io>
Date: Tue, 25 Nov 2025 10:22:00 -0800
Subject: [PATCH] hostapd: add interface state change callback for setup failure

An interface that goes to DISABLED from the ACS, DFS or HT_SCAN
state does not come up, and netifd does not see it. hostapd reports
such a transition to netifd as a setup failure, so that netifd can
set the radio up again after a transient failure.

hostapd does not report a transition that it causes itself while it
applies a configuration or follows an AP-STA stop or start. Without
that, a station that leaves a DFS channel makes netifd restart the
radio in a loop. A configuration that fails or throws makes
config_set reply with an error, not with the process ID. netifd then
treats it as a failed setup.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 openwrt/files/hostapd.uc |   76 ++++++++++++++++++++++++++++++++++---
 src/ap/hostapd.c         |    6 ++
 src/ap/ucode.c           |   13 ++++++
 src/ap/ucode.h           |   11 +++++
 4 files changed, 99 insertions(+), 7 deletions(-)

--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -57,6 +57,7 @@
 #include "airtime_policy.h"
 #include "wpa_auth_kay.h"
 #include "hw_features.h"
+#include "ucode.h"
 
 
 static int hostapd_flush_old_stations(struct hostapd_data *hapd, u16 reason);
@@ -4727,10 +4728,13 @@ const char * hostapd_state_text(enum hos
 
 void hostapd_set_state(struct hostapd_iface *iface, enum hostapd_iface_state s)
 {
+	enum hostapd_iface_state old_state = iface->state;
+
 	wpa_printf(MSG_INFO, "%s: interface state %s->%s",
 		   iface->conf ? iface->conf->bss[0]->iface : "N/A",
-		   hostapd_state_text(iface->state), hostapd_state_text(s));
+		   hostapd_state_text(old_state), hostapd_state_text(s));
 	iface->state = s;
+	hostapd_ucode_iface_state_cb(iface, old_state, s);
 }
 
 
--- a/src/ap/ucode.c
+++ b/src/ap/ucode.c
@@ -1555,3 +1555,16 @@ void hostapd_ucode_apup_newpeer(struct h
 	ucv_put(val);
 }
 #endif // def CONFIG_APUP
+
+void hostapd_ucode_iface_state_cb(struct hostapd_iface *iface,
+				  enum hostapd_iface_state old_state,
+				  enum hostapd_iface_state new_state)
+{
+	if (wpa_ucode_call_prepare("iface_state"))
+		return;
+
+	uc_value_push(ucv_string_new(iface->phy));
+	uc_value_push(ucv_int64_new(old_state));
+	uc_value_push(ucv_int64_new(new_state));
+	ucv_put(wpa_ucode_call(3));
+}
--- a/src/ap/ucode.h
+++ b/src/ap/ucode.h
@@ -4,6 +4,8 @@
 #include "utils/ucode.h"
 
 struct hostapd_data;
+struct hostapd_iface;
+enum hostapd_iface_state;
 
 struct hostapd_ucode_bss {
 #ifdef UCODE_SUPPORT
@@ -46,6 +48,10 @@ struct wpabuf *hostapd_ucode_dpp_gas_req
 					 unsigned int freq);
 #endif /* CONFIG_DPP */
 
+void hostapd_ucode_iface_state_cb(struct hostapd_iface *iface,
+				  enum hostapd_iface_state old_state,
+				  enum hostapd_iface_state new_state);
+
 #else
 
 static inline int hostapd_ucode_init(struct hapd_interfaces *ifaces)
@@ -78,6 +84,11 @@ static inline void hostapd_ucode_wps_m7_
 					    int *skip_cred)
 {
 }
+static inline void hostapd_ucode_iface_state_cb(struct hostapd_iface *iface,
+						enum hostapd_iface_state old_state,
+						enum hostapd_iface_state new_state)
+{
+}
 
 #ifdef CONFIG_DPP
 static inline int hostapd_ucode_dpp_rx_action(struct hostapd_data *hapd,
--- a/openwrt/files/hostapd.uc
+++ b/openwrt/files/hostapd.uc
@@ -64,6 +64,18 @@ hostapd.data.bss_info_fields = {
 hostapd.data.mld = {};
 hostapd.data.dpp_hooks = {};
 
+const HAPD_IFACE_DISABLED = 1;
+const HAPD_IFACE_ACS = 3;
+const HAPD_IFACE_HT_SCAN = 4;
+const HAPD_IFACE_DFS = 5;
+const NOTIFY_CMD_SETUP_FAILED = 5;
+
+const SETUP_FAIL_REASON = {
+	[HAPD_IFACE_ACS]: "ACS_FAILED",
+	[HAPD_IFACE_DFS]: "DFS_FAILED",
+	[HAPD_IFACE_HT_SCAN]: "HT_SCAN_FAILED",
+};
+
 function iface_remove(cfg)
 {
 	if (!cfg || !cfg.bss || !cfg.bss[0] || !cfg.bss[0].ifname)
@@ -467,7 +479,7 @@ function iface_restart(phydev, config, o
 				delete cur.bssid;
 		if (pending)
 			iface_supplicant_start(phydev);
-		return;
+		return false;
 	}
 	iface_macaddr_sync(phydev, config);
 
@@ -1271,7 +1283,7 @@ function mld_link_bss_remove(phy, name)
 	iface_macaddr_prune(phy, config);
 }
 
-function iface_set_config(name, config)
+function iface_set_config_apply(name, config)
 {
 	let old_config = hostapd.data.config[name];
 
@@ -1307,8 +1319,20 @@ function iface_set_config(name, config)
 	}
 
 	hostapd.printf(`Restart interface for phy ${name}`);
-	let ret = iface_restart(phydev, config, old_config);
+	return iface_restart(phydev, config, old_config);
+}
+
+function iface_set_config(name, config)
+{
+	let ret;
 
+	hostapd.data.configuring = name;
+	try {
+		ret = iface_set_config_apply(name, config);
+	} catch (e) {
+		ret = ex_handler(e);
+	}
+	delete hostapd.data.configuring;
 	return ret;
 }
 
@@ -1837,7 +1861,9 @@ let main_obj = {
 
 			if (!req.args.up) {
 				delete hostapd.data.apsta_freq[phy];
+				hostapd.data.configuring = phy;
 				iface.stop();
+				delete hostapd.data.configuring;
 				return 0;
 			}
 
@@ -1889,7 +1915,15 @@ let main_obj = {
 			if (!freq_info)
 				return 0;
 
-			if (!iface.start(freq_info))
+			/*
+			 * Starting a parked iface goes through a disable/enable
+			 * cycle whose DFS->DISABLED transition must not be
+			 * reported as a setup failure.
+			 */
+			hostapd.data.configuring = phy;
+			let ret = iface.start(freq_info);
+			delete hostapd.data.configuring;
+			if (!ret)
 				return fail();
 
 			return 0;
@@ -1954,6 +1988,7 @@ let main_obj = {
 			radio: 0,
 			config: "",
 			prev_config: "",
+			device: "",
 		},
 		call: function(req) {
 			let phy = req.args.phy;
@@ -1961,21 +1996,28 @@ let main_obj = {
 			let name = phy_name(phy, radio);
 			let file = req.args.config;
 			let prev_file = req.args.prev_config;
+			let device = req.args.device;
 
 			if (!phy)
 				return libubus.STATUS_INVALID_ARGUMENT;
 
 			if (prev_file && !hostapd.data.config[name]) {
 				let config = iface_load_config(phy, radio, prev_file);
-				if (config)
+				if (config) {
 					config.radio.data = [];
+					config.device = device;
+				}
 				hostapd.data.config[name] = config;
 			}
 
 			let config = iface_load_config(phy, radio, file);
+			if (config && device)
+				config.device = device;
 
 			hostapd.printf(`Set new config for phy ${name}: ${file}`);
-			iface_set_config(name, config);
+			let ret = iface_set_config(name, config);
+			if (ret === false || ret === libubus.STATUS_UNKNOWN_ERROR)
+				return libubus.STATUS_UNKNOWN_ERROR;
 
 			if (hostapd.data.auth_obj)
 				hostapd.data.auth_obj.notify("reload", { phy, radio });
@@ -2246,4 +2288,26 @@ return {
 			return null;
 		return response;
 	},
+	iface_state: function(phy, old_state, new_state) {
+		if (new_state != HAPD_IFACE_DISABLED)
+			return;
+
+		let reason = SETUP_FAIL_REASON[old_state];
+		if (!reason)
+			return;
+
+		if (hostapd.data.configuring == phy)
+			return;
+
+		let cfg = hostapd.data.config[phy];
+		if (!cfg || !cfg.device)
+			return;
+
+		hostapd.printf(`Interface ${phy} setup failed: ${reason}`);
+		ubus.call("network.wireless", "notify", {
+			"command": NOTIFY_CMD_SETUP_FAILED,
+			"device": cfg.device,
+			"data": { "reason": reason }
+		});
+	},
 };
