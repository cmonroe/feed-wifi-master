--- a/net/wireless/debugfs.c
+++ b/net/wireless/debugfs.c
@@ -10,6 +10,7 @@
 #include <linux/slab.h>
 #include "core.h"
 #include "debugfs.h"
+#include "rdev-ops.h"
 
 #define DEBUGFS_READONLY_FILE(name, buflen, fmt, value...)		\
 static ssize_t name## _read(struct file *file, char __user *userbuf,	\
@@ -118,8 +119,587 @@ static const struct file_operations ht40
 	.llseek = default_llseek,
 };
 
-#define DEBUGFS_ADD(name)						\
-	debugfs_create_file(#name, 0444, phyd, &rdev->wiphy, &name## _ops)
+#define DFS_LINK_HDR_FMT	"%-15s %-7s %-5s %-5s %-6s %-5s %-10s %s\n"
+#define DFS_LINK_ROW_FMT	"%-15s %-7s %-5u %-5u %-6d %-5u %-10s %s\n"
+#define DFS_CHAN_HDR_FMT	"%-5s %-5s %-12s %-6s %-10s %-10s %-10s %s\n"
+#define DFS_CHAN_ROW_FMT	"%-5u %-5u %-12s %-6s %-10s %-10u %-10u %s\n"
+
+static const char *dfs_state_name(enum nl80211_dfs_state state)
+{
+	switch (state) {
+	case NL80211_DFS_USABLE:
+		return "usable";
+	case NL80211_DFS_UNAVAILABLE:
+		return "unavailable";
+	case NL80211_DFS_AVAILABLE:
+		return "available";
+	default:
+		return "unknown";
+	}
+}
+
+static void dfs_timer_seconds(unsigned long start, unsigned int total_ms,
+			      unsigned int *remain_s, unsigned int *total_s)
+{
+	unsigned int passed_ms = jiffies_to_msecs(jiffies - start);
+
+	*total_s = total_ms / 1000;
+	*remain_s = passed_ms < total_ms ? (total_ms - passed_ms) / 1000 : 0;
+}
+
+static struct ieee80211_supported_band *dfs_sband_5ghz(struct wiphy *wiphy)
+{
+	enum nl80211_band band;
+
+	for (band = 0; band < NUM_NL80211_BANDS; band++)
+		if (wiphy->bands[band] &&
+		    wiphy->bands[band]->band == NL80211_BAND_5GHZ)
+			return wiphy->bands[band];
+
+	return NULL;
+}
+
+static const char *dfs_iftype_name(enum nl80211_iftype iftype)
+{
+	switch (iftype) {
+	case NL80211_IFTYPE_AP:
+		return "ap";
+	case NL80211_IFTYPE_P2P_GO:
+		return "p2p-go";
+	case NL80211_IFTYPE_MESH_POINT:
+		return "mesh";
+	case NL80211_IFTYPE_ADHOC:
+		return "ibss";
+	case NL80211_IFTYPE_OCB:
+		return "ocb";
+	case NL80211_IFTYPE_STATION:
+		return "sta";
+	case NL80211_IFTYPE_P2P_CLIENT:
+		return "p2p-cli";
+	default:
+		return "other";
+	}
+}
+
+/*
+ * An AP or mesh link keeps its chandef after an aborted CAC or a failed
+ * start, so the chandef alone does not say that the link is on air.
+ */
+static struct cfg80211_chan_def *
+dfs_link_chandef(struct cfg80211_registered_device *rdev,
+		 struct wireless_dev *wdev, unsigned int link_id,
+		 struct cfg80211_chan_def *tmp, bool *active)
+{
+	struct cfg80211_chan_def *chandef;
+
+	switch (wdev->iftype) {
+	case NL80211_IFTYPE_AP:
+	case NL80211_IFTYPE_P2P_GO:
+		chandef = &wdev->links[link_id].ap.chandef;
+		*active = wdev->links[link_id].cac_started ||
+			  wdev->links[link_id].ap.beacon_interval;
+		break;
+	case NL80211_IFTYPE_MESH_POINT:
+		chandef = &wdev->u.mesh.chandef;
+		*active = wdev->links[link_id].cac_started ||
+			  wdev->u.mesh.id_len;
+		break;
+	case NL80211_IFTYPE_ADHOC:
+		chandef = &wdev->u.ibss.chandef;
+		*active = wdev->u.ibss.ssid_len;
+		break;
+	case NL80211_IFTYPE_OCB:
+		chandef = &wdev->u.ocb.chandef;
+		*active = true;
+		break;
+	case NL80211_IFTYPE_STATION:
+	case NL80211_IFTYPE_P2P_CLIENT:
+		if (!rdev->ops->get_channel ||
+		    rdev_get_channel(rdev, wdev, link_id, tmp))
+			return NULL;
+		chandef = tmp;
+		*active = true;
+		break;
+	default:
+		return NULL;
+	}
+
+	if (!chandef->chan)
+		return NULL;
+
+	return chandef;
+}
+
+static int dfs_status_summary(struct wiphy *wiphy, char *buf, int buf_size,
+			      int offset)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct cfg80211_chan_def chandef;
+	unsigned long last_time, flags, ago_s;
+	bool background;
+	u32 count;
+
+	spin_lock_irqsave(&rdev->radar_count_lock, flags);
+	count = rdev->radar_count;
+	chandef = rdev->radar_last_chandef;
+	last_time = rdev->radar_last_time;
+	background = rdev->radar_last_background;
+	spin_unlock_irqrestore(&rdev->radar_count_lock, flags);
+
+	offset += scnprintf(buf + offset, buf_size - offset,
+			    "radar events %u", count);
+	if (!last_time)
+		return offset + scnprintf(buf + offset, buf_size - offset, "\n");
+
+	ago_s = (jiffies - last_time) / HZ;
+	offset += scnprintf(buf + offset, buf_size - offset,
+			    ", last %lu s ago on %u MHz width %d cf1 %u, %s chain\n",
+			    ago_s,
+			    chandef.chan ? chandef.chan->center_freq : 0,
+			    cfg80211_chandef_get_width(&chandef),
+			    chandef.center_freq1,
+			    background ? "background" : "operating");
+
+	return offset;
+}
+
+static int dfs_status_links(struct wiphy *wiphy, char *buf, int buf_size,
+			    int offset)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct cfg80211_chan_def *chandef, tmp;
+	struct wireless_dev *wdev;
+	unsigned int link_id, remain_s, total_s;
+	const char *name, *state;
+	char timer[24], wdev_name[16];
+	bool active;
+
+	offset += scnprintf(buf + offset, buf_size - offset, DFS_LINK_HDR_FMT,
+			    "link", "type", "chan", "freq", "width", "cf1",
+			    "state", "timer(s)");
+
+	list_for_each_entry(wdev, &wiphy->wdev_list, list) {
+		for_each_valid_link(wdev, link_id) {
+			chandef = dfs_link_chandef(rdev, wdev, link_id, &tmp,
+						   &active);
+			if (!chandef || chandef->chan->band != NL80211_BAND_5GHZ)
+				continue;
+
+			if (wdev->netdev) {
+				name = wdev->netdev->name;
+			} else {
+				snprintf(wdev_name, sizeof(wdev_name), "wdev%u",
+					 wdev->identifier);
+				name = wdev_name;
+			}
+
+			strscpy(timer, "-", sizeof(timer));
+			if (!active) {
+				state = "idle";
+			} else if (wdev->links[link_id].cac_started) {
+				state = "cac";
+				dfs_timer_seconds(wdev->links[link_id].cac_start_time,
+						  wdev->links[link_id].cac_time_ms,
+						  &remain_s, &total_s);
+				snprintf(timer, sizeof(timer), "%u/%u",
+					 remain_s, total_s);
+			} else if (cfg80211_chandef_dfs_required(wiphy, chandef,
+								 NL80211_IFTYPE_AP) > 0) {
+				state = "operating";
+			} else {
+				state = "no-dfs";
+			}
+
+			offset += scnprintf(buf + offset, buf_size - offset,
+					    DFS_LINK_ROW_FMT, name,
+					    dfs_iftype_name(wdev->iftype),
+					    chandef->chan->hw_value,
+					    chandef->chan->center_freq,
+					    cfg80211_chandef_get_width(chandef),
+					    chandef->center_freq1, state, timer);
+		}
+	}
+
+	chandef = &rdev->background_radar_chandef;
+	if (!rdev->background_radar_wdev || !chandef->chan)
+		return offset;
+
+	strscpy(timer, "-", sizeof(timer));
+	if (rdev->background_cac_started) {
+		state = "cac";
+		dfs_timer_seconds(rdev->background_cac_start_time,
+				  rdev->background_cac_time_ms,
+				  &remain_s, &total_s);
+		snprintf(timer, sizeof(timer), "%u/%u", remain_s, total_s);
+	} else {
+		state = "monitoring";
+	}
+
+	return offset + scnprintf(buf + offset, buf_size - offset,
+				  DFS_LINK_ROW_FMT, "background", "chain",
+				  chandef->chan->hw_value,
+				  chandef->chan->center_freq,
+				  cfg80211_chandef_get_width(chandef),
+				  chandef->center_freq1, state, timer);
+}
+
+static bool dfs_cac_cover(struct wiphy *wiphy, struct ieee80211_channel *chan,
+			  unsigned int *remain_s, unsigned int *total_s)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct cfg80211_chan_def *chandef, tmp;
+	struct wireless_dev *wdev;
+	unsigned int link_id;
+	bool active;
+
+	list_for_each_entry(wdev, &wiphy->wdev_list, list) {
+		for_each_valid_link(wdev, link_id) {
+			if (!wdev->links[link_id].cac_started)
+				continue;
+
+			chandef = dfs_link_chandef(rdev, wdev, link_id, &tmp,
+						   &active);
+			if (!chandef || !cfg80211_is_sub_chan(chandef, chan, false))
+				continue;
+
+			dfs_timer_seconds(wdev->links[link_id].cac_start_time,
+					  wdev->links[link_id].cac_time_ms,
+					  remain_s, total_s);
+			return true;
+		}
+	}
+
+	if (rdev->background_radar_wdev && rdev->background_cac_started &&
+	    rdev->background_radar_chandef.chan &&
+	    cfg80211_is_sub_chan(&rdev->background_radar_chandef, chan, false)) {
+		dfs_timer_seconds(rdev->background_cac_start_time,
+				  rdev->background_cac_time_ms,
+				  remain_s, total_s);
+		return true;
+	}
+
+	return false;
+}
+
+static const char *dfs_chain_cover(struct wiphy *wiphy,
+				   struct ieee80211_channel *chan)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct cfg80211_chan_def *chandef, tmp;
+	struct wireless_dev *wdev;
+	unsigned int link_id;
+	bool active;
+
+	list_for_each_entry(wdev, &wiphy->wdev_list, list) {
+		for_each_valid_link(wdev, link_id) {
+			chandef = dfs_link_chandef(rdev, wdev, link_id, &tmp,
+						   &active);
+			if (chandef && active &&
+			    cfg80211_is_sub_chan(chandef, chan, false))
+				return "op";
+		}
+	}
+
+	if (rdev->background_radar_wdev && rdev->background_radar_chandef.chan &&
+	    cfg80211_is_sub_chan(&rdev->background_radar_chandef, chan, false))
+		return "bg";
+
+	return "-";
+}
+
+static int dfs_status_channels(struct wiphy *wiphy, char *buf, int buf_size,
+			       int offset)
+{
+	struct ieee80211_supported_band *sband = dfs_sband_5ghz(wiphy);
+	struct ieee80211_channel *chan;
+	enum nl80211_dfs_state state;
+	unsigned int remain_s, total_s;
+	const char *timer;
+	char left[24];
+	int i;
+
+	if (!sband)
+		return offset + scnprintf(buf + offset, buf_size - offset,
+					  "no 5 GHz band\n");
+
+	offset += scnprintf(buf + offset, buf_size - offset, DFS_CHAN_HDR_FMT,
+			    "chan", "freq", "state", "timer", "left(s)",
+			    "radar", "bg-radar", "chain");
+
+	for (i = 0; i < sband->n_channels; i++) {
+		chan = &sband->channels[i];
+		if (!(chan->flags & IEEE80211_CHAN_RADAR))
+			continue;
+
+		state = READ_ONCE(chan->dfs_state);
+		timer = "-";
+		strscpy(left, "-", sizeof(left));
+		if (state == NL80211_DFS_UNAVAILABLE) {
+			timer = "nop";
+			dfs_timer_seconds(chan->dfs_state_entered,
+					  IEEE80211_DFS_MIN_NOP_TIME_MS,
+					  &remain_s, &total_s);
+			snprintf(left, sizeof(left), "%u/%u", remain_s, total_s);
+		} else if (state == NL80211_DFS_USABLE &&
+			   dfs_cac_cover(wiphy, chan, &remain_s, &total_s)) {
+			timer = "cac";
+			snprintf(left, sizeof(left), "%u/%u", remain_s, total_s);
+		}
+
+		offset += scnprintf(buf + offset, buf_size - offset,
+				    DFS_CHAN_ROW_FMT, chan->hw_value,
+				    chan->center_freq, dfs_state_name(state),
+				    timer, left, chan->dfs_radar_count,
+				    chan->dfs_radar_count_background,
+				    dfs_chain_cover(wiphy, chan));
+	}
+
+	return offset;
+}
+
+static ssize_t dfs_status_do_read(struct wiphy *wiphy, struct file *file,
+				  char *buf, size_t bufsize, void *data)
+{
+	int buf_size = bufsize;
+	int offset = 0;
+
+	offset = dfs_status_summary(wiphy, buf, buf_size, offset);
+	offset += scnprintf(buf + offset, buf_size - offset, "\n");
+	offset = dfs_status_links(wiphy, buf, buf_size, offset);
+	offset += scnprintf(buf + offset, buf_size - offset, "\n");
+	offset = dfs_status_channels(wiphy, buf, buf_size, offset);
+
+	return offset;
+}
+
+static ssize_t dfs_status_read(struct file *file, char __user *user_buf,
+			       size_t count, loff_t *ppos)
+{
+	struct wiphy *wiphy = file->private_data;
+	size_t bufsize = 4 * PAGE_SIZE;
+	char *buf;
+	ssize_t ret;
+
+	buf = kvmalloc(bufsize, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	ret = wiphy_locked_debugfs_read(wiphy, file, buf, bufsize, user_buf,
+					count, ppos, dfs_status_do_read, NULL);
+	kvfree(buf);
+
+	return ret;
+}
+
+static const struct file_operations dfs_status_ops = {
+	.read = dfs_status_read,
+	.open = simple_open,
+	.llseek = default_llseek,
+};
+
+#define DEBUGFS_U64_WRITE_FILE(name, set)				\
+static ssize_t name## _do_write(struct wiphy *wiphy, struct file *file,	\
+				char *buf, size_t count, void *data)	\
+{									\
+	u64 val;							\
+	int ret;							\
+									\
+	ret = kstrtou64(buf, 0, &val);					\
+	if (ret)							\
+		return ret;						\
+									\
+	ret = set(wiphy, val);						\
+	return ret ?: count;						\
+}									\
+									\
+static ssize_t name## _write(struct file *file,				\
+			     const char __user *userbuf,		\
+			     size_t count, loff_t *ppos)		\
+{									\
+	struct wiphy *wiphy = file->private_data;			\
+	char buf[24];							\
+									\
+	return wiphy_locked_debugfs_write(wiphy, file, buf, sizeof(buf),	\
+					  userbuf, count,		\
+					  name## _do_write, NULL);	\
+}									\
+									\
+static const struct file_operations name## _ops = {			\
+	.write = name## _write,						\
+	.open = simple_open,						\
+	.llseek = default_llseek,					\
+}
+
+static int
+dfs_nop_skip(struct wiphy *wiphy, u64 val)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	bool en = !!val;
+	enum nl80211_band band;
+	struct ieee80211_supported_band *sband;
+	struct ieee80211_channel *chan;
+	u32 nop_time = IEEE80211_DFS_MIN_NOP_TIME_MS;
+	int i;
+
+	if (!en)
+		return 0;
+
+	for (band = 0; band < NUM_NL80211_BANDS; band++) {
+		sband = wiphy->bands[band];
+		if (!sband)
+			continue;
+		for (i = 0; i < sband->n_channels; i++) {
+			chan = &sband->channels[i];
+
+			if (!(chan->flags & IEEE80211_CHAN_RADAR))
+				continue;
+
+			if (chan->dfs_state == NL80211_DFS_UNAVAILABLE) {
+				// Let current jiffies > dfs_state_entered_jiffies + NOP time
+				chan->dfs_state_entered = jiffies -
+						       msecs_to_jiffies(nop_time + 1);
+			}
+		}
+	}
+
+	cfg80211_sched_dfs_chan_update(rdev);
+
+	return 0;
+}
+
+DEBUGFS_U64_WRITE_FILE(dfs_skip_nop, dfs_nop_skip);
