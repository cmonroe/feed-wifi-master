+void cfg80211_count_radar_event(struct wiphy *wiphy,
+				const struct cfg80211_chan_def *chandef,
+				bool background)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	struct ieee80211_channel *c;
+	unsigned long flags;
+
+	if (!cfg80211_chandef_valid(chandef))
+		return;
+
+	spin_lock_irqsave(&rdev->radar_count_lock, flags);
+
+	rdev->radar_count++;
+	rdev->radar_last_chandef = *chandef;
+	rdev->radar_last_time = jiffies;
+	rdev->radar_last_background = background;
+
+	for_each_subchan(chandef, freq, cf) {
+		c = ieee80211_get_channel_khz(wiphy, freq);
+		if (!c || !(c->flags & IEEE80211_CHAN_RADAR))
+			continue;
+
+		if (background)
+			c->dfs_radar_count_background++;
+		else
+			c->dfs_radar_count++;
+	}
+
+	spin_unlock_irqrestore(&rdev->radar_count_lock, flags);
+}
