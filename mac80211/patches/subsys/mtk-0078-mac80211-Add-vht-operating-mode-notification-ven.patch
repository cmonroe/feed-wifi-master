From af9eb3ac01579bfc1222099e3540144352910b5f Mon Sep 17 00:00:00 2001
From: Allen Ye <allen.ye@mediatek.com>
Date: Wed, 9 Oct 2024 13:50:56 +0800
Subject: [PATCH 078/137] mtk: mac80211: Add vht operating mode notification
 vendor flag

mac80211 sets IEEE80211_RC_VHT_OMN_CHANGED in the rate control
update when a VHT operating mode notification changes the bandwidth
or NSS of a station. A driver can then tell this update from other
rate updates.

ieee80211_link_sta_cap_bw() and ieee80211_link_sta_cap_nss() give a
driver the bandwidth capability of a link station, limited by its RX
OMI bandwidth, and its NSS capability. The driver needs both to handle
an operating mode notification. The bandwidth export takes the band
from the link of the BSS of the station, so a
station on an AP_VLAN interface uses the channel of its AP. If that
link has no channel, the export returns 20 MHz.

Signed-off-by: Benjamin Lin <benjamin-jw.lin@mediatek.com>
Signed-off-by: Allen Ye <allen.ye@mediatek.com>
Co-developed-by: Chad Monroe <chad@monroe.io>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 include/net/mac80211.h  |   17 +++++++++++++++++
 net/mac80211/sta_info.c |   38 ++++++++++++++++++++++++++++++++++++++
 net/mac80211/vht.c      |    1 +
 3 files changed, 56 insertions(+)

--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -3999,12 +3999,15 @@ enum ieee80211_frame_release_type {
  *	the peer.
  * @IEEE80211_RC_NSS_CHANGED: N_SS (number of spatial streams) was changed
  *	by the peer
+ * @IEEE80211_RC_VHT_OMN_CHANGED: The VHT operating mode notification of the
+ *	station changed. Defined for the mtk vendor rate control path.
  */
 enum ieee80211_rate_control_changed {
 	IEEE80211_RC_BW_CHANGED		= BIT(0),
 	IEEE80211_RC_SMPS_CHANGED	= BIT(1),
 	IEEE80211_RC_SUPP_RATES_CHANGED	= BIT(2),
 	IEEE80211_RC_NSS_CHANGED	= BIT(3),
+	IEEE80211_RC_VHT_OMN_CHANGED	= BIT(6),
 };
 
 /**
@@ -8226,4 +8229,18 @@ bool ieee80211_vif_nan_started(struct ie
  * Return: 0 if success and non-zero on error
  */
 int ieee80211_encrypt_tx_skb(struct sk_buff *skb);
+
+/**
+ * ieee80211_link_sta_cap_bw - get link STA's bandwidth capability.
+ * @pub: STA's public link specific information
+ */
+enum ieee80211_sta_rx_bandwidth
+ieee80211_link_sta_cap_bw(struct ieee80211_link_sta *pub);
+
+/**
+ * ieee80211_link_sta_cap_nss - get link STA's spatial streaming capability.
+ * @pub: STA's public link specific information
+ */
+u8 ieee80211_link_sta_cap_nss(struct ieee80211_link_sta *pub);
+
 #endif /* MAC80211_H */
--- a/net/mac80211/vht.c
+++ b/net/mac80211/vht.c
@@ -462,6 +462,7 @@ void ieee80211_vht_handle_opmode(struct
 						    opmode, band);
 
 	if (changed > 0) {
+		changed |= IEEE80211_RC_VHT_OMN_CHANGED;
 		ieee80211_recalc_min_chandef(sdata, link_sta->link_id);
 		rate_control_rate_update(local, sband, link_sta, changed);
 	}
--- a/net/mac80211/sta_info.c
+++ b/net/mac80211/sta_info.c
@@ -3856,6 +3856,44 @@ ieee80211_sta_current_bw(struct link_sta
 	return IEEE80211_STA_RX_BW_20;
 }
 
+enum ieee80211_sta_rx_bandwidth
+ieee80211_link_sta_cap_bw(struct ieee80211_link_sta *pub)
+{
+	struct sta_info *sta = container_of(pub->sta, struct sta_info, sta);
+	struct ieee80211_sub_if_data *sdata = get_bss_sdata(sta->sdata);
+	enum ieee80211_sta_rx_bandwidth bw = IEEE80211_STA_RX_BW_20;
+	struct ieee80211_bss_conf *link_conf;
+	struct link_sta_info *link_sta;
+	struct ieee80211_channel *chan;
+
+	rcu_read_lock();
+	link_sta = rcu_dereference(sta->link[pub->link_id]);
+	link_conf = rcu_dereference(sdata->vif.link_conf[pub->link_id]);
+	chan = link_conf ? link_conf->chanreq.oper.chan : NULL;
+	if (chan)
+		bw = min(ieee80211_sta_bw_capability(link_sta, chan->band),
+			 link_sta->rx_omi_bw_rx);
+	rcu_read_unlock();
+
+	return bw;
+}
+EXPORT_SYMBOL(ieee80211_link_sta_cap_bw);
+
+u8 ieee80211_link_sta_cap_nss(struct ieee80211_link_sta *pub)
+{
+	struct sta_info *sta = container_of(pub->sta, struct sta_info, sta);
+	struct link_sta_info *link_sta;
+	u8 nss;
+
+	rcu_read_lock();
+	link_sta = rcu_dereference(sta->link[pub->link_id]);
+	nss = link_sta->capa_nss;
+	rcu_read_unlock();
+
+	return nss;
+}
+EXPORT_SYMBOL(ieee80211_link_sta_cap_nss);
+
 bool ieee80211_link_sta_update_rc_bw(struct ieee80211_link_data *link,
 				     struct link_sta_info *link_sta)
 {
