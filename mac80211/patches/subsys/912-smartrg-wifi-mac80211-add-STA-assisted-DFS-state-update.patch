+bool cfg80211_dfs_sta_recover_radar(struct wiphy *wiphy,
 				    const struct cfg80211_chan_def *chandef);
 
 void cfg80211_sched_dfs_chan_update(struct cfg80211_registered_device *rdev);
@@ -519,7 +522,7 @@ bool cfg80211_any_wiphy_oper_chan(struct
 
 bool cfg80211_beaconing_iface_active(struct wireless_dev *wdev);
 
-bool cfg80211_is_sub_chan(struct cfg80211_chan_def *chandef,
+bool cfg80211_is_sub_chan(const struct cfg80211_chan_def *chandef,
 			  struct ieee80211_channel *chan,
 			  bool primary_only);
 bool cfg80211_wdev_on_sub_chan(struct wireless_dev *wdev,
--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -22389,7 +22389,8 @@ void cfg80211_ch_switch_notify(struct ne
 	case NL80211_IFTYPE_P2P_GO:
 		if (wdev->links[link_id].ap.chandef.chan)
 			cfg80211_update_last_available(wdev->wiphy,
-						       &wdev->links[link_id].ap.chandef);
+						       &wdev->links[link_id].ap.chandef,
+						       0);
 		wdev->links[link_id].ap.chandef = *chandef;
 
 		/* the AP now operates on the channel the chain monitors */
--- a/net/wireless/mlme.c
+++ b/net/wireless/mlme.c
@@ -1165,7 +1165,8 @@ void __cfg80211_radar_event(struct wiphy
 	 * case the radar is detected on only one of multiple channels
 	 * spanned by the chandef.
 	 */
-	cfg80211_set_dfs_state(wiphy, chandef, NL80211_DFS_UNAVAILABLE);
+	if (offchan || !cfg80211_dfs_sta_recover_radar(wiphy, chandef))
+		cfg80211_set_dfs_state(wiphy, chandef, NL80211_DFS_UNAVAILABLE);
 
 	if (offchan) {
 		cancel_delayed_work(&rdev->background_cac_done_wk);
@@ -1283,7 +1284,7 @@ cfg80211_background_chain_leave(struct c
 		return;
 
 	cfg80211_update_last_available(&rdev->wiphy,
-				       &rdev->background_radar_chandef);
+				       &rdev->background_radar_chandef, 0);
 	cfg80211_sched_dfs_chan_update(rdev);
 }
 
--- a/net/mac80211/chan.c
+++ b/net/mac80211/chan.c
@@ -2323,6 +2323,19 @@ int _ieee80211_link_use_channel(struct i
 					    sdata->wdev.iftype);
 	if (ret < 0)
 		goto out;
+
+	/*
+	 * An AP whose DFS subchannels are all covered by an associated STA
+	 * on the same wiphy relies on the STA's master for radar detection;
+	 * running the local detector too mostly yields false detections
+	 * against our own transmissions, and the vendor firmware stalls the
+	 * data path after an unactioned report. The channel-follow logic
+	 * stops such an AP when the STA link goes away.
+	 */
+	if (ret > 0 && sdata->wdev.iftype == NL80211_IFTYPE_AP &&
+	    cfg80211_dfs_sta_covered(local->hw.wiphy, &chanreq->oper))
+		ret = 0;
+
 	if (ret > 0)
 		radar_detect_width = BIT(chanreq->oper.width);
 
