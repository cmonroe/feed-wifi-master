+ *	is covered by an associated STA on the same wiphy
+ * @wiphy: the wiphy
+ * @chandef: the channel definition to check
+ *
+ */
+bool cfg80211_dfs_sta_covered(struct wiphy *wiphy,
+			      const struct cfg80211_chan_def *chandef);
+
