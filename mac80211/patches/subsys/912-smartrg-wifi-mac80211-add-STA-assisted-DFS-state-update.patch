+static bool cfg80211_sta_radar_same_radio(struct wiphy *wiphy,
+					  struct ieee80211_channel *a,
+					  struct ieee80211_channel *b)
+{
+	if (a->band != b->band)
+		return false;
+
+	return !wiphy->n_radio ||
+	       cfg80211_get_radio_idx_by_chan(wiphy, a) ==
+	       cfg80211_get_radio_idx_by_chan(wiphy, b);
+}
+
+/*
+ * hostapd takes a radar event only from an interface of the instance
+ * that runs the radio of the channel; on a multi-radio wiphy, an AP of
+ * another radio drops it. The radio mask of an idle AP can allow every
+ * radio, so its preset channel takes precedence over the mask.
+ */
+static struct wireless_dev *
+cfg80211_sta_radar_recipient(struct wiphy *wiphy,
+			     struct ieee80211_channel *chan)
+{
+	struct wireless_dev *wdev, *idle = NULL;
+	struct ieee80211_channel *oper;
+	unsigned int link;
+	bool running;
+
+	lockdep_assert_wiphy(wiphy);
+
+	list_for_each_entry(wdev, &wiphy->wdev_list, list) {
+		if (!wdev->netdev ||
+		    (wdev->iftype != NL80211_IFTYPE_AP &&
+		     wdev->iftype != NL80211_IFTYPE_P2P_GO))
+			continue;
+
+		running = false;
+		for_each_valid_link(wdev, link) {
+			oper = wdev->links[link].ap.chandef.chan;
+			if (!oper)
+				continue;
+
+			if (cfg80211_sta_radar_same_radio(wiphy, oper, chan))
+				return wdev;
+
+			running = true;
+		}
+
+		if (running || idle)
+			continue;
+
+		oper = wdev->u.ap.preset_chandef.chan;
+		if (oper && !cfg80211_sta_radar_same_radio(wiphy, oper, chan))
+			continue;
+
+		if (!oper && !cfg80211_wdev_channel_allowed(wdev, chan))
+			continue;
+
+		idle = wdev;
+	}
+
+	return idle;
+}
+
+static void cfg80211_sta_radar_notify(struct wiphy *wiphy,
+				      const struct cfg80211_chan_def *chandef,
+				      enum nl80211_radar_event event)
+{
+	struct wireless_dev *wdev;
+
+	if (cfg80211_chandef_dfs_required(wiphy, chandef,
+					  NL80211_IFTYPE_AP) <= 0)
+		return;
+
+	wdev = cfg80211_sta_radar_recipient(wiphy, chandef->chan);
+	if (!wdev)
+		return;
+
+	nl80211_radar_notify(wiphy_to_rdev(wiphy), chandef, event,
+			     wdev->netdev, GFP_KERNEL);
+}
+
+static bool cfg80211_sta_subchan_in_use(struct wiphy *wiphy,
+					const struct cfg80211_chan_def *csa_chandef,
+					struct ieee80211_channel *chan)
+{
+	if (csa_chandef && cfg80211_is_sub_chan(csa_chandef, chan, false))
+		return true;
+
+	return cfg80211_is_wiphy_oper_chan(wiphy, chan) ||
+	       cfg80211_offchan_chain_is_active(wiphy_to_rdev(wiphy), chan);
+}
+
+/*
+ * hostapd applies an event to every 20 MHz channel that its chandef
+ * spans, so a subchannel that keeps its state must not be part of it.
+ */
+static void cfg80211_sta_set_subchan_state(struct wiphy *wiphy,
+					   struct ieee80211_channel *chan,
+					   enum nl80211_dfs_state dfs_state,
+					   enum nl80211_radar_event event)
+{
+	struct cfg80211_chan_def chandef;
+
+	cfg80211_chandef_create(&chandef, chan, NL80211_CHAN_NO_HT);
+	cfg80211_set_dfs_state(wiphy, &chandef, dfs_state);
+	cfg80211_sta_radar_notify(wiphy, &chandef, event);
+}
+
+void cfg80211_sta_update_dfs_state(struct wireless_dev *wdev,
+				   const struct cfg80211_chan_def *bss_chandef,
+				   const struct cfg80211_chan_def *csa_chandef,
+				   unsigned long csa_time,
+				   bool associated)
+{
+	struct wiphy *wiphy = wdev->wiphy;
+	bool csa_active = !!csa_chandef;
+	enum nl80211_dfs_state dfs_state = NL80211_DFS_USABLE;
+	enum nl80211_radar_event event = NL80211_RADAR_STA_CAC_EXPIRED;
+	struct ieee80211_channel *c;
+	bool changed = false;
+
+	lockdep_assert_wiphy(wdev->wiphy);
+
+	if (!bss_chandef || !bss_chandef->chan ||
+	    bss_chandef->chan->band != NL80211_BAND_5GHZ ||
+	    WARN_ON(!cfg80211_chandef_valid(bss_chandef)))
+		return;
+
+	/* assume csa channel is cac completed */
+	if (csa_active &&
+	    (cfg80211_chandef_dfs_usable(wiphy, csa_chandef) ||
+	    cfg80211_chandef_dfs_available(wiphy, csa_chandef))) {
+		cfg80211_set_dfs_state(wiphy, csa_chandef, NL80211_DFS_AVAILABLE);
+		/* avoid the dfs state from expired during csa countdown */
+		cfg80211_update_last_available(wiphy, csa_chandef, csa_time);
+		cfg80211_sta_radar_notify(wiphy, csa_chandef,
+					  NL80211_RADAR_STA_CAC_SKIPPED);
+		netdev_info(wdev->netdev, "Set CSA channel's DFS state to available\n");
+	}
+
+	if (associated && !csa_active) {
+		/*
+		 * An associated STA proves the master still operates this
+		 * channel, so its operating chandef may promote channels
+		 * to available even out of the NOP/unavailable state.
+		 */
+		dfs_state = NL80211_DFS_AVAILABLE;
+		event = NL80211_RADAR_STA_CAC_SKIPPED;
+	}
+
+	for_each_subchan(bss_chandef, freq, cf) {
+		c = ieee80211_get_channel_khz(wiphy, freq);
+		if (!c || !(c->flags & IEEE80211_CHAN_RADAR))
+			continue;
+
+		/*
+		 * Only an available channel goes back to usable, so that the
+		 * downgrade never lifts a NOP.
+		 */
+		if (dfs_state == NL80211_DFS_USABLE &&
+		    (c->dfs_state != NL80211_DFS_AVAILABLE ||
+		     cfg80211_sta_subchan_in_use(wiphy, csa_chandef, c)))
+			continue;
+
+		cfg80211_sta_set_subchan_state(wiphy, c, dfs_state, event);
+		changed = true;
+	}
+
+	if (!changed)
+		return;
+
+	if (csa_active)
+		netdev_info(wdev->netdev, "Set origin channel's DFS state to usable\n");
+	else
+		netdev_info(wdev->netdev, "Set BSS channel's DFS state to %s due to %s\n",
+			    (dfs_state == NL80211_DFS_USABLE) ? "usable" : "available",
+			    associated ? "association" : "disassociation");
+}
+EXPORT_SYMBOL(cfg80211_sta_update_dfs_state);
+
+bool cfg80211_dfs_sta_covered(struct wiphy *wiphy,
+			      const struct cfg80211_chan_def *chandef)
+{
+	struct ieee80211_channel *c;
+
+	for_each_subchan(chandef, freq, cf) {
+		c = ieee80211_get_channel_khz(wiphy, freq);
+		if (!c)
+			return false;
+
+		if ((c->flags & IEEE80211_CHAN_RADAR) &&
+		    !cfg80211_dfs_sta_present(wiphy, c))
+			return false;
+	}
+
+	return true;
+}
+EXPORT_SYMBOL(cfg80211_dfs_sta_covered);
+
+bool cfg80211_dfs_sta_recover_radar(struct wiphy *wiphy,
+				    const struct cfg80211_chan_def *chandef)
+{
+	/*
+	 * When every radar subchannel is still covered by an associated
+	 * STA, the master keeps operating the channel and the local
+	 * detection is overruled by the master's judgement; keep the
+	 * chandef available instead of serving a NOP the live STA link
+	 * disproves.
+	 */
+	if (!cfg80211_dfs_sta_covered(wiphy, chandef))
+		return false;
+
+	cfg80211_set_dfs_state(wiphy, chandef, NL80211_DFS_AVAILABLE);
+	cfg80211_update_last_available(wiphy, chandef, 0);
+	cfg80211_sta_radar_notify(wiphy, chandef, NL80211_RADAR_STA_CAC_SKIPPED);
+	return true;
+}
+
 struct cfg80211_chan_def *wdev_chandef(struct wireless_dev *wdev,
 				       unsigned int link_id)
 {
--- a/net/wireless/core.h
+++ b/net/wireless/core.h
@@ -498,6 +498,9 @@ void cfg80211_set_cac_state(struct wiphy
 
 void cfg80211_dfs_channels_update_work(struct work_struct *work);
