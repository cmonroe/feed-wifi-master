From: Chad Monroe <chad@monroe.io>
Date: Mon, 24 Aug 2026 17:29:07 -0700
Subject: [PATCH] wifi: mac80211: recalc offload on chanctx assignment

mac80211 selects the netdev TX path (802.3 or 802.11 ops) in
ieee80211_do_open(), right after .add_interface, and re-reads
vif->offload_flags only when a monitor interface is added or
removed. A driver with a single multi-radio wiphy only
learns per-radio offload constraints when a link is bound to a
channel context, so a veto at that point has no effect on TX.

Re-run the offload recalculation after a link is assigned to,
released from, or switched between channel contexts, for drivers
that implement .update_vif_offload. Without the callback the
recalculation could only undo a veto applied in .add_interface.
Consult the driver even when the mac80211 policy flags did not
change, but only for interface types that can carry the offload
flags; AP_VLAN interfaces are never added to the driver.

Check fast rx once, after the driver adjusted the flags. A pass
before the veto enables RX decap in the driver for authorized
stations, and the pass after it does not disable it again, because
ieee80211_check_fast_rx() reports the fast rx state, not the offload
state, to the driver.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 net/mac80211/chan.c        |   21 +++++++++++++++++++++
 net/mac80211/ieee80211_i.h |    1 +
 net/mac80211/iface.c       |   23 +++++++++++++++++++----
 3 files changed, 41 insertions(+), 4 deletions(-)

--- a/net/mac80211/chan.c
+++ b/net/mac80211/chan.c
@@ -1179,6 +1179,24 @@ static void ieee80211_recalc_radar_chanc
 	drv_change_chanctx(local, chanctx, IEEE80211_CHANCTX_CHANGE_RADAR);
 }
 
+/* Drivers may only learn the offload capabilities of a link once it is bound
+ * to a channel context (e.g. hardware address slots assigned per radio), so
+ * let them veto the encap/decap offload flags again and re-select the netdev
+ * ops accordingly. Without .update_vif_offload there is nothing to consult,
+ * and recomputing the policy flags would only undo a veto the driver applied
+ * in .add_interface.
+ */
+static void ieee80211_link_recalc_offload(struct ieee80211_link_data *link)
+{
+	struct ieee80211_sub_if_data *sdata = link->sdata;
+
+	if (!sdata->local->ops->update_vif_offload ||
+	    !ieee80211_sdata_running(sdata))
+		return;
+
+	ieee80211_recalc_sdata_offload(sdata);
+}
+
 static int ieee80211_assign_link_chanctx(struct ieee80211_link_data *link,
 					 struct ieee80211_chanctx *new_ctx,
 					 bool assign_on_failure)
@@ -1257,6 +1275,7 @@ static int ieee80211_assign_link_chanctx
 	}
 
 	ieee80211_check_fast_xmit_iface(sdata);
+	ieee80211_link_recalc_offload(link);
 
 	return ret;
 }
@@ -1707,6 +1726,7 @@ ieee80211_link_use_reserved_reassign(str
 		__ieee80211_link_copy_chanctx_to_vlans(link, false);
 
 	ieee80211_check_fast_xmit_iface(sdata);
+	ieee80211_link_recalc_offload(link);
 
 	if (ieee80211_chanctx_refcount(local, old_ctx) == 0)
 		ieee80211_free_chanctx(local, old_ctx, false);
@@ -2052,6 +2072,7 @@ use_reserved:
 								       false);
 
 			ieee80211_check_fast_xmit_iface(sdata);
+			ieee80211_link_recalc_offload(link);
 
 			link->radar_required = iter.radar_required;
 
--- a/net/mac80211/ieee80211_i.h
+++ b/net/mac80211/ieee80211_i.h
@@ -2207,6 +2207,7 @@ void ieee80211_del_virtual_monitor(struc
 bool __ieee80211_recalc_txpower(struct ieee80211_link_data *link);
 void ieee80211_recalc_txpower(struct ieee80211_link_data *link,
 			      bool update_bss);
+void ieee80211_recalc_sdata_offload(struct ieee80211_sub_if_data *sdata);
 void ieee80211_recalc_offload(struct ieee80211_local *local);
 
 /* link handling */
--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -1103,7 +1103,6 @@ static bool ieee80211_set_sdata_offload_
 		return false;
 
 	sdata->vif.offload_flags = flags;
-	ieee80211_check_fast_rx_iface(sdata);
 	return true;
 }
 
@@ -1133,15 +1132,31 @@ static void ieee80211_set_vif_encap_ops(
 					   &ieee80211_dataif_ops;
 }
 
-static void ieee80211_recalc_sdata_offload(struct ieee80211_sub_if_data *sdata)
+void ieee80211_recalc_sdata_offload(struct ieee80211_sub_if_data *sdata)
 {
 	struct ieee80211_local *local = sdata->local;
 	struct ieee80211_sub_if_data *vsdata;
 
-	if (ieee80211_set_sdata_offload_flags(sdata)) {
+	/* The driver veto below may depend on state the policy flags cannot
+	 * see (e.g. per-radio address slots assigned at chanctx time), so
+	 * consult the driver even when the policy flags did not change.
+	 * Only interface types that can carry the offload flags are worth
+	 * asking about, and only their stations can see a flag change;
+	 * AP_VLAN in particular was never added to the driver, and its
+	 * stations are covered by the pass of the parent AP.
+	 *
+	 * Check fast rx once, after the driver adjusted the flags. A pass
+	 * before the veto would enable RX decap in the driver for authorized
+	 * stations, and the pass after it would not disable it again, since
+	 * ieee80211_check_fast_rx() reports the fast rx state to the driver,
+	 * not the offload state.
+	 */
+	ieee80211_set_sdata_offload_flags(sdata);
+	if (ieee80211_iftype_supports_hdr_offload(sdata->vif.type)) {
 		drv_update_vif_offload(local, sdata);
-		ieee80211_set_vif_encap_ops(sdata);
+		ieee80211_check_fast_rx_iface(sdata);
 	}
+	ieee80211_set_vif_encap_ops(sdata);
 
 	list_for_each_entry(vsdata, &local->interfaces, list) {
 		if (vsdata->vif.type != NL80211_IFTYPE_AP_VLAN ||
