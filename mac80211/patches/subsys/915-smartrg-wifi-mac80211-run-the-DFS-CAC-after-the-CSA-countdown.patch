 					 struct net_device *dev,
 					 struct cfg80211_chan_def *chandef,
 					 u32 cac_time_ms, int link_id);
+	int	(*start_radar_detection_post_csa)(struct wiphy *wiphy,
+						  struct net_device *dev,
+						  unsigned int link_id,
+						  struct cfg80211_chan_def *chandef,
+						  u32 cac_time_ms);
 	void	(*end_cac)(struct wiphy *wiphy,
 			   struct net_device *dev, unsigned int link_id);
 	int	(*update_ft_ies)(struct wiphy *wiphy, struct net_device *dev,
@@ -9931,11 +9938,15 @@ static inline void cfg80211_report_obss_
  *	NOTE: If this is set, wiphy mutex must be held.
  * @reg_power: &enum ieee80211_ap_reg_power value indicating the
  *	advertised/used 6 GHz regulatory power setting
+ * @dfs_relax: allow DFS Usable channel being permitted (especially
+ *	during channel switch).
+ *	NOTE: If this is set, wiphy mutex must be held.
  */
 struct cfg80211_beaconing_check_config {
 	enum nl80211_iftype iftype;
 	enum ieee80211_ap_reg_power reg_power;
 	bool relax;
+	bool dfs_relax;
 };
 
 /**
@@ -9999,6 +10010,46 @@ cfg80211_reg_can_beacon_relax(struct wip
 }
 
 /**
+ * cfg80211_reg_can_beacon_dfs_relax - check if beaconing is allowed with DFS & IR-relaxation
+ * @wiphy: the wiphy
+ * @chandef: the channel definition
+ * @iftype: interface type
+ *
+ * Return: %true if there is no secondary channel or the secondary channel(s)
+ * can be used for beaconing. This version bypasses radar channel check, allowing
+ * channel switch to a USABLE DFS channel and performing CAC after the channel switch.
+ * It also checks if IR-relaxation conditions apply, to allow beaconing under more
+ * permissive conditions.
+ *
+ * Context: Requires the wiphy mutex to be held.
+ */
+static inline bool
+cfg80211_reg_can_beacon_dfs_relax(struct wiphy *wiphy,
+				  struct cfg80211_chan_def *chandef,
+				  enum nl80211_iftype iftype)
+{
+	struct cfg80211_beaconing_check_config config = {
+		.iftype = iftype,
+		.relax = true,
+		.dfs_relax = true,
+	};
+
+	return cfg80211_reg_check_beaconing(wiphy, chandef, &config);
+}
+
+/**
+ * cfg80211_start_radar_detection_post_csa - start radar detection after CSA
+ * @wiphy: the wiphy
+ * @wdev: the wireless device
+ * @link_id: the link ID for MLO, must be 0 for non-MLO
+ * @chandef: the channel definition to start radar detection on
+ */
+int cfg80211_start_radar_detection_post_csa(struct wiphy *wiphy,
+					    struct wireless_dev *wdev,
+					    unsigned int link_id,
+					    struct cfg80211_chan_def *chandef);
+
+/*
  * cfg80211_ch_switch_notify - update wdev channel and notify userspace
  * @dev: the device which switched channels
  * @chandef: the new channel definition
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -1997,7 +1997,7 @@ static int ieee80211_change_beacon(struc
 	return 0;
 }
 
-static void ieee80211_free_next_beacon(struct ieee80211_link_data *link)
+void ieee80211_free_next_beacon(struct ieee80211_link_data *link)
 {
 	if (!link->u.ap.next_beacon)
 		return;
@@ -4251,18 +4251,15 @@ static void ieee80211_end_cac(struct wip
 
 	lockdep_assert_wiphy(local->hw.wiphy);
 
-	list_for_each_entry(sdata, &local->interfaces, list) {
-		link_data = sdata_dereference(sdata->link[link_id], sdata);
-		if (!link_data)
-			continue;
+	link_data = sdata_dereference(sdata->link[link_id], sdata);
+	if (!link_data)
+		return;
 
-		wiphy_hrtimer_work_cancel(wiphy,
-					  &link_data->dfs_cac_timer_work);
+	wiphy_hrtimer_work_cancel(wiphy, &link_data->dfs_cac_timer_work);
 
-		if (sdata->wdev.links[link_id].cac_started) {
-			ieee80211_link_release_channel(link_data);
-			sdata->wdev.links[link_id].cac_started = false;
-		}
+	if (sdata->wdev.links[link_id].cac_started) {
+		ieee80211_link_cac_end(link_data);
+		sdata->wdev.links[link_id].cac_started = false;
 	}
 }
 
@@ -4464,6 +4461,40 @@ static int ieee80211_set_after_csa_beaco
 	return 0;
 }
 
+static int ieee80211_start_radar_detection_post_csa(struct wiphy *wiphy,
+						    struct net_device *dev,
+						    unsigned int link_id,
+						    struct cfg80211_chan_def *chandef,
+						    u32 cac_time_ms)
+{
+	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
+	struct ieee80211_local *local = sdata->local;
+	struct ieee80211_link_data *link;
+
+	if (ieee80211_is_scan_ongoing(wiphy, local, chandef))
+		return -EBUSY;
+
+	link = sdata_dereference(sdata->link[link_id], sdata);
+	if (!link)
+		return -ENOLINK;
+
+	/* whatever, but channel contexts should not complain about that one */
+	link->smps_mode = IEEE80211_SMPS_OFF;
+	link->needed_rx_chains = local->rx_chains;
+
+	if (hweight16(sdata->vif.valid_links) <= 1)
+		sta_info_flush(sdata, -1);
+
+	/* disable beacon during CAC period */
+	link->conf->enable_beacon = false;
+	ieee80211_link_info_change_notify(sdata, link, BSS_CHANGED_BEACON_ENABLED);
+
+	wiphy_hrtimer_work_queue(wiphy, &link->dfs_cac_timer_work,
+				 ms_to_ktime(cac_time_ms));
+
+	return 1;
+}
+
 static int __ieee80211_csa_finalize(struct ieee80211_link_data *link_data)
 {
 	struct ieee80211_sub_if_data *sdata = link_data->sdata;
@@ -4497,6 +4528,12 @@ static int __ieee80211_csa_finalize(stru
 					&link_data->csa.chanreq.oper))
 		return -EINVAL;
 
+	err = cfg80211_start_radar_detection_post_csa(local->hw.wiphy, &sdata->wdev,
+						      link_data->link_id,
+						      &link_conf->chanreq.oper);
+	if (err)
+		return err > 0 ? 0 : err;
+
 	link_conf->csa_active = false;
 
 	err = ieee80211_set_after_csa_beacon(link_data, &changed);
@@ -4520,25 +4557,36 @@ static int __ieee80211_csa_finalize(stru
 	return 0;
 }
 
-static void ieee80211_csa_finalize(struct ieee80211_link_data *link_data)
+static void ieee80211_csa_link_stop(struct ieee80211_link_data *link_data)
 {
 	struct ieee80211_sub_if_data *sdata = link_data->sdata;
 	int link_id = -1;
 
-	if (__ieee80211_csa_finalize(link_data)) {
+	if (sdata->vif.type == NL80211_IFTYPE_AP ||
+	    sdata->vif.type == NL80211_IFTYPE_P2P_GO)
+		/*
+		 * link_id is expected only for AP/P2P_GO type
+		 * currently
+		 */
+		link_id = link_data->link_id;
+
+	cfg80211_stop_link(sdata->local->hw.wiphy, &sdata->wdev,
+			   link_id, GFP_KERNEL);
+}
+
+static int ieee80211_csa_finalize(struct ieee80211_link_data *link_data)
+{
+	struct ieee80211_sub_if_data *sdata = link_data->sdata;
+	int err;
+
+	err = __ieee80211_csa_finalize(link_data);
+	if (err) {
 		sdata_info(sdata, "failed to finalize CSA on link %d, disconnecting\n",
 			   link_data->link_id);
-		if (sdata->vif.type == NL80211_IFTYPE_AP ||
-		    sdata->vif.type == NL80211_IFTYPE_P2P_GO)
-			/*
-			 * link_id is expected only for AP/P2P_GO type
-			 * currently
-			 */
-			link_id = link_data->link_id;
-
-		cfg80211_stop_link(sdata->local->hw.wiphy, &sdata->wdev,
-				   link_id, GFP_KERNEL);
+		ieee80211_csa_link_stop(link_data);
 	}
+
+	return err;
 }
 
 void ieee80211_csa_finalize_work(struct wiphy *wiphy, struct wiphy_work *work)
@@ -4719,6 +4767,7 @@ __ieee80211_channel_switch(struct wiphy
 	struct ieee80211_link_data *link_data;
 	u64 changed = 0;
 	u8 link_id = params->link_id;
+	bool cac_cancelled = false;
 	int err;
 
 	lockdep_assert_wiphy(local->hw.wiphy);
@@ -4726,9 +4775,6 @@ __ieee80211_channel_switch(struct wiphy
 	if (ieee80211_is_scan_ongoing(wiphy, local, &params->chandef))
 		return -EBUSY;
 
-	if (sdata->wdev.links[link_id].cac_started)
-		return -EBUSY;
-
 	if (WARN_ON(link_id >= IEEE80211_MLD_MAX_NUM_LINKS))
 		return -EINVAL;
 
@@ -4741,8 +4787,10 @@ __ieee80211_channel_switch(struct wiphy
 	if (chanreq.oper.punctured && !link_conf->eht_support)
 		return -EINVAL;
 
-	/* don't allow another channel switch if one is already active. */
-	if (link_conf->csa_active)
+	/* don't allow another channel switch if one is already active
+	 * except the case of post-CSA radar detection.
+	 */
+	if (link_conf->csa_active && !sdata->wdev.links[link_id].cac_started)
 		return -EBUSY;
 
 	conf = wiphy_dereference(wiphy, link_conf->chanctx_conf);
@@ -4765,6 +4813,12 @@ __ieee80211_channel_switch(struct wiphy
 
 	chanctx = container_of(conf, struct ieee80211_chanctx, conf);
 
+	/* each BSS on the chanctx sends its own switch request */
+	if (link_conf->csa_active) {
+		ieee80211_link_cac_cancel(link_data);
+		cac_cancelled = true;
+	}
+
 	ch_switch.timestamp = 0;
 	ch_switch.device_timestamp = 0;
 	ch_switch.block_tx = params->block_tx;
@@ -4812,11 +4866,16 @@ __ieee80211_channel_switch(struct wiphy
 		ieee80211_link_info_change_notify(sdata, link_data, changed);
 		drv_channel_switch_beacon(sdata, &link_data->csa.chanreq.oper);
 	} else {
-		/* if the beacon didn't change, we can finalize immediately */
-		ieee80211_csa_finalize(link_data);
+		/* if the beacon didn't change, we can finalize immediately.
+		 * A failed finalize stops the link itself.
+		 */
+		return ieee80211_csa_finalize(link_data);
 	}
 
 out:
+	/* the link must not stay on a channel whose CAC it cancelled */
+	if (err && cac_cancelled)
+		ieee80211_csa_link_stop(link_data);
 	return err;
 }
 
@@ -6007,7 +6066,7 @@ ieee80211_skip_cac(struct wireless_dev *
 	wiphy_hrtimer_work_cancel(sdata->local->hw.wiphy,
 				  &link->dfs_cac_timer_work);
 	if (wdev->links[link_id].cac_started) {
-		ieee80211_link_release_channel(link);
+		ieee80211_link_cac_end(link);
 		cac_time_ms = wdev->links[link_id].cac_time_ms;
 		wdev->links[link_id].cac_start_time = jiffies -
 				       msecs_to_jiffies(cac_time_ms + 1);
@@ -6100,6 +6159,7 @@ const struct cfg80211_ops mac80211_confi
 #endif
 	.get_channel = ieee80211_cfg_get_channel,
 	.start_radar_detection = ieee80211_start_radar_detection,
+	.start_radar_detection_post_csa = ieee80211_start_radar_detection_post_csa,
 	.end_cac = ieee80211_end_cac,
 	.channel_switch = ieee80211_channel_switch,
 	.set_qos_map = ieee80211_set_qos_map,
