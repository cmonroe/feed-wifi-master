 void ieee80211_color_change_finalize_work(struct wiphy *wiphy,
@@ -2860,7 +2861,9 @@ bool ieee80211_is_radio_idx_in_scan_req(
 					struct cfg80211_scan_request *scan_req,
 					int radio_idx);
 
+void ieee80211_link_cac_end(struct ieee80211_link_data *link);
 void ieee80211_dfs_cac_timer_work(struct wiphy *wiphy, struct wiphy_work *work);
+void ieee80211_link_cac_cancel(struct ieee80211_link_data *link);
 void ieee80211_dfs_cac_cancel(struct ieee80211_local *local,
 			      struct ieee80211_chanctx *chanctx);
 void ieee80211_dfs_radar_detected_work(struct wiphy *wiphy,
--- a/net/mac80211/mlme.c
+++ b/net/mac80211/mlme.c
@@ -3984,6 +3984,18 @@ void ieee80211_dynamic_ps_timer(struct t
 	wiphy_work_queue(local->hw.wiphy, &local->dynamic_ps_enable_work);
 }
 
+void ieee80211_link_cac_end(struct ieee80211_link_data *link)
+{
+	if (link->conf->csa_active) {
+		/* beacon is disabled during CAC period */
+		link->conf->enable_beacon = true;
+		wiphy_work_queue(link->sdata->local->hw.wiphy,
+				 &link->csa.finalize_work);
+	} else {
+		ieee80211_link_release_channel(link);
+	}
+}
+
 void ieee80211_dfs_cac_timer_work(struct wiphy *wiphy, struct wiphy_work *work)
 {
 	struct ieee80211_link_data *link =
@@ -3995,7 +4007,7 @@ void ieee80211_dfs_cac_timer_work(struct
 	lockdep_assert_wiphy(sdata->local->hw.wiphy);
 
 	if (sdata->wdev.links[link->link_id].cac_started) {
-		ieee80211_link_release_channel(link);
+		ieee80211_link_cac_end(link);
 		cfg80211_cac_event(sdata->dev, &chandef,
 				   NL80211_RADAR_CAC_FINISHED,
 				   GFP_KERNEL, link->link_id);
--- a/net/mac80211/util.c
+++ b/net/mac80211/util.c
@@ -3659,6 +3659,31 @@ u64 ieee80211_calculate_rx_timestamp(str
 }
 EXPORT_SYMBOL_GPL(ieee80211_calculate_rx_timestamp);
 
+void ieee80211_link_cac_cancel(struct ieee80211_link_data *link)
+{
+	struct ieee80211_sub_if_data *sdata = link->sdata;
+	struct cfg80211_chan_def chandef;
+
+	wiphy_hrtimer_work_cancel(sdata->local->hw.wiphy,
+				  &link->dfs_cac_timer_work);
+
+	if (!sdata->wdev.links[link->link_id].cac_started)
+		return;
+
+	chandef = link->conf->chanreq.oper;
+	if (link->conf->csa_active) {
+		/* the driver may still quiet the band for it */
+		drv_abort_channel_switch(link);
+		link->conf->csa_active = false;
+		link->conf->enable_beacon = true;
+		ieee80211_free_next_beacon(link);
+	} else {
+		ieee80211_link_release_channel(link);
+	}
+	cfg80211_cac_event(sdata->dev, &chandef, NL80211_RADAR_CAC_ABORTED,
+			   GFP_KERNEL, link->link_id);
+}
+
 /* Cancel CAC for the interfaces under the specified @local. If @ctx is
  * also provided, only the interfaces using that ctx will be canceled.
  */
@@ -3666,7 +3691,6 @@ void ieee80211_dfs_cac_cancel(struct iee
 			      struct ieee80211_chanctx *ctx)
 {
 	struct ieee80211_sub_if_data *sdata;
-	struct cfg80211_chan_def chandef;
 	struct ieee80211_link_data *link;
 	struct ieee80211_chanctx_conf *chanctx_conf;
 	unsigned int link_id;
@@ -3686,17 +3710,7 @@ void ieee80211_dfs_cac_cancel(struct iee
 			if (ctx && &ctx->conf != chanctx_conf)
 				continue;
 
-			wiphy_hrtimer_work_cancel(local->hw.wiphy,
-						  &link->dfs_cac_timer_work);
-
-			if (!sdata->wdev.links[link_id].cac_started)
-				continue;
-
-			chandef = link->conf->chanreq.oper;
-			ieee80211_link_release_channel(link);
-			cfg80211_cac_event(sdata->dev, &chandef,
-					   NL80211_RADAR_CAC_ABORTED,
-					   GFP_KERNEL, link_id);
+			ieee80211_link_cac_cancel(link);
 		}
 	}
 }
--- a/net/wireless/chan.c
+++ b/net/wireless/chan.c
@@ -1871,8 +1871,13 @@ static bool _cfg80211_reg_can_beacon(str
 	check_radar = dfs_required != 0;
 
 	if (dfs_required > 0 &&
-	    cfg80211_chandef_dfs_available(wiphy, chandef)) {
-		/* We can skip IEEE80211_CHAN_NO_IR if chandef dfs available */
+	    (cfg80211_chandef_dfs_available(wiphy, chandef) ||
+	     ((permitting_flags & IEEE80211_CHAN_RADAR) &&
+	      cfg80211_chandef_dfs_usable(wiphy, chandef)))) {
+		/* We can skip IEEE80211_CHAN_NO_IR if the chandef is dfs available
+		 * or when dfs_relax is permitted (during a channel switch) and the
+		 * chandef is dfs usable.
+		 */
 		prohibited_flags &= ~IEEE80211_CHAN_NO_IR;
 		check_radar = false;
 	}
@@ -1910,6 +1915,9 @@ bool cfg80211_reg_check_beaconing(struct
 							   chandef->chan);
 	}
 
+	if (cfg->dfs_relax)
+		permitting_flags |= IEEE80211_CHAN_RADAR;
+
 	if (cfg->reg_power == IEEE80211_REG_VLP_AP)
 		permitting_flags |= IEEE80211_CHAN_ALLOW_6GHZ_VLP_AP;
 
@@ -1925,6 +1933,58 @@ bool cfg80211_reg_check_beaconing(struct
 }
 EXPORT_SYMBOL(cfg80211_reg_check_beaconing);
 
+int cfg80211_start_radar_detection_post_csa(struct wiphy *wiphy,
+					    struct wireless_dev *wdev,
+					    unsigned int link_id,
+					    struct cfg80211_chan_def *chandef)
+{
+	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+	u32 cac_time_ms;
+	enum nl80211_dfs_regions dfs_region;
+	int ret = 0;
+
+	if (cfg80211_chandef_dfs_available(wiphy, chandef))
+		goto out;
+
+	/* a radar during the countdown can put the target into its
+	 * non-occupancy period; a CAC there would end that period early
+	 */
+	if (!cfg80211_chandef_dfs_usable(wiphy, chandef))
+		return -EINVAL;
+
+	/* Update DFS channel state especially when original channel include DFS channel */
+	cfg80211_sched_dfs_chan_update(rdev);
+
+	dfs_region = reg_get_dfs_region(wiphy);
+	if (dfs_region == NL80211_DFS_UNSET)
+		goto out;
+
+	cac_time_ms = cfg80211_chandef_dfs_cac_time(wiphy, chandef);
+	if (WARN_ON(!cac_time_ms))
+		cac_time_ms = IEEE80211_DFS_MIN_CAC_TIME_MS;
+
+	ret = rdev_start_radar_detection_post_csa(rdev, wdev->netdev, link_id,
+						  chandef, cac_time_ms);
+	if (ret > 0) {
+		if (wdev->links[link_id].ap.chandef.chan)
+			cfg80211_update_last_available(wiphy,
+						       &wdev->links[link_id].ap.chandef,
+						       0);
+		wdev->links[link_id].ap.chandef = *chandef;
+		wdev->links[link_id].cac_start_time = jiffies;
+		wdev->links[link_id].cac_time_ms = cac_time_ms;
+		if (rdev->background_radar_wdev &&
+		    cfg80211_is_sub_chan(chandef, rdev->background_radar_chandef.chan, false))
+			cfg80211_stop_background_radar_detection(rdev->background_radar_wdev);
+		cfg80211_cac_event(wdev->netdev, chandef,
+				   NL80211_RADAR_CAC_STARTED, GFP_KERNEL, link_id);
+	}
+
+out:
+	return ret;
+}
+EXPORT_SYMBOL(cfg80211_start_radar_detection_post_csa);
