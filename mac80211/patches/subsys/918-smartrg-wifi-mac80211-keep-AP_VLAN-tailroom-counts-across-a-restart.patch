From: Chad Monroe <chad@monroe.io>
Date: Tue, 06 Oct 2026 18:58:13 -0700
Subject: [PATCH] wifi: mac80211: keep AP_VLAN tailroom counts across a restart

A hardware restart counts the tailroom need of each interface again,
in list order. The AP pass adds the count of its keys to each VLAN.
The later VLAN pass reset the VLAN count and added only the VLAN keys,
so the AP part was lost and removing the VLAN logged a warning.

The AP pass now also counts the keys of each running VLAN, and the
VLAN pass returns early, so the result does not depend on the order
of the interfaces. A VLAN that does not run still gets a reset,
because its next open adds the AP count again.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 net/mac80211/key.c |   36 ++++++++++++++++++++++++++++--------
 1 file changed, 28 insertions(+), 8 deletions(-)

--- a/net/mac80211/key.c
+++ b/net/mac80211/key.c
@@ -971,13 +971,30 @@ void ieee80211_key_free(struct ieee80211
 	ieee80211_key_destroy(key, delay_tailroom);
 }
 
-void ieee80211_reenable_keys(struct ieee80211_sub_if_data *sdata)
+static void ieee80211_reenable_iface_keys(struct ieee80211_sub_if_data *sdata)
 {
 	struct ieee80211_key *key;
+
+	list_for_each_entry(key, &sdata->key_list, list) {
+		if (!(key->flags & KEY_FLAG_TAINTED))
+			increment_tailroom_need_count(sdata);
+		ieee80211_key_enable_hw_accel(key);
+	}
+}
+
+void ieee80211_reenable_keys(struct ieee80211_sub_if_data *sdata)
+{
 	struct ieee80211_sub_if_data *vlan;
 
 	lockdep_assert_wiphy(sdata->local->hw.wiphy);
 
+	/* a running VLAN also carries the count of its AP's keys, which only
+	 * the AP pass can add, so the AP pass counts the VLAN's keys as well
+	 */
+	if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN &&
+	    ieee80211_sdata_running(sdata) && sdata->bss)
+		return;
+
 	sdata->crypto_tx_tailroom_needed_cnt = 0;
 	sdata->crypto_tx_tailroom_pending_dec = 0;
 
@@ -988,13 +1005,16 @@ void ieee80211_reenable_keys(struct ieee
 		}
 	}
 
-	if (ieee80211_sdata_running(sdata)) {
-		list_for_each_entry(key, &sdata->key_list, list) {
-			if (!(key->flags & KEY_FLAG_TAINTED))
-				increment_tailroom_need_count(sdata);
-			ieee80211_key_enable_hw_accel(key);
-		}
-	}
+	if (!ieee80211_sdata_running(sdata))
+		return;
+
+	ieee80211_reenable_iface_keys(sdata);
+
+	if (sdata->vif.type != NL80211_IFTYPE_AP)
+		return;
+
+	list_for_each_entry(vlan, &sdata->u.ap.vlans, u.vlan.list)
+		ieee80211_reenable_iface_keys(vlan);
 }
 
 static void
